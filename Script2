function Nebula:SetTheme(name)
    if not self.Themes[name] then return end
    self.ThemeName = name
    self.Theme = self.Themes[name]
    for _, fn in ipairs(self.Hooks.theme) do pcall(fn, self.Theme) end
end
function Nebula:OnTheme(fn) table.insert(self.Hooks.theme, fn) end


            svCursor.BorderSizePixel = 0
            svCursor.Position = UDim2.new(s, 0, 1-v, 0)
            svCursor.ZIndex = 17
            svCursor.Parent = svArea
            corner(svCursor, 6)
            stroke(svCursor, Color3.new(0, 0, 0), 1, 0)

            local hueBar = Instance.new("Frame")
            hueBar.Size = UDim2.new(0, 20, 0, 120)
            hueBar.Position = UDim2.new(1, -36, 0, 0)
            hueBar.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            hueBar.BorderSizePixel = 0
            hueBar.ZIndex = 16
            hueBar.Parent = editor
            corner(hueBar, 6)

            local hueGrad = Instance.new("UIGradient")
            hueGrad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
            })
            hueGrad.Rotation = 90
            hueGrad.Parent = hueBar

            local hueCursor = Instance.new("Frame")
            hueCursor.Size = UDim2.new(1, 0, 0, 3)
            hueCursor.AnchorPoint = Vector2.new(0, 0.5)
            hueCursor.BackgroundColor3 = Color3.new(1, 1, 1)
            hueCursor.BorderSizePixel = 0
            hueCursor.Position = UDim2.new(0, 0, h, 0)
            hueCursor.ZIndex = 17
            hueCursor.Parent = hueBar
            corner(hueCursor, 2)

            local hexBox = Instance.new("TextBox")
            hexBox.Size = UDim2.new(1, 0, 0, 28)
            hexBox.Position = UDim2.new(0, 0, 0, 128)
            hexBox.BackgroundColor3 = Nebula.Theme.Surface2
            hexBox.BorderSizePixel = 0
            hexBox.Text = string.format("#%02X%02X%02X",
                math.floor(cfg.Color.R*255),
                math.floor(cfg.Color.G*255),
                math.floor(cfg.Color.B*255))
            hexBox.TextColor3 = Nebula.Theme.Text
            hexBox.Font = Enum.Font.Code
            hexBox.TextSize = 11
            hexBox.ClearTextOnFocus = false
            hexBox.ZIndex = 16
            hexBox.Parent = editor
            corner(hexBox, 6)
            padding(hexBox, 0, 10, 0, 10)

            local draggingSV, draggingHue
            local applyingHex = false

            local function updateColor(silent)
                local col = Color3.fromHSV(h, s, v)
                cfg.Color = col
                preview.BackgroundColor3 = col
                svArea.ImageColor3 = Color3.fromHSV(h, 1, 1)
                svArea.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                svCursor.Position = UDim2.new(s, 0, 1-v, 0)
                hueCursor.Position = UDim2.new(0, 0, h, 0)
                if not applyingHex then
                    hexBox.Text = string.format("#%02X%02X%02X",
                        math.floor(col.R*255),
                        math.floor(col.G*255),
                        math.floor(col.B*255))
                end
                if not silent then
                    pcall(cfg.Callback, col)
                end
            end

            svArea.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSV = true
                    local rel = math.clamp((input.Position.X - svArea.AbsolutePosition.X) / svArea.AbsoluteSize.X, 0, 1)
                    local relY = math.clamp((input.Position.Y - svArea.AbsolutePosition.Y) / svArea.AbsoluteSize.Y, 0, 1)
                    s = rel
                    v = 1 - relY
                    updateColor()
                end
            end)

            hueBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    draggingHue = true
                    local rel = math.clamp((input.Position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
                    h = rel
                    updateColor()
                end
            end)

            track(UserInputService.InputChanged:Connect(function(input)
                if draggingSV and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                    local rel = math.clamp((input.Position.X - svArea.AbsolutePosition.X) / math.max(svArea.AbsoluteSize.X, 1), 0, 1)
                    local relY = math.clamp((input.Position.Y - svArea.AbsolutePosition.Y) / math.max(svArea.AbsoluteSize.Y, 1), 0, 1)
                    s = rel
                    v = 1 - relY
                    updateColor()
                end
                if draggingHue and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                    local rel = math.clamp((input.Position.Y - hueBar.AbsolutePosition.Y) / math.max(hueBar.AbsoluteSize.Y, 1), 0, 1)
                    h = rel
                    updateColor()
                end
            end))

            track(UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSV = false
                    draggingHue = false
                end
            end))

            hexBox.FocusLost:Connect(function()
                local hex = hexBox.Text:gsub("#", "")
                if #hex == 6 then
                    local r = tonumber(hex:sub(1,2), 16)
                    local g = tonumber(hex:sub(3,4), 16)
                    local b = tonumber(hex:sub(5,6), 16)
                    if r and g and b then
                        applyingHex = true
                        local newCol = Color3.fromRGB(r, g, b)
                        h, s, v = newCol:ToHSV()
                        updateColor()
                        applyingHex = false
                    end
                end
            end)

            headerBtn.MouseButton1Click:Connect(function()
                open = not open
                editor.Visible = open
                if open then
                    tw(row, 0.25, { Size = UDim2.new(1, 0, 0, 42 + 170) })
                else
                    tw(row, 0.25, { Size = UDim2.new(1, 0, 0, 42) })
                end
                recalc()
            end)

            if flag then
                Nebula.Options[flag] = {
                    Set = function(c)
                        if typeof(c) == "Color3" then
                            h, s, v = c:ToHSV()
                            updateColor(true)
                        end
                    end,
                    Get = function() return cfg.Color end,
                }
            end

            recalc()
            local v2 = {}
            function v2:Set(c)
                if c.Color then
                    h, s, v = c.Color:ToHSV()
                    updateColor(true)
                end
                if c.Name then lbl.Text = c.Name end
            end
            function v2:Destroy() row:Destroy(); recalc() end
            return v2
        end

        return tab
    end

    -- ═══ THEME TAB ═══
    function window:CreateThemeTab()
        local tab = window:CreateTab({ Name = "🎨  Темы" })
        local sec = tab:CreateSection("Пресеты")
        for name, _ in pairs(Nebula.Themes) do
            sec:CreateButton({
                Name = name,
                Callback = function()
                    Nebula:SetTheme(name)
                    Nebula:Notify({ Title = "Тема", Content = name, Type = "success", Duration = 2 })
                end,
            })
        end
        return tab
    end

    table.insert(Nebula.Windows, window)
    return window
end

-- ═══════════════════════════════════════════════════════════════════════
-- PUBLIC API
-- ═══════════════════════════════════════════════════════════════════════
function Nebula:CreateWindow(cfg)
    return buildWindow(cfg)
end

function Nebula:DestroyAll()
    for _, w in ipairs(self.Windows) do
        pcall(function() w:Destroy() end)
    end
    self.Windows = {}
    if RootGui then pcall(function() RootGui:Destroy() end) end
end


function Nebula:CreateWindow(cfg)
    local w = buildWindow(cfg)
    self.Window = w
    return w
end

function Nebula:SetTheme(name)
    if self.Themes[name] then
        self.Theme = self.Themes[name]
        self.ThemeName = name
    end
end

buildPalette()

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.K and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        if paletteOpen then closePalette() else openPalette() end
    elseif input.KeyCode == Enum.KeyCode.Escape and paletteOpen then
        closePalette()
    end
end)

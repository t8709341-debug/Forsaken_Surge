    local function clampPos(pos, size)
        local vp = Camera.ViewportSize
        local w = size.X.Offset
        local h = size.Y.Offset
        local x = pos.X.Offset
        local y = pos.Y.Offset
        -- минимум 80px от окна и 32px сверху
        local minX = -(w - 80)
        local maxX = vp.X - 80
        local minY = 0
        local maxY = math.max(0, vp.Y - 40)
        return UDim2.new(0, math.clamp(x, minX, maxX), 0, math.clamp(y, minY, maxY))
    end


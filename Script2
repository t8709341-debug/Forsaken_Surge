            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -80, 0, 34)
            lbl.Position = UDim2.new(0, 12, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = cfg.Name
            lbl.TextColor3 = t.Text
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 12
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = row
            
            local selectedLbl = Instance.new("TextLabel")
            selectedLbl.Size = UDim2.new(0, 100, 0, 34)
            selectedLbl.Position = UDim2.new(1, -120, 0, 0)
            selectedLbl.BackgroundTransparency = 1
            selectedLbl.Text = #current > 0 and table.concat(current, ", ") or "None"
            selectedLbl.TextColor3 = t.Accent
            selectedLbl.Font = Enum.Font.Gotham
            selectedLbl.TextSize = 11
            selectedLbl.TextXAlignment = Enum.TextXAlignment.Right
            selectedLbl.TextTruncate = Enum.TextTruncate.AtEnd
            selectedLbl.Parent = row
            
            local arrow = Instance.new("TextLabel")
            arrow.Size = UDim2.new(0, 20, 0, 34)
            arrow.Position = UDim2.new(1, -22, 0, 0)
            arrow.BackgroundTransparency = 1
            arrow.Text = "▾"
            arrow.TextColor3 = t.TextDim
            arrow.Font = Enum.Font.Gotham
            arrow.TextSize = 12
            arrow.Parent = row
            
            local optionsFrame = Instance.new("ScrollingFrame")
            optionsFrame.Size = UDim2.new(1, -16, 0, 0)
            optionsFrame.Position = UDim2.new(0, 8, 0, 34)
            optionsFrame.BackgroundTransparency = 1
            optionsFrame.BorderSizePixel = 0
            optionsFrame.ScrollBarThickness = 3
            optionsFrame.ScrollBarImageColor3 = t.Accent
            optionsFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
            optionsFrame.Visible = false
            optionsFrame.Parent = row
            listLayout(optionsFrame, Enum.FillDirection.Vertical, 2)
            
            local function refreshOptions()
                for _, c in ipairs(optionsFrame:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                for _, opt in ipairs(cfg.Options) do
                    local o = Instance.new("TextButton")
                    o.Size = UDim2.new(1, 0, 0, 28)
                    o.BackgroundColor3 = t.Surface2
                    o.BorderSizePixel = 0
                    o.Text = opt
                    o.TextColor3 = t.Text
                    o.Font = Enum.Font.Gotham
                    o.TextSize = 11
                    o.AutoButtonColor = false
                    o.Parent = optionsFrame
                    corner(o, 5)
                    
                    if table.find(current, opt) then
                        o.TextColor3 = t.Accent
                    end
                    
                    o.MouseEnter:Connect(function()
                        tw(o, 0.12, { BackgroundColor3 = t.Line })
                    end)
                    o.MouseLeave:Connect(function()
                        tw(o, 0.12, { BackgroundColor3 = t.Surface2 })
                    end)
                    o.MouseButton1Click:Connect(function()
                        if cfg.MultipleOptions then
                            local idx = table.find(current, opt)
                            if idx then table.remove(current, idx)
                            else table.insert(current, opt) end
                        else
                            current = { opt }
                        end
                        selectedLbl.Text = #current > 0 and table.concat(current, ", ") or "None"
                        refreshOptions()
                        local val = cfg.MultipleOptions and current or current[1]
                        local ok, err = pcall(cfg.Callback, val)
                        if not ok then Nebula:Notify({ Title = "Error", Content = tostring(err), Type = "error" }) end
                        if not cfg.MultipleOptions then
                            expanded = false
                            tw(row, 0.2, { Size = UDim2.new(1, 0, 0, 34) })
                            optionsFrame.Visible = false
                            arrow.Text = "▾"
                        end
                    end)
                end
                optionsFrame.CanvasSize = UDim2.new(0, 0, 0, optionsFrame.UIListLayout.AbsoluteContentSize.Y + 4)
            end
            refreshOptions()
            
            headerBtn.MouseButton1Click:Connect(function()
                expanded = not expanded
                optionsFrame.Visible = expanded
                if expanded then
                    tw(row, 0.2, { Size = UDim2.new(1, 0, 0, 34 + math.min(140, optionsFrame.UIListLayout.AbsoluteContentSize.Y + 8)) })
                    arrow.Text = "▴"
                else
                    tw(row, 0.2, { Size = UDim2.new(1, 0, 0, 34) })
                    arrow.Text = "▾"
                end
                recalcCanvas()
            end)
            
            if flag then Nebula.Options[flag] = { CurrentOption = current } end
            recalcCanvas()
            local v = {}
            function v:Set(c)
                if c.Options then cfg.Options = c.Options; refreshOptions() end
                if c.CurrentOption then
                    current = type(c.CurrentOption) == "table" and c.CurrentOption or { c.CurrentOption }
                    selectedLbl.Text = #current > 0 and table.concat(current, ", ") or "None"
                    refreshOptions()
                end
            end
            function v:Destroy() row:Destroy(); recalcCanvas() end
            return v
        end
        
        -- ═══ INPUT ═══
        function tab:CreateInput(cfg, flag)
            cfg = kwargify({
                Name = "Input",
                PlaceholderText = "",
                CurrentValue = "",
                Numeric = false,
                Enter = false,
                MaxCharacters = nil,
                RemoveTextAfterFocusLost = false,
                Callback = function() end,
            }, cfg)
            
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 34)
            row.BackgroundColor3 = t.Surface
            row.BorderSizePixel = 0
            row.Parent = page
            corner(row, 8)
            stroke(row, t.Line, 1, 0.5)
            
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(0, 120, 0, 34)
            lbl.Position = UDim2.new(0, 12, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = cfg.Name
            lbl.TextColor3 = t.Text
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 12
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = row
            
            local box = Instance.new("TextBox")
            box.Size = UDim2.new(1, -150, 0, 24)
            box.Position = UDim2.new(1, -140, 0.5, 0)
            box.AnchorPoint = Vector2.new(0, 0.5)
            box.BackgroundColor3 = t.Surface2
            box.BorderSizePixel = 0
            box.Text = cfg.CurrentValue
            box.PlaceholderText = cfg.PlaceholderText
            box.PlaceholderColor3 = t.TextDim
            box.TextColor3 = t.Text
            box.Font = Enum.Font.Gotham
            box.TextSize = 11
            box.ClearTextOnFocus = false
            box.Parent = row
            corner(box, 6)
            padding(box, 0, 8, 0, 8)
            
            local function process(text)
                if cfg.MaxCharacters and #text > cfg.MaxCharacters then
                    text = text:sub(1, cfg.MaxCharacters)
                    box.Text = text
                end
                if cfg.Numeric then
                    local filtered = text:gsub("[^%d%.%-]", "")
                    if filtered ~= text then box.Text = filtered end
                end
            end
            
            box:GetPropertyChangedSignal("Text"):Connect(function()
                process(box.Text)
                if not cfg.Enter then
                    local ok, err = pcall(cfg.Callback, box.Text)
                    if not ok then Nebula:Notify({ Title = "Error", Content = tostring(err), Type = "error" }) end
                end
            end)
            
            box.FocusLost:Connect(function(enterPressed)
                if cfg.Enter and enterPressed then
                    local ok, err = pcall(cfg.Callback, box.Text)
                    if not ok then Nebula:Notify({ Title = "Error", Content = tostring(err), Type = "error" }) end
                end
                if cfg.RemoveTextAfterFocusLost then box.Text = "" end
            end)
            
            if flag then Nebula.Options[flag] = { CurrentValue = cfg.CurrentValue } end
            recalcCanvas()
            local v = {}
            function v:Set(c)
                if c.CurrentValue ~= nil then box.Text = tostring(c.CurrentValue) end
                if c.Name then lbl.Text = c.Name end
            end
            function v:Destroy() row:Destroy(); recalcCanvas() end
            return v
        end
        
        -- ═══ KEYBIND ═══
        function tab:CreateKeybind(cfg)
            cfg = kwargify({
                Name = "Keybind",
                CurrentKeybind = "Q",
                HoldToInteract = false,
                Callback = function() end,
            }, cfg)
            
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 34)
            row.BackgroundColor3 = t.Surface
            row.BorderSizePixel = 0
            row.Parent = page
            corner(row, 8)
            stroke(row, t.Line, 1, 0.5)
            
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -100, 0, 34)
            lbl.Position = UDim2.new(0, 12, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = cfg.Name
            lbl.TextColor3 = t.Text
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 12
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = row
            
            local keyBtn = Instance.new("TextButton")
            keyBtn.Size = UDim2.new(0, 60, 0, 24)
            keyBtn.Position = UDim2.new(1, -72, 0.5, 0)
            keyBtn.AnchorPoint = Vector2.new(0, 0.5)
            keyBtn.BackgroundColor3 = t.Surface2
            keyBtn.BorderSizePixel = 0
            keyBtn.Text = cfg.CurrentKeybind
            keyBtn.TextColor3 = t.Accent
            keyBtn.Font = Enum.Font.Code
            keyBtn.TextSize = 11
            keyBtn.AutoButtonColor = false
            keyBtn.Parent = row
            corner(keyBtn, 5)
            
            local listening = false
            local active = false
            
            keyBtn.MouseButton1Click:Connect(function()
                listening = true
                keyBtn.Text = "..."
                keyBtn.TextColor3 = t.Warning
            end)
            
            UserInputService.InputBegan:Connect(function(input, gp)
                if gp then return end
                if listening then
                    listening = false
                    local key = input.KeyCode.Name
                    if key ~= "Unknown" then
                        cfg.CurrentKeybind = key
                        keyBtn.Text = key
                        keyBtn.TextColor3 = t.Accent
                    end
                    return
                end
                if not listening and input.KeyCode.Name == cfg.CurrentKeybind then
                    if cfg.HoldToInteract then
                        pcall(cfg.Callback, true)
                        active = true
                    else
                        active = not active
                        pcall(cfg.Callback, active)
                    end
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                if input.KeyCode.Name == cfg.CurrentKeybind and cfg.HoldToInteract and active then
                    pcall(cfg.Callback, false)
                    active = false
                end
            end)
            
            recalcCanvas()
            local v = {}
            function v:Set(c)
                if c.CurrentKeybind then cfg.CurrentKeybind = c.CurrentKeybind; keyBtn.Text = c.CurrentKeybind end
                if c.Name then lbl.Text = c.Name end
            end
            function v:Destroy() row:Destroy(); recalcCanvas() end
            return v
        end
        
        -- ═══ COLOR PICKER ═══
        function tab:CreateColorPicker(cfg, flag)
            cfg = kwargify({
                Name = "Color",
                Color = Color3.fromRGB(255, 255, 255),
                Callback = function() end,
            }, cfg)
            
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 34)
            row.BackgroundColor3 = t.Surface
            row.BorderSizePixel = 0
            row.Parent = page
            corner(row, 8)
            stroke(row, t.Line, 1, 0.5)
            
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -100, 0, 34)
            lbl.Position = UDim2.new(0, 12, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = cfg.Name
            lbl.TextColor3 = t.Text
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 12
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = row
            
            local preview = Instance.new("Frame")
            preview.Size = UDim2.new(0, 60, 0, 22)
            preview.Position = UDim2.new(1, -72, 0.5, 0)
            preview.AnchorPoint = Vector2.new(0, 0.5)
            preview.BackgroundColor3 = cfg.Color
            preview.BorderSizePixel = 0
            preview.Parent = row
            corner(preview, 5)
            stroke(preview, t.Line, 1, 0.5)
            
            -- Simple RGB input approach (minimal)
            local hexBox = Instance.new("TextBox")
            hexBox.Size = UDim2.new(0, 0, 0, 0)  -- hidden
            hexBox.Parent = row
            
            preview.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    local newHex = tostring(color3ToHex(cfg.Color))
                    -- fallback: prompt via notification
                    Nebula:Notify({
                        Title = "Color",
                        Content = "Current: " .. newHex .. " — click preview to cycle preset",
                        Type = "info",
                    })
                    -- cycle through a preset palette for simplicity
                    local presets = {
                        Color3.fromRGB(255, 100, 100),
                        Color3.fromRGB(255, 180, 100),
                        Color3.fromRGB(255, 240, 120),
                        Color3.fromRGB(140, 230, 140),
                        Color3.fromRGB(120, 200, 255),
                        Color3.fromRGB(180, 140, 240),
                        Color3.fromRGB(255, 140, 200),
                        Color3.fromRGB(255, 255, 255),
                    }
                    local idx = 1
                    for i, c in ipairs(presets) do
                        if c == cfg.Color then idx = i + 1 break end
                    end
                    if idx > #presets then idx = 1 end
                    cfg.Color = presets[idx]
                    preview.BackgroundColor3 = cfg.Color
                    pcall(cfg.Callback, cfg.Color)
                end
            end)
            
            if flag then Nebula.Options[flag] = { Color = cfg.Color } end
            recalcCanvas()
            local v = {}
            function v:Set(c)
                if c.Color then cfg.Color = c.Color; preview.BackgroundColor3 = c.Color end
                if c.Name then lbl.Text = c.Name end
                if c.Callback then cfg.Callback = c.Callback end
            end
            function v:Destroy() row:Destroy(); recalcCanvas() end
            return v
        end
        
        return tab
    end
    
    -- ═══ THEME TAB ═══
    function window:CreateThemeTab()
        local tab = window:CreateTab({ Name = "Theme", Pinned = false })
        tab:CreateSection("Preset Themes")
        for name, _ in pairs(Themes) do
            tab:CreateButton({
                Name = name,
                Callback = function()
                    Nebula.ThemeName = name
                    Nebula.Theme = Themes[name]
                    Nebula:Notify({ Title = "Theme", Content = name .. " selected (reload script to fully apply)", Type = "success" })
                end,
            })
        end
        tab:CreateSection("Info")
        tab:CreateParagraph({
            Title = "Nebula Frame v" .. Nebula.Version,
            Text = "Minimalist UI framework inspired by Luna. Press Ctrl+K for command palette. RightShift to hide/show interface.",
        })
        return tab
    end
    
    startGradientAnim()
    buildCommandPalette()
    return window
end


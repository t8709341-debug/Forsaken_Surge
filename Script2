-- GRADIENT ANIMATION
-- ═══════════════════════════════════════════════════════════════════════
local gradientObjects = {}
local gradientConn
local gradientPhase = 0

local function registerGradient(g)
    table.insert(gradientObjects, g)
end

local function startGradientAnim()
    if gradientConn then return end
    gradientConn = RunService.RenderStepped:Connect(function(dt)
        gradientPhase = (gradientPhase + dt * 0.15) % 1
        local t = Nebula.Theme
        local c1 = t.Accent:Lerp(t.Accent2, gradientPhase)
        local c2 = t.Accent2:Lerp(t.Accent, gradientPhase)
        for i = #gradientObjects, 1, -1 do
            local g = gradientObjects[i]
            if g and g.Parent then
                g.Color = ColorSequence.new(c1, c2)
            else
                table.remove(gradientObjects, i)
            end
        end
    end)
end

-- THEME ANIMATION (live gradient)
-- ═══════════════════════════════════════════════════════════
local gradientObjects = {}
local themeAnimConn
local gradientPhase = 0

local function registerGradient(gradient)
    table.insert(gradientObjects, gradient)
end

local function startGradientAnim()
    if themeAnimConn then return end
    themeAnimConn = RunService.RenderStepped:Connect(function(dt)
        gradientPhase = gradientPhase + dt * 0.15
        local phase = gradientPhase % 1
        local t = Nebula.Theme
        local c1 = t.Accent:Lerp(t.Accent2, phase)
        local c2 = t.Accent2:Lerp(t.Accent, phase)
        for _, g in ipairs(gradientObjects) do
            if g.Parent then
                g.Color = ColorSequence.new(c1, c2)
            end
        end
    end)
end


function Nebula:CreateWindow(cfg)
    local w = buildWindow(cfg)
    self.Window = w
    return w
end

function Nebula:SetTheme(name)
    if Themes[name] then
        self.Theme = Themes[name]
        self.ThemeName = name
    end
end

function Nebula:GetTheme()
    return self.ThemeName
end


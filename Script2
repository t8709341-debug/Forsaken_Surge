    -- ═══ RESOURCE MONITOR LOOP ═══
    task.spawn(function()
        local frames = 0
        local lastTime = tick()
        local fps = 60
        RunService.RenderStepped:Connect(function()
            frames = frames + 1
            if tick() - lastTime >= 0.5 then
                fps = math.floor(frames / (tick() - lastTime))
                frames = 0
                lastTime = tick()
            end
        end)
        while rootGui.Parent do
            task.wait(1)
            local ping = 0
            pcall(function()
                ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
            local mem = math.floor(Stats:GetTotalMemoryUsageMb())
            monitor.Text = string.format("FPS %d · Ping %dms · Mem %dMB", fps, ping, mem)
        end
    end)
    
    -- ═══ KEYBIND: Hide / Show ═══
    local hidden = false
    local toggleKey = Enum.KeyCode.RightShift
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == toggleKey then
            hidden = not hidden
            tw(main, 0.2, { BackgroundTransparency = hidden and 1 or 0 })
            tw(shadow, 0.2, { ImageTransparency = hidden and 1 or 0.5 })
            for _, d in ipairs(main:GetDescendants()) do
                if d:IsA("GuiObject") and d ~= main then
                    if d.BackgroundTransparency < 1 then
                        if hidden then
                            d:SetAttribute("_nb_bt", d.BackgroundTransparency)
                            d.BackgroundTransparency = 1
                        else
                            local b = d:GetAttribute("_nb_bt")
                            if b then d.BackgroundTransparency = b end
                        end
                    end
                    if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                        if hidden then
                            d:SetAttribute("_nb_tt", d.TextTransparency)
                            d.TextTransparency = 1
                        else
                            local tt = d:GetAttribute("_nb_tt")
                            if tt then d.TextTransparency = tt end
                        end
                    end
                    if d:IsA("ImageLabel") then
                        if hidden then
                            d:SetAttribute("_nb_it", d.ImageTransparency)
                            d.ImageTransparency = 1
                        else
                            local it = d:GetAttribute("_nb_it")
                            if it then d.ImageTransparency = it end
                        end
                    end
                    if d:IsA("UIStroke") then
                        if hidden then
                            d:SetAttribute("_nb_st", d.Transparency)
                            d.Transparency = 1
                        else
                            local st = d:GetAttribute("_nb_st")
                            if st then d.Transparency = st end
                        end
                    end
                end
            end
        end
    end)
    

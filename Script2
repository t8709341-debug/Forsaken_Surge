    function window:SetTheme(themeName)
        if not Themes[themeName] then return end
        Nebula.Theme = Themes[themeName]
        Nebula.ThemeName = themeName
        t = Nebula.Theme
        -- update all colors
        for _, d in ipairs(rootGui:GetDescendants()) do
            if d:IsA("Frame") or d:IsA("TextButton") or d:IsA("TextBox") then
                local name = d.Name
                if name == "Main" then d.BackgroundColor3 = t.Background
                elseif name == "Header" or name == "Sidebar" then d.BackgroundColor3 = t.Surface
                end
            end
        end
        -- simpler: notify and let user reload
        Nebula:Notify({ Title = "Theme", Content = "Set to " .. themeName .. " (reload to fully apply)", Type = "info" })

end

local function buildCommandPalette()
    if paletteGui then return end
    
    local gui = Instance.new("ScreenGui")
    gui.Name = "NebulaPalette"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 1000000
    if gethui then gui.Parent = gethui() else gui.Parent = CoreGui end
    paletteGui = gui
    
    local t = Nebula.Theme
    
    -- dim background
    local dim = Instance.new("Frame")
    dim.Size = UDim2.fromScale(1, 1)
    dim.BackgroundColor3 = Color3.new(0, 0, 0)
    dim.BackgroundTransparency = 1
    dim.BorderSizePixel = 0
    dim.Visible = false
    dim.Parent = gui
    
    local panel = Instance.new("Frame")
    panel.Size = UDim2.new(0, 520, 0, 380)
    panel.Position = UDim2.fromScale(0.5, 0.35)
    panel.AnchorPoint = Vector2.new(0.5, 0.5)
    panel.BackgroundColor3 = t.Background
    panel.BorderSizePixel = 0
    panel.Visible = false
    panel.Parent = gui
    corner(panel, 10)
    stroke(panel, t.Line, 1, 0.4)
    
    -- search bar
    local searchBox = Instance.new("TextBox")
    searchBox.Size = UDim2.new(1, -24, 0, 44)
    searchBox.Position = UDim2.new(0, 12, 0, 12)
    searchBox.BackgroundColor3 = t.Surface
    searchBox.BorderSizePixel = 0
    searchBox.Text = ""
    searchBox.PlaceholderText = "Search commands... (Esc to close)"
    searchBox.PlaceholderColor3 = t.TextDim
    searchBox.TextColor3 = t.Text
    searchBox.Font = Enum.Font.Gotham
    searchBox.TextSize = 14
    searchBox.TextXAlignment = Enum.TextXAlignment.Left
    searchBox.ClearTextOnFocus = false
    searchBox.Parent = panel
    corner(searchBox, 6)
    padding(searchBox, 0, 12, 0, 12)
    stroke(searchBox, t.Line, 1, 0.5)
    
    local results = Instance.new("ScrollingFrame")
    results.Size = UDim2.new(1, -24, 1, -74)
    results.Position = UDim2.new(0, 12, 0, 64)
    results.BackgroundTransparency = 1
    results.BorderSizePixel = 0
    results.ScrollBarThickness = 3
    results.ScrollBarImageColor3 = t.Accent
    results.CanvasSize = UDim2.new(0, 0, 0, 0)
    results.Parent = panel
    listLayout(results, Enum.FillDirection.Vertical, 4)
    padding(results, 4, 4, 4, 4)
    
    local function refresh(query)
        for _, c in ipairs(results:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        query = query:lower()
        local count = 0
        for _, cmd in ipairs(commandRegistry) do
            if query == "" or cmd.name:lower():find(query, 1, true) then
                count = count + 1
                if count > 30 then break end
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, 0, 0, 34)
                btn.BackgroundColor3 = t.Surface
                btn.BorderSizePixel = 0
                btn.Text = ""
                btn.AutoButtonColor = false
                btn.Parent = results
                corner(btn, 5)
                
                local nameLbl = Instance.new("TextLabel")
                nameLbl.Size = UDim2.new(1, -80, 1, 0)
                nameLbl.Position = UDim2.new(0, 12, 0, 0)
                nameLbl.BackgroundTransparency = 1
                nameLbl.Text = cmd.name
                nameLbl.TextColor3 = t.Text
                nameLbl.Font = Enum.Font.Gotham
                nameLbl.TextSize = 13
                nameLbl.TextXAlignment = Enum.TextXAlignment.Left
                nameLbl.Parent = btn
                
                local typeLbl = Instance.new("TextLabel")
                typeLbl.Size = UDim2.new(0, 70, 1, 0)
                typeLbl.Position = UDim2.new(1, -80, 0, 0)
                typeLbl.BackgroundTransparency = 1
                typeLbl.Text = cmd.type
                typeLbl.TextColor3 = t.TextDim
                typeLbl.Font = Enum.Font.Gotham
                typeLbl.TextSize = 11
                typeLbl.TextXAlignment = Enum.TextXAlignment.Right
                typeLbl.Parent = btn
                
                btn.MouseEnter:Connect(function()
                    tw(btn, 0.15, { BackgroundColor3 = t.Surface2 })
                end)
                btn.MouseLeave:Connect(function()
                    tw(btn, 0.15, { BackgroundColor3 = t.Surface })
                end)
                btn.MouseButton1Click:Connect(function()
                    closePalette()
                    cmd.action()
                end)
            end
        end
        results.CanvasSize = UDim2.new(0, 0, 0, results.UIListLayout.AbsoluteContentSize.Y + 8)
    end
    
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        refresh(searchBox.Text)
    end)
    
    searchBox.Focused:Connect(function()
        refresh(searchBox.Text)
    end)
    
    function closePalette()
        paletteOpen = false
        tw(dim, 0.2, { BackgroundTransparency = 1 })
        tw(panel, 0.2, { BackgroundTransparency = 1, Size = UDim2.new(0, 500, 0, 360) })
        task.delay(0.2, function()
            dim.Visible = false
            panel.Visible = false
        end)
    end
    
    function openPalette()
        paletteOpen = true
        dim.Visible = true
        panel.Visible = true
        dim.BackgroundTransparency = 0.6
        panel.BackgroundTransparency = 0
        panel.Size = UDim2.new(0, 520, 0, 380)
        searchBox.Text = ""
        refresh("")
        searchBox:CaptureFocus()
    end
    
    dim.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            closePalette()
        end
    end)
    
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.K and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            if paletteOpen then closePalette() else openPalette() end
        elseif input.KeyCode == Enum.KeyCode.Escape and paletteOpen then
            closePalette()
        end
    end)
end


-- NOTIFICATIONS
-- ═══════════════════════════════════════════════════════════
local notifGui
local function ensureNotifGui()
    if notifGui and notifGui.Parent then return notifGui end
    local gui = Instance.new("ScreenGui")
    gui.Name = "NebulaNotifs"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999999
    if gethui then gui.Parent = gethui() else gui.Parent = CoreGui end
    notifGui = gui
    return gui
end

function Nebula:Notify(cfg)
    cfg = kwargify({
        Title = "Nebula",
        Content = "",
        Type = "info",  -- info / success / error / warning
        Duration = 3,
    }, cfg)
    
    local t = self.Theme
    local gui = ensureNotifGui()
    local typeColors = {
        info    = t.Accent,
        success = t.Success,
        error   = t.Danger,
        warning = t.Warning,
    }
    local color = typeColors[cfg.Type] or t.Accent
    
    local container = gui:FindFirstChild("Container")
    if not container then
        container = Instance.new("Frame")
        container.Name = "Container"
        container.Size = UDim2.new(0, 320, 1, -40)
        container.Position = UDim2.new(1, -340, 0, 20)
        container.BackgroundTransparency = 1
        container.Parent = gui
        listLayout(container, Enum.FillDirection.Vertical, 8)
    end
    
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 0)
    card.BackgroundColor3 = t.Surface
    card.BorderSizePixel = 0
    card.ClipsDescendants = true
    card.Parent = container
    corner(card, 8)
    stroke(card, t.Line, 1, 0.4)
    
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 1, 0)
    bar.BackgroundColor3 = color
    bar.BorderSizePixel = 0
    bar.Parent = card
    
    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, -24, 0, 20)
    titleLbl.Position = UDim2.new(0, 14, 0, 8)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = cfg.Title
    titleLbl.TextColor3 = t.Text
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 12
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = card
    
    local textLbl = Instance.new("TextLabel")
    textLbl.Size = UDim2.new(1, -24, 0, 0)
    textLbl.Position = UDim2.new(0, 14, 0, 28)
    textLbl.BackgroundTransparency = 1
    textLbl.Text = cfg.Content
    textLbl.TextColor3 = t.TextDim
    textLbl.Font = Enum.Font.Gotham
    textLbl.TextSize = 11
    textLbl.TextWrapped = true
    textLbl.TextXAlignment = Enum.TextXAlignment.Left
    textLbl.TextYAlignment = Enum.TextYAlignment.Top
    textLbl.Parent = card
    
    task.defer(function()
        textLbl.Size = UDim2.new(1, -24, 0, textLbl.TextBounds.Y + 4)
        local targetH = 34 + textLbl.TextBounds.Y + 6
        tw(card, 0.3, { Size = UDim2.new(1, 0, 0, targetH) })
    end)
    
    task.delay(cfg.Duration, function()
        tw(card, 0.3, { Size = UDim2.new(1, 0, 0, 0) })
        task.delay(0.35, function() card:Destroy() end)
    end)
end


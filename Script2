function Nebula:Notify(cfg)
    cfg = merge({
        Title = "Nebula",
        Content = "",
        Type = "info",
        Duration = 3,
    }, cfg)

    local t = self.Theme
    local colorFn = notifTypeColor[cfg.Type] or notifTypeColor.info
    local color = colorFn(t)

    local container = ensureNotifContainer()

    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 40, 0, 0) -- start hidden right
    card.Position = UDim2.new(0, 40, 0, 0)
    card.BackgroundColor3 = t.Surface
    card.BackgroundTransparency = 0.05
    card.BorderSizePixel = 0
    card.ClipsDescendants = true
    card.ZIndex = 5001
    card.Parent = container
    corner(card, 10)
    local cardStroke = stroke(card, t.Line, 1, 0.3)

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 1, 0)
    bar.BackgroundColor3 = color
    bar.BorderSizePixel = 0
    bar.ZIndex = 5002
    bar.Parent = card
    corner(bar, 2)

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, -24, 0, 22)
    titleLbl.Position = UDim2.new(0, 16, 0, 10)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = cfg.Title
    titleLbl.TextColor3 = t.Text
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 13
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.ZIndex = 5002
    titleLbl.Parent = card

    local textLbl = Instance.new("TextLabel")
    textLbl.Size = UDim2.new(1, -24, 0, 0)
    textLbl.Position = UDim2.new(0, 16, 0, 32)
    textLbl.BackgroundTransparency = 1
    textLbl.Text = cfg.Content
    textLbl.TextColor3 = t.TextDim
    textLbl.Font = Enum.Font.Gotham
    textLbl.TextSize = 11
    textLbl.TextWrapped = true
    textLbl.TextXAlignment = Enum.TextXAlignment.Left
    textLbl.TextYAlignment = Enum.TextYAlignment.Top
    textLbl.ZIndex = 5002
    textLbl.Parent = card

    local progress = Instance.new("Frame")
    progress.Size = UDim2.new(1, -16, 0, 2)
    progress.Position = UDim2.new(0, 8, 1, -8)
    progress.BackgroundColor3 = t.Surface3
    progress.BorderSizePixel = 0
    progress.ZIndex = 5002
    progress.Parent = card
    corner(progress, 1)

    local progressFill = Instance.new("Frame")
    progressFill.Size = UDim2.new(1, 0, 1, 0)
    progressFill.BackgroundColor3 = color
    progressFill.BorderSizePixel = 0
    progressFill.ZIndex = 5003
    progressFill.Parent = progress
    corner(progressFill, 1)

    task.defer(function()
        if not card.Parent then return end
        textLbl.Size = UDim2.new(1, -24, 0, textLbl.TextBounds.Y + 4)
        local targetH = 36 + textLbl.TextBounds.Y + 18
        tw(card, 0.32, { Size = UDim2.new(1, 0, 0, targetH), Position = UDim2.new(0, 0, 0, 0) })
        tw(progressFill, cfg.Duration, { Size = UDim2.new(0, 0, 1, 0) }, Enum.EasingStyle.Linear)
    end)

    task.delay(cfg.Duration, function()
        if not card.Parent then return end
        tw(card, 0.28, { Size = UDim2.new(1, 40, 0, 0), Position = UDim2.new(0, 40, 0, 0), BackgroundTransparency = 1 })
        tw(cardStroke, 0.28, { Transparency = 1 })
        task.delay(0.32, function()
            if card then card:Destroy() end
        end)
    end)

    return card
end


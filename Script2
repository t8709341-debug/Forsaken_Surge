                Callback = function() end,
            }, cfg)
            
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 52)
            row.BackgroundColor3 = t.Surface
            row.BorderSizePixel = 0
            row.Parent = parent or page

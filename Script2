local function buildWindow(config)
    config = kwargify({
        Name = "Nebula Frame",
        Subtitle = "v" .. Nebula.Version,
        ConfigFolder = "NebulaFrame",
        Size = UDim2.new(0, 860, 0, 520),
        MinSize = UDim2.new(0, 500, 0, 42),
    }, config)
    
    local t = Nebula.Theme
    local rootGui = createRootGui("NebulaWindow_" .. uid())
    local window = {
        Tabs = {},
        CurrentTab = nil,
        Minimized = false,
        Hidden = false,
        ScreenGui = rootGui,
        ConfigFolder = config.ConfigFolder,
    }
    
    -- ═══ CLAMP HELPERS ═══
    local function getScreenBounds()
        local viewport = Camera.ViewportSize
        return viewport.X, viewport.Y
    end
    
    local function clampPosition(pos, size)
        local sw, sh = getScreenBounds()
        local w = size.X.Offset
        local h = size.Y.Offset
        local x = pos.X.Offset
        local y = pos.Y.Offset
        -- never let more than 30px off-screen
        local minX = -w + 80
        local maxX = sw - 80
        local minY = 0
        local maxY = sh - 44
        x = math.clamp(x, minX, maxX)
        y = math.clamp(y, minY, maxY)
        return UDim2.new(0, x, 0, y)
    end
    
    -- ═══ SHADOW ═══
    local shadow = Instance.new("ImageLabel")
    shadow.Name = "Shadow"
    shadow.BackgroundTransparency = 1
    shadow.Image = "rbxassetid://6014261993"
    shadow.ImageColor3 = Color3.new(0, 0, 0)
    shadow.ImageTransparency = 0.55
    shadow.ScaleType = Enum.ScaleType.Slice
    shadow.SliceCenter = Rect.new(49, 49, 450, 450)
    shadow.Size = config.Size
    shadow.Position = UDim2.new(0.5, 0, 0.5, 0)
    shadow.AnchorPoint = Vector2.new(0.5, 0.5)
    shadow.ZIndex = 0
    shadow.Parent = rootGui
    

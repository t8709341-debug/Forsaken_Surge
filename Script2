UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end

    -- Ctrl+K
    if input.KeyCode == Enum.KeyCode.K and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        if palette.open then closePalette() else openPalette() end
        return
    end
    -- Esc закрывает палитру
    if input.KeyCode == Enum.KeyCode.Escape and palette.open then
        closePalette()
        return
    end
    -- RightShift — toggle всех окон
    if input.KeyCode == Enum.KeyCode.RightShift then
        for _, w in ipairs(Nebula.Windows) do
            if w.ToggleVisible then pcall(w.ToggleVisible, w) end
        end
    end
end)


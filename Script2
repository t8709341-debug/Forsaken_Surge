-- GRADIENT ANIMATION (единый RenderStepped)
-- ═══════════════════════════════════════════════════════════════════════
local gradientSet = setmetatable({}, { __mode = "k" })  -- weak keys
local gradientCount = 0

local function registerGradient(g)
    if not g then return end
    gradientSet[g] = true
    gradientCount = gradientCount + 1
    if not Nebula._gradConn then
        Nebula._gradConn = RunService.RenderStepped:Connect(function(dt)
            Nebula._phase = (Nebula._phase + dt * 0.12) % 1
            local t = Nebula.Theme
            local c1 = t.Accent:Lerp(t.Accent2, Nebula._phase)
            local c2 = t.Accent2:Lerp(t.Accent, Nebula._phase)
            local seq = ColorSequence.new(c1, c2)
            for g in pairs(gradientSet) do
                if g.Parent then
                    g.Color = seq
                else
                    gradientSet[g] = nil
                    gradientCount = gradientCount - 1
                end
            end
            if gradientCount <= 0 and Nebula._gradConn then
                Nebula._gradConn:Disconnect()
                Nebula._gradConn = nil
            end
        end)
    end
end


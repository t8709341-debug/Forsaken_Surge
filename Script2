        Text = "Nebula Frame v2.0 — минималистичная UI-библиотека. Нажми Ctrl+K для палитры команд. Правый Shift — скрыть/показать. Окно нельзя увести за экран.",
    })
    
    local Utils = DemoWindow:CreateTab({ Name = "⚙ Утилиты" })
    Utils:CreateSection("Уведомления")
    Utils:CreateButton({ Name = "Info", Callback = function()
        Nebula:Notify({ Title = "Info", Content = "Обычное уведомление", Type = "info" })
    end })
    Utils:CreateButton({ Name = "Success", Callback = function()
        Nebula:Notify({ Title = "Успех", Content = "Всё работает!", Type = "success" })
    end })
    Utils:CreateButton({ Name = "Warning", Callback = function()
        Nebula:Notify({ Title = "Внимание", Content = "Что-то не так", Type = "warning" })
    end })
    Utils:CreateButton({ Name = "Error", Callback = function()
        Nebula:Notify({ Title = "Ошибка", Content = "Что-то сломалось", Type = "error" })
    end })
    
    DemoWindow:CreateThemeTab()
    
    Nebula:Notify({
        Title = "Nebula Frame v2.0 загружен",
        Content = "Ctrl+K — команды · RightShift — скрыть",
        Type = "success",
        Duration = 6,
    })
    
    print("[Nebula] Готово!")
end

if not _G.NEBULA_NO_DEMO then
    task.spawn(function()
        local ok, err = pcall(launchDemo)
        if not ok then
            warn("[Nebula] Ошибка:", err)
        end
    end)
end

return Nebula

                main.Position = clampPosition(main.Position, main.Size)
                shadow.Position = main.Position
            end
        end
    end)
    
    -- ═══ MONITOR LOOP ═══
    task.spawn(function()
        local frames = 0
        local lastTime = tick()
        local fps = 60
        local fpsHistory = {}
        for i = 1, barCount do fpsHistory[i] = 60 end
        
        RunService.RenderStepped:Connect(function()
            frames = frames + 1
            if tick() - lastTime >= 0.5 then
                fps = math.floor(frames / (tick() - lastTime))
                frames = 0
                lastTime = tick()
                table.remove(fpsHistory, 1)
                table.insert(fpsHistory, fps)
                fpsValue.Text = tostring(fps)
                
                -- update bars
                local maxFPS = 120
                for i, b in ipairs(bars) do
                    local val = math.clamp(fpsHistory[i] / maxFPS, 0, 1)
                    local col = t.Accent
                    if fpsHistory[i] < 30 then col = t.Danger
                    elseif fpsHistory[i] < 60 then col = t.Warning end
                    b.BackgroundColor3 = col
                    b.Size = UDim2.new(0.6/barCount * 1000 / 100, 0, val, 0)
                end
            end
        end)
        
        while rootGui.Parent do
            task.wait(1)
            local ping = 0
            pcall(function()
                ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
            local mem = math.floor(Stats:GetTotalMemoryUsageMb())
            statusRight.Text = string.format("FPS %d · Ping %dms · Mem %dMB", fps, ping, mem)
        end
    end)
    

    function window:SaveConfig(name)
        local data = {}
        for flag, opt in pairs(Nebula.Options) do
            if opt.CurrentValue ~= nil then data[flag] = opt.CurrentValue
            elseif opt.CurrentOption ~= nil then data[flag] = opt.CurrentOption
            elseif opt.Color ~= nil then
                data[flag] = { R = opt.Color.R, G = opt.Color.G, B = opt.Color.B }
            end
        end
        local ok, json = pcall(HttpService.JSONEncode, HttpService, data)
        if not ok then
            Nebula:Notify({ Title = "Ошибка", Content = "Не удалось сериализовать", Type = "error" })
            return
        end
        if writefile then
            pcall(function()
                if not isfolder(Nebula.ConfigFolder or "NebulaFrame") then
                    makefolder(Nebula.ConfigFolder or "NebulaFrame")
                end
                writefile((Nebula.ConfigFolder or "NebulaFrame") .. "/" .. name .. ".json", json)
            end)
            Nebula:Notify({ Title = "Конфиг сохранён", Content = name .. ".json", Type = "success" })
        else
            Nebula:Notify({ Title = "Конфиг", Content = "writefile недоступен в этом экзекьюторе", Type = "warning" })
        end
    end
    

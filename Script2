-- COMMAND PALETTE
-- ═══════════════════════════════════════════════════════════════════════
local commandRegistry = {}
local paletteGui, palettePanel, paletteDim, paletteSearch, paletteResults
local paletteOpen = false

local function registerCommand(name, type, action)
    table.insert(commandRegistry, { name = name, type = type, action = action })
end

local function closePalette()
    if not paletteOpen then return end
    paletteOpen = false
    tw(paletteDim, 0.2, { BackgroundTransparency = 1 })
    tw(palettePanel, 0.2, { BackgroundTransparency = 1 })
    task.delay(0.2, function()
        if paletteDim then paletteDim.Visible = false end
        if palettePanel then palettePanel.Visible = false end
    end)
end

local function refreshPalette(query)
    if not paletteResults then return end
    for _, c in ipairs(paletteResults:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    local t = Nebula.Theme
    query = query:lower()
    local count = 0
    for _, cmd in ipairs(commandRegistry) do
        if query == "" or cmd.name:lower():find(query, 1, true) then
            count = count + 1
            if count > 40 then break end
            
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 36)
            btn.BackgroundColor3 = t.Surface
            btn.BorderSizePixel = 0
            btn.Text = ""
            btn.AutoButtonColor = false
            btn.Parent = paletteResults
            corner(btn, 6)
            
            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(1, -90, 1, 0)
            nameLbl.Position = UDim2.new(0, 14, 0, 0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = cmd.name
            nameLbl.TextColor3 = t.Text
            nameLbl.Font = Enum.Font.Gotham
            nameLbl.TextSize = 13
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
            nameLbl.Parent = btn
            
            local typeLbl = Instance.new("TextLabel")
            typeLbl.Size = UDim2.new(0, 80, 1, 0)
            typeLbl.Position = UDim2.new(1, -90, 0, 0)
            typeLbl.BackgroundTransparency = 1
            typeLbl.Text = cmd.type
            typeLbl.TextColor3 = t.TextDim
            typeLbl.Font = Enum.Font.Gotham
            typeLbl.TextSize = 10
            typeLbl.TextXAlignment = Enum.TextXAlignment.Right
            typeLbl.Parent = btn
            
            btn.MouseEnter:Connect(function()
                tw(btn, 0.12, { BackgroundColor3 = t.Surface2 })
            end)
            btn.MouseLeave:Connect(function()
                tw(btn, 0.12, { BackgroundColor3 = t.Surface })
            end)
            btn.MouseButton1Click:Connect(function()
                closePalette()
                pcall(cmd.action)
            end)
        end
    end
    paletteResults.CanvasSize = UDim2.new(0, 0, 0, paletteResults.UIListLayout.AbsoluteContentSize.Y + 8)
end

local function openPalette()
    paletteOpen = true
    paletteDim.Visible = true
    palettePanel.Visible = true
    tw(paletteDim, 0.2, { BackgroundTransparency = 0.6 })
    tw(palettePanel, 0.2, { BackgroundTransparency = 0 })

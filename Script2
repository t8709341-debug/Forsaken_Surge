            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 12
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = row
            
            local valLbl = Instance.new("TextLabel")
            valLbl.Size = UDim2.new(0, 60, 0, 20)
            valLbl.Position = UDim2.new(1, -70, 0, 6)
            valLbl.BackgroundTransparency = 1
            valLbl.Text = tostring(cfg.CurrentValue)
            valLbl.TextColor3 = t.Accent
            valLbl.Font = Enum.Font.Code
            valLbl.TextSize = 12
            valLbl.TextXAlignment = Enum.TextXAlignment.Right
            valLbl.Parent = row
            
            local bar = Instance.new("Frame")
            bar.Size = UDim2.new(1, -24, 0, 6)
            bar.Position = UDim2.new(0, 12, 0, 32)
            bar.BackgroundColor3 = t.Surface2
            bar.BorderSizePixel = 0
            bar.Parent = row
            corner(bar, 3)
            
            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(
                (cfg.CurrentValue - cfg.Range[1]) / math.max(cfg.Range[2] - cfg.Range[1], 0.001),
                0, 1, 0
            )
            fill.BackgroundColor3 = t.Accent
            fill.BorderSizePixel = 0
            fill.Parent = bar
            corner(fill, 3)
            
            local fillGrad = Instance.new("UIGradient")
            fillGrad.Color = ColorSequence.new(t.Accent, t.Accent2)
            fillGrad.Parent = fill
            registerGradient(fillGrad)
            
            local dragging = false
            local function updateFromX(x)
                local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                local val = cfg.Range[1] + rel * (cfg.Range[2] - cfg.Range[1])
                val = math.floor(val / cfg.Increment + 0.5) * cfg.Increment
                val = math.clamp(val, cfg.Range[1], cfg.Range[2])
                fill.Size = UDim2.new(rel, 0, 1, 0)
                valLbl.Text = tostring(val)
                cfg.CurrentValue = val
                local ok, err = pcall(cfg.Callback, val)
                if not ok then Nebula:Notify({ Title = "Error", Content = tostring(err), Type = "error" }) end
            end
            
            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateFromX(input.Position.X)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                    updateFromX(input.Position.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            
            if flag then
                Nebula.Options[flag] = { Set = function(val) updateFromX(bar.AbsolutePosition.X + (val - cfg.Range[1]) / (cfg.Range[2] - cfg.Range[1]) * bar.AbsoluteSize.X) end }
            end
            
            recalcCanvas()
            local v = {}
            function v:Set(c)
                if c.CurrentValue then updateFromX(bar.AbsolutePosition.X + (c.CurrentValue - cfg.Range[1]) / (cfg.Range[2] - cfg.Range[1]) * bar.AbsoluteSize.X) end
                if c.Name then lbl.Text = c.Name end
            end
            function v:UpdateValue(val)
                updateFromX(bar.AbsolutePosition.X + (val - cfg.Range[1]) / (cfg.Range[2] - cfg.Range[1]) * bar.AbsoluteSize.X)
            end
            function v:Destroy() row:Destroy(); recalcCanvas() end
            return v
        end
        

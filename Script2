function refreshPalette(query)
    if not palette.pool or #palette.pool == 0 then return end
    query = (query or ""):lower()
    local t = Nebula.Theme

    -- фильтрация
    local filtered = {}
    for i, cmd in ipairs(commands) do
        if query == "" or cmd.name:lower():find(query, 1, true) then
            table.insert(filtered, i)
            if #filtered >= 40 then break end
        end
    end

    for i = 1, 40 do
        local entry = palette.pool[i]
        local btn = entry.button
        if i <= #filtered then
            local idx = filtered[i]
            local cmd = commands[idx]
            btn.Visible = true
            btn:SetAttribute("cmdIndex", idx)
            entry.nameLbl.Text = cmd.name
            entry.kindLbl.Text = cmd.kind
            btn.BackgroundColor3 = t.Surface
            entry.nameLbl.TextColor3 = t.Text
            entry.kindLbl.TextColor3 = t.TextDim
            btn.UIStroke = btn:FindFirstChildOfClass("UIStroke")
        else
            btn.Visible = false
            btn:SetAttribute("cmdIndex", nil)
        end
    end

    palette.results.CanvasSize = UDim2.new(0, 0, 0, palette.results.UIListLayout.AbsoluteContentSize.Y + 8)
end

function openPalette()
    if palette.open then return end
    palette.open = true
    palette.dim.Visible = true
    palette.panel.Visible = true
    tw(palette.dim, 0.2, { BackgroundTransparency = 0.55 })
    tw(palette.panel, 0.22, { BackgroundTransparency = 0 })
    palette.search.Text = ""
    refreshPalette("")
    task.defer(function()
        if palette.search and palette.search.Parent then
            palette.search:CaptureFocus()
        end
    end)
end

function closePalette()
    if not palette.open then return end
    palette.open = false
    tw(palette.dim, 0.18, { BackgroundTransparency = 1 })
    tw(palette.panel, 0.18, { BackgroundTransparency = 1 })
    task.delay(0.2, function()
        if palette.dim then palette.dim.Visible = false end
        if palette.panel then palette.panel.Visible = false end
    end)
end


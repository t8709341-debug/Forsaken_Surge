    -- ═══ MONITOR LOOP (FPS / ping / mem) ═══
    task.spawn(function()
        local frames = 0
        local lastTime = tick()
        local fps = 60
        local history = {}
        for i = 1, barCount do history[i] = 60 end

        track(RunService.RenderStepped:Connect(function()
            frames = frames + 1
            local now = tick()
            if now - lastTime >= 0.5 then
                fps = math.floor(frames / (now - lastTime) + 0.5)
                frames = 0
                lastTime = now
                table.remove(history, 1)
                table.insert(history, fps)
                fpsValue.Text = tostring(fps)

                -- update bars (abs size)
                local bw = math.max(1, math.floor(barsFrame.AbsoluteSize.X / barCount) - 1)
                local bh = math.max(1, barsFrame.AbsoluteSize.Y)
                local maxFPS = 120
                for i, b in ipairs(bars) do
                    local val = math.clamp((history[i] or 0) / maxFPS, 0.02, 1)
                    local col = t.Accent
                    if (history[i] or 0) < 30 then col = t.Danger
                    elseif (history[i] or 0) < 60 then col = t.Warning end
                    b.BackgroundColor3 = col
                    b.Size = UDim2.new(0, bw, 0, math.floor(bh * val))
                end
            end
        end))

        while RootGui.Parent and not window._destroyed do
            task.wait(1)
            local ping = 0
            local mem = 0
            pcall(function()
                local statsItem = Stats.Network and Stats.Network.ServerStatsItem
                if statsItem and statsItem["Data Ping"] then
                    ping = math.floor(statsItem["Data Ping"]:GetValue())
                end
            end)
            pcall(function()
                mem = math.floor(Stats:GetTotalMemoryUsageMb())
            end)
            statusRight.Text = string.format("FPS %d · Ping %dms · Mem %dMB", fps, ping, mem)
        end
    end)


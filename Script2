            fill.Size = UDim2.new(0, 0, 1, 0)
            fill.BackgroundColor3 = Nebula.Theme.Accent
            fill.BorderSizePixel = 0
            fill.ZIndex = 15
            fill.Parent = bar
            corner(fill, 3)

            local fillGrad = Instance.new("UIGradient")
            fillGrad.Color = ColorSequence.new(Nebula.Theme.Accent, Nebula.Theme.Accent2)
            fillGrad.Parent = fill
            registerGradient(fillGrad)

            local dragging = false
            local function updateFromX(x, silent)
                local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
                local val = cfg.Range[1] + rel * (cfg.Range[2] - cfg.Range[1])
                val = math.floor(val / cfg.Increment + 0.5) * cfg.Increment
                val = math.clamp(val, cfg.Range[1], cfg.Range[2])
                local newRel = (val - cfg.Range[1]) / math.max(cfg.Range[2] - cfg.Range[1], 0.0001)
                fill.Size = UDim2.new(newRel, 0, 1, 0)
                valLbl.Text = tostring(val) .. cfg.Suffix
                cfg.CurrentValue = val
                if not silent then
                    local ok, err = pcall(cfg.Callback, val)
                    if not ok then Nebula:Notify({ Title = "Ошибка", Content = tostring(err), Type = "error" }) end
                end
            end

            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateFromX(input.Position.X)
                end
            end)
            track(UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                    updateFromX(input.Position.X)
                end
            end))
            track(UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end))

            -- init visual
            task.defer(function()
                if fill and bar then
                    local rel = (cfg.CurrentValue - cfg.Range[1]) / math.max(cfg.Range[2] - cfg.Range[1], 0.0001)
                    fill.Size = UDim2.new(math.clamp(rel, 0, 1), 0, 1, 0)
                end
            end)

            if flag then
                Nebula.Options[flag] = {
                    Set = function(val)
                        val = math.clamp(val, cfg.Range[1], cfg.Range[2])
                        local rel = (val - cfg.Range[1]) / math.max(cfg.Range[2] - cfg.Range[1], 0.0001)
                        fill.Size = UDim2.new(rel, 0, 1, 0)
                        valLbl.Text = tostring(val) .. cfg.Suffix
                        cfg.CurrentValue = val
                        pcall(cfg.Callback, val)
                    end,
                    Get = function() return cfg.CurrentValue end,
                }
            end

            recalc()
            local v = {}
            function v:Set(c)
                if c.Name then lbl.Text = c.Name end
                if c.CurrentValue then
                    Nebula.Options[flag] and Nebula.Options[flag].Set(c.CurrentValue)
                end
            end
            function v:UpdateValue(val) Nebula.Options[flag] and Nebula.Options[flag].Set(val) end
            function v:Destroy() row:Destroy(); recalc() end
            return v
        end


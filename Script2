    -- ═══ CONFIG SAVE / LOAD ═══
    function window:SaveConfig(name)
        local data = {}
        for flag, opt in pairs(Nebula.Options) do
            if opt.Get then
                local ok, v = pcall(opt.Get)
                if ok then data[flag] = v end
            elseif opt.Value ~= nil then
                data[flag] = opt.Value
            end
        end
        -- Color3 → table
        for k, v in pairs(data) do
            if typeof(v) == "Color3" then
                data[k] = { __color = true, R = v.R, G = v.G, B = v.B }
            end
        end
        local ok, json = pcall(function() return HttpService:JSONEncode(data) end)
        if not ok then
            Nebula:Notify({ Title = "Ошибка", Content = "Не удалось сериализовать", Type = "error" })
            return
        end
        if writefile then
            local success = pcall(function()
                if not isfolder(Nebula.ConfigFolder or "NebulaFrame") then
                    makefolder(Nebula.ConfigFolder or "NebulaFrame")
                end
                writefile((Nebula.ConfigFolder or "NebulaFrame") .. "/" .. name .. ".json", json)
            end)
            if success then
                Nebula:Notify({ Title = "Конфиг сохранён", Content = name .. ".json", Type = "success" })
            else
                Nebula:Notify({ Title = "Ошибка", Content = "writefile провалился", Type = "error" })
            end
        elseif setclipboard then
            pcall(setclipboard, json)
            Nebula:Notify({ Title = "Конфиг в буфере", Content = "writefile нет — JSON скопирован", Type = "warning" })
        else
            Nebula:Notify({ Title = "Конфиг", Content = "Нет writefile/clipboard", Type = "warning" })
        end
    end

    function window:LoadConfig(name)
        if not (readfile and isfile) then
            Nebula:Notify({ Title = "Конфиг", Content = "readfile недоступен", Type = "warning" })
            return
        end
        local path = (Nebula.ConfigFolder or "NebulaFrame") .. "/" .. name .. ".json"
        if not isfile(path) then
            Nebula:Notify({ Title = "Конфиг", Content = "Файл не найден: " .. name, Type = "warning" })
            return
        end
        local ok, content = pcall(readfile, path)
        if not ok then
            Nebula:Notify({ Title = "Ошибка", Content = "readfile провалился", Type = "error" })
            return
        end
        local ok2, data = pcall(function() return HttpService:JSONDecode(content) end)
        if not ok2 or type(data) ~= "table" then
            Nebula:Notify({ Title = "Ошибка", Content = "Некорректный JSON", Type = "error" })
            return
        end
        local count = 0
        for flag, val in pairs(data) do
            local opt = Nebula.Options[flag]
            if opt and opt.Set then
                if type(val) == "table" and val.__color then
                    val = Color3.new(val.R, val.G, val.B)
                end
                pcall(opt.Set, val)
                count = count + 1
            end
        end
        Nebula:Notify({ Title = "Конфиг загружен", Content = count .. " опций применено", Type = "success" })
    end


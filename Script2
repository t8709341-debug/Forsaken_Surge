    function window:CreateThemeTab()
        local tab = window:CreateTab({ Name = "🎨 Темы" })
        tab:CreateSection("Пресеты")
        for name, _ in pairs(Nebula.Themes) do
            tab:CreateButton({
                Name = name,
                Callback = function()
                    Nebula.ThemeName = name
                    Nebula.Theme = Nebula.Themes[name]
                    Nebula:Notify({ Title = "Тема выбрана", Content = name .. " — перезапусти скрипт", Type = "info", Duration = 4 })
                end,
            })
        end
        return tab
    end
    
    return window
end


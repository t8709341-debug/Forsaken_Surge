            if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end

            local speed = settings.TURBO_SPEED
            local mode = settings.TURBO_MODE
            if mode == "Velocity" then
                hrp.AssemblyLinearVelocity = moveDir * speed
                hrp.AssemblyAngularVelocity = Vector3.zero
            elseif mode == "Teleport" then
                local step = speed * 0.016
                hrp.CFrame = hrp.CFrame + moveDir * step
                hrp.AssemblyLinearVelocity = Vector3.zero
            elseif mode == "Combo" then
                hrp.AssemblyLinearVelocity = moveDir * speed * 0.5
                local step = speed * 0.008
                hrp.CFrame = hrp.CFrame + moveDir * step
            end
        end
    end
end)


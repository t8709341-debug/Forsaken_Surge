local function getHitboxFast(model, hitboxName)
    if not model then return nil end
    if hitboxName == "Head" then
        return model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    elseif hitboxName == "Torso" then
        return model:FindFirstChild("Torso")
            or model:FindFirstChild("UpperTorso")
            or model:FindFirstChild("LowerTorso")
            or model:FindFirstChild("HumanoidRootPart")
    end
    return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
end

local function isVisible(targetPart)
    if not settings.AIMBOT_WALL_CHECK then return true end
    if not targetPart or not targetPart.Parent then return false end
    local origin = Camera.CFrame.Position
    local dir = targetPart.Position - origin
    local exclude = {}
    if character then table.insert(exclude, character) end
    local myModel = getWorkspaceModel(player)
    if myModel then table.insert(exclude, myModel) end
    aimbotRayFilter.FilterDescendantsInstances = exclude
    local result = Workspace:Raycast(origin, dir, aimbotRayFilter)
    if result and result.Instance then
        local root = targetPart.Parent
        if result.Instance == targetPart or (root and result.Instance:IsDescendantOf(root)) then
            return true
        end
        return false
    end
    return true
end

local function scanWorkspacePlayers()
    local candidates = {}
    local wsPlayers = getWorkspacePlayersFolder()
    if not wsPlayers then return candidates end
    local myPos = Camera.CFrame.Position
    local myRole = getLocalPlayerRole()

    local folders = {
        { name = "Killers",   role = "Killer"   },
        { name = "Survivors", role = "Survivor" },
    }

    for _, info in ipairs(folders) do
        if info.role == "Killer"   and not settings.AIMBOT_TARGET_KILLERS   then continue end
        if info.role == "Survivor" and not settings.AIMBOT_TARGET_SURVIVORS then continue end
        if settings.AIMBOT_TEAM_CHECK and myRole ~= "Unknown" and myRole == info.role then continue end

        local folder = wsPlayers:FindFirstChild(info.name)
        if folder then
            for _, model in ipairs(folder:GetChildren()) do
                if model:IsA("Model") then
                    local hum  = model:FindFirstChildOfClass("Humanoid")
                    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                    if hum and root then
                        if not settings.AIMBOT_IGNORE_DEAD or hum.Health > 0 then
                            local dist = (root.Position - myPos).Magnitude
                            if dist <= settings.AIMBOT_MAX_DISTANCE and dist >= settings.AIMBOT_MIN_DISTANCE then
                                table.insert(candidates, {
                                    model = model, root = root, hum = hum,
                                    dist  = dist,  health = hum.Health, role = info.role,
                                })
                            end
                        end
                    end
                end
            end
        end
    end
    return candidates
end

local function scanNpcs()
    local candidates = {}
    if not (settings.AIMBOT_MODE == "PVE" or settings.AIMBOT_MODE == "Both") then return candidates end
    local myPos = Camera.CFrame.Position
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    params.MaxParts = 200
    local parts = Workspace:GetPartBoundsInRadius(myPos, settings.AIMBOT_PVE_RADIUS, params)
    local seen, count = {}, 0
    local wsPlayers = getWorkspacePlayersFolder()
    for _, part in ipairs(parts) do
        if count >= settings.AIMBOT_MAX_NPC_CANDIDATES then break end
        local model = part:FindFirstAncestorOfClass("Model")
        if model and not seen[model] then
            seen[model] = true
            local skip = false
            if wsPlayers then
                for _, folderName in ipairs({"Killers","Survivors"}) do
                    local f = wsPlayers:FindFirstChild(folderName)
                    if f and model:IsDescendantOf(f) then skip = true break end
                end
            end
            if not skip and model ~= character then
                local hum  = model:FindFirstChildOfClass("Humanoid")
                local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                if hum and root and (not settings.AIMBOT_IGNORE_DEAD or hum.Health > 0) then
                    local dist = (root.Position - myPos).Magnitude
                    if dist <= settings.AIMBOT_MAX_DISTANCE and dist >= settings.AIMBOT_MIN_DISTANCE then
                        count = count + 1
                        table.insert(candidates, {
                            model = model, root = root, hum = hum,
                            dist  = dist,  health = hum.Health, role = "NPC",
                        })
                    end
                end
            end
        end
    end
    return candidates
end

local function scanCandidates()
    local list = {}
    for _, c in ipairs(scanWorkspacePlayers()) do table.insert(list, c) end
    for _, c in ipairs(scanNpcs())            do table.insert(list, c) end
    return list
end

local function pickBestTarget(candidates)
    if #candidates == 0 then return nil end
    local mousePos = Vector2.new(mouse.X, mouse.Y)
    local valid = {}
    for _, c in ipairs(candidates) do
        local part = getHitboxFast(c.model, settings.AIMBOT_HITBOX)
        if part and part.Parent then
            local sp, on = Camera:WorldToViewportPoint(part.Position)
            if on and sp.Z > 0 then
                local vec = Vector2.new(sp.X, sp.Y)
                local d = (vec - mousePos).Magnitude
                if not settings.AIMBOT_FOV_ENABLED or d <= settings.AIMBOT_FOV then
                    table.insert(valid, { model = c.model, part = part, dist = c.dist, screenDist = d, health = c.health })
                end
            end
        end
    end
    if #valid == 0 then return nil end
    local mode = settings.AIMBOT_LOCK_MODE
    if mode == "Closest"           then table.sort(valid, function(a,b) return a.dist < b.dist end)
    elseif mode == "NearestCenter"  then table.sort(valid, function(a,b) return a.screenDist < b.screenDist end)
    elseif mode == "LowestHealth"   then table.sort(valid, function(a,b) return a.health < b.health end)
    elseif mode == "HighestHealth"  then table.sort(valid, function(a,b) return a.health > b.health end) end
    return valid[1]
end

local function getAimPosition(targetPart)
    if not targetPart then return nil end
    local pos = targetPart.Position + Vector3.new(0, settings.AIMBOT_HITBOX_OFFSET_Y, 0)
    if settings.AIMBOT_PREDICTION then
        local vel = targetPart.AssemblyLinearVelocity
        if vel.Magnitude > 0.1 then
            pos = pos + Vector3.new(
                vel.X * settings.AIMBOT_PREDICTION_X,
                vel.Y * settings.AIMBOT_PREDICTION_Y,
                vel.Z * settings.AIMBOT_PREDICTION_Z)
        end
    end
    return pos
end

local originalCameraType, originalCameraSubject
local aimbotCameraOverride = false
local function setAimbotCameraOverride(on)
    if on and not aimbotCameraOverride then
        originalCameraType    = Camera.CameraType
        originalCameraSubject = Camera.CameraSubject
        Camera.CameraType = Enum.CameraType.Scriptable
        aimbotCameraOverride = true
    elseif not on and aimbotCameraOverride then
        Camera.CameraType    = originalCameraType or Enum.CameraType.Custom
        Camera.CameraSubject = originalCameraSubject
        aimbotCameraOverride = false
    end
end

local lastFovColor, lastFovSize = Color3.new(), 0

RunService.RenderStepped:Connect(function(dt)
    if not settings.AIMBOT_ENABLED then
        if fovCircle and fovCircle.circle then fovCircle.circle.Visible = false end
        if targetIndicator and targetIndicator.dot then targetIndicator.dot.Visible = false end
        setAimbotCameraOverride(false)
        return
    end

    if fovCircle and fovCircle.circle then
        fovCircle.circle.Visible = settings.AIMBOT_SHOW_FOV
        local newSize = settings.AIMBOT_FOV * 2
        if newSize ~= lastFovSize then
            fovCircle.circle.Size = UDim2.fromOffset(newSize, newSize); lastFovSize = newSize
        end
        local newColor = Color3.fromRGB(settings.AIMBOT_FOV_COLOR_R, settings.AIMBOT_FOV_COLOR_G, settings.AIMBOT_FOV_COLOR_B)
        if newColor ~= lastFovColor then fovCircle.stroke.Color = newColor; lastFovColor = newColor end
    end

    local shouldAim = settings.AIMBOT_TOGGLE_MODE and aimbotActive
        or (not settings.AIMBOT_TOGGLE_MODE and aimbotHolding)
    if not shouldAim then
        if targetIndicator and targetIndicator.dot then targetIndicator.dot.Visible = false end
        setAimbotCameraOverride(false)
        return
    end

    local now = tick()
    if now - aimbotLastScan >= settings.AIMBOT_SCAN_INTERVAL then
        aimbotLastScan = now
        aimbotCachedCandidates = scanCandidates()
    end

    local best = pickBestTarget(aimbotCachedCandidates)
    if not best then
        aimbotTarget, aimbotTargetPart = nil, nil
        if targetIndicator and targetIndicator.dot then targetIndicator.dot.Visible = false end
        setAimbotCameraOverride(false)
        return
    end

    if settings.AIMBOT_WALL_CHECK and not isVisible(best.part) then
        aimbotTarget, aimbotTargetPart = nil, nil
        if targetIndicator and targetIndicator.dot then targetIndicator.dot.Visible = false end
        setAimbotCameraOverride(false)
        return
    end

    aimbotTarget = best.model
    aimbotTargetPart = best.part

    if targetIndicator and targetIndicator.dot then
        local sp, on = Camera:WorldToViewportPoint(best.part.Position)
        if on and sp.Z > 0 and settings.AIMBOT_SHOW_TARGET then
            targetIndicator.dot.Visible = true
            targetIndicator.dot.Position = UDim2.fromOffset(sp.X, sp.Y)
            targetIndicator.dot.BackgroundColor3 = Color3.fromRGB(
                settings.AIMBOT_TARGET_COLOR_R, settings.AIMBOT_TARGET_COLOR_G, settings.AIMBOT_TARGET_COLOR_B)
        else
            targetIndicator.dot.Visible = false
        end
    end

    setAimbotCameraOverride(true)
    local aimPos = getAimPosition(best.part)
    if aimPos then
        local curCF = Camera.CFrame
        local tgtCF = CFrame.lookAt(curCF.Position, aimPos)
        local alpha = 1 - math.clamp(settings.AIMBOT_SMOOTHNESS, 0, 0.99)
        Camera.CFrame = curCF:Lerp(tgtCF, math.clamp(alpha * (dt * 60), 0, 1))
    end

    if settings.AIMBOT_AUTO_SHOOT and (now - lastAutoShoot >= settings.AIMBOT_AUTO_SHOOT_DELAY) then
        if not settings.AIMBOT_AUTO_SHOOT_ONLY_VISIBLE or isVisible(best.part) then
            lastAutoShoot = now
            pcall(function()
                local tool = character and character:FindFirstChildOfClass("Tool")
                if tool then tool:Activate()
                else
                    VirtualInputManager:SendMouseButtonEvent(0,0,0,true,  game, 0)
                    task.wait(0.03)
                    VirtualInputManager:SendMouseButtonEvent(0,0,0,false, game, 0)
                end
            end)
        end
    end
end)


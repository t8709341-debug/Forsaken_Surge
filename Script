-- АВТОГЕНЕРАТОР (Оптимизированный)
-- ==========================================

local AutoGen = {
    IsRunning = false,
    CurrentGenerator = nil,
    RNG = Random.new(),
    LastCheck = 0,
    CheckInterval = 0.15,
    CachedGenerators = {},
    CacheTime = 0,
    CacheLifetime = 2
}

local function GetCachedGenerators()
    local now = tick()
    if now - AutoGen.CacheTime > AutoGen.CacheLifetime then
        AutoGen.CachedGenerators = {}
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and (obj.Name == "Generator" or string.find(string.lower(obj.Name), "generator")) and obj:FindFirstChild("Main") then
                local progress = obj:FindFirstChild("Progress")
                if progress and progress.Value < 100 then
                    table.insert(AutoGen.CachedGenerators, obj)
                end
            end
        end
        AutoGen.CacheTime = now
    end
    return AutoGen.CachedGenerators
end

local function IsPlayersNear(distance)
    if not hrp then return false end
    
    local pos = hrp.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root and (root.Position - pos).Magnitude < distance then
                    return true
                end
            end
        end
    end
    return false
end

local function GetGenCooldown()
    local baseCD = settings.GENERATOR_COOLDOWN or 3
    local speedUp = settings.SPEED_UP_COOLDOWN
    
    if speedUp then
        local playersNear = IsPlayersNear(32)
        if not playersNear and baseCD > 2 then
            return math.max(1.5, baseCD * 0.3)
        end
    end
    
    return baseCD
end

local function FixGenerator(generator)
    if not generator or not generator.Parent then return false end
    
    local remotes = generator:FindFirstChild("Remotes")
    local progress = generator:FindFirstChild("Progress")
    if not remotes or not progress then return false end
    
    local remoteEvent = remotes:FindFirstChildOfClass("RemoteEvent")
    if not remoteEvent then return false end
    
    if progress.Value >= 100 then return false end
    
    local cooldown = GetGenCooldown()
    local variance = cooldown * 0.1
    local delay = AutoGen.RNG:NextNumber(cooldown - variance, cooldown + variance)
    task.wait(math.max(0.5, delay))
    
    if not AutoGen.IsRunning or not character then return false end
    if progress.Value >= 100 then return false end
    
    remoteEvent:FireServer()
    
    local main = generator:FindFirstChild("Main")
    if main then
        -- Воспроизведение звука
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://9120401844"
        sound.Parent = main
        sound:Play()
        Debris:AddItem(sound, 2)
    end
    
    return true
end

local function AutoGeneratorLoop()
    if not settings.AUTO_GENERATOR then
        AutoGen.IsRunning = false
        return
    end
    
    if not hrp or not character then return end
    if AutoGen.IsRunning then return end
    
    local generators = GetCachedGenerators()
    if #generators == 0 then return end
    
    local nearest = nil
    local nearestDist = math.huge
    local pos = hrp.Position
    
    for _, gen in ipairs(generators) do
        local main = gen:FindFirstChild("Main")
        if main then
            local dist = (main.Position - pos).Magnitude
            if dist < nearestDist and dist < 7 then
                nearestDist = dist
                nearest = gen
            end
        end
    end
    
    if not nearest then return end
    
    AutoGen.IsRunning = true
    AutoGen.CurrentGenerator = nearest
    
    FixGenerator(nearest)
    
    AutoGen.IsRunning = false
    AutoGen.CurrentGenerator = nil
    AutoGen.CacheTime = 0
end

-- Запуск автогенератора
task.spawn(function()
    while true do
        task.wait(0.15)
        pcall(AutoGeneratorLoop)
    end
end)

player.CharacterAdded:Connect(function()

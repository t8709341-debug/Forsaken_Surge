    if not hrp or not humanoid then
        updateCharacterReferences()
        if not hrp or not humanoid then return end
    end
    
    climbing = not climbing
    if climbing then
        humanoid.AutoRotate = false
        humanoid.PlatformStand = true
        facing = hrp.CFrame.LookVector
        upDir = hrp.CFrame.UpVector
        gravityDir = -upDir
        isOnCeiling = false
        ceilingTime = 0
        showNotification("🕷️ Ходьба", "Включена", 1)
    else
        humanoid.AutoRotate = true
        humanoid.PlatformStand = false
        gravityDir = Vector3.new(0, -1, 0)
        upDir = Vector3.new(0, 1, 0)
        fallSpeed = 0
        isGrounded = false
        isOnCeiling = false
        ceilingTime = 0
        if hrp then
            hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + facing)
        end
        showNotification("🕷️ Ходьба", "Выключена", 1)
    end
end


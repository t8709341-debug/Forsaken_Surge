local function RenderESP()
    if not settings.ESP_ENABLED then
        -- Удаляем все ESP объекты
        for _, child in ipairs(espFolder:GetDescendants()) do
            if child:GetAttribute("ESP") then
                child:Destroy()
            end
        end
        return
    end
    
    local cameraPos = Camera.CFrame.Position
    local maxDist = settings.ESP_MAX_DISTANCE or 120
    local minDist = settings.ESP_MIN_DISTANCE or 8
    
    -- Очищаем старые объекты (кэшируем для переиспользования)
    local toRemove = {}
    for _, child in ipairs(espFolder:GetDescendants()) do
        if child:GetAttribute("ESP") then
            local parent = child:GetAttribute("Parent")
            if not parent or not parent.Parent then
                table.insert(toRemove, child)
            end
        end
    end
    
    for _, obj in ipairs(toRemove) do
        obj:Destroy()
    end
    
    -- Отрисовка игроков
    if settings.KILLERS_ESP or settings.SURVIVORS_ESP then
        for _, data in ipairs(ESP.Cache.Players) do
            if data.Root and data.Root.Parent then
                local dist = (data.Root.Position - cameraPos).Magnitude
                if dist < maxDist then
                    local color
                    local show = false
                    
                    if data.IsKiller and settings.KILLERS_ESP then
                        color = GetESPColor("KILLERS_COLOR", "Red")
                        show = true
                    elseif not data.IsKiller and settings.SURVIVORS_ESP then
                        color = GetESPColor("SURVIVORS_COLOR", "Green")
                        show = true
                    end
                    
                    if show then
                        -- Создаем highlight
                        local highlight = CreateOptimizedHighlight(data.Character, color, dist)
                        if highlight then
                            highlight.Parent = espFolder
                        end
                        
                        -- Создаем текст
                        if settings.SHOW_TEXT then
                            local text = CreateOptimizedText(data.Character, data.Name, color, dist)
                            if text then
                                text.Parent = espFolder
                            end
                        end
                    end
                end
            end
        end
    end
    
    -- Отрисовка генераторов
    if settings.GENERATORS_ESP then
        for _, data in ipairs(ESP.Cache.Generators) do
            if data.Main and data.Main.Parent then
                local dist = (data.Main.Position - cameraPos).Magnitude
                if dist < maxDist then
                    local color = GetESPColor("GENERATORS_COLOR", "Cyan")
                    
                    local highlight = CreateOptimizedHighlight(data.Object, color, dist)
                    if highlight then
                        highlight.Parent = espFolder
                    end
                    
                    if settings.SHOW_TEXT then
                        local text = CreateOptimizedText(data.Object, "⚡ " .. data.Name, color, dist)
                        if text then
                            text.Parent = espFolder
                        end
                    end
                end
            end
        end
    end
    
    -- Отрисовка предметов
    if settings.ITEMS_ESP then
        for _, data in ipairs(ESP.Cache.Items) do
            if data.Main and data.Main.Parent then
                local dist = (data.Main.Position - cameraPos).Magnitude
                if dist < maxDist then
                    local color = GetESPColor("ITEMS_COLOR", "Gold")
                    
                    local highlight = CreateOptimizedHighlight(data.Object, color, dist)
                    if highlight then
                        highlight.Parent = espFolder
                    end
                    
                    if settings.SHOW_TEXT then
                        local text = CreateOptimizedText(data.Object, "📦 " .. data.Name, color, dist)
                        if text then
                            text.Parent = espFolder
                        end
                    end
                end
            end
        end
    end
end


task.spawn(function()
    while true do
        task.wait(1)
        if not settings.ESP_ENABLED then
            clearAllESP()
            continue
        end
        
        clearAllESP()
        
        -- Игроки
        if settings.KILLERS_ESP or settings.SURVIVORS_ESP then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr == player then continue end
                local char = plr.Character
                if not char or not char.Parent then continue end
                local hum = char:FindFirstChild("Humanoid")
                if not hum or hum.Health <= 0 then continue end
                
                local isKiller = false
                local team = plr.Team
                if team then
                    local teamName = string.lower(team.Name)
                    if teamName:find("killer") or teamName:find("monster") or teamName:find("enemy") then
                        isKiller = true
                    end
                end
                
                local color
                if isKiller and settings.KILLERS_ESP then
                    color = ColorPresets[settings.KILLERS_COLOR] or ColorPresets.Red
                    createHighlight(char, color)
                elseif not isKiller and settings.SURVIVORS_ESP then
                    color = ColorPresets[settings.SURVIVORS_COLOR] or ColorPresets.Green
                    createHighlight(char, color)
                end
            end
        end
        
        -- Генераторы
        if settings.GENERATORS_ESP then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") and obj.Parent then
                    local name = string.lower(obj.Name)
                    if string.find(name, "generator") or string.find(name, "gen") or obj:GetAttribute("Generator") then
                        local progress = obj:FindFirstChild("Progress")
                        if progress and progress:IsA("NumberValue") and progress.Value >= 100 then
                            continue
                        end
                        local color = ColorPresets[settings.GENERATORS_COLOR] or ColorPresets.Cyan
                        createHighlight(obj, color)
                    end
                end
            end
        end
        
        -- Предметы
        if settings.ITEMS_ESP then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Tool") and obj.Parent then
                    local color = ColorPresets[settings.ITEMS_COLOR] or ColorPresets.Gold
                    createHighlight(obj, color)
                end
            end
        end
    end
end)


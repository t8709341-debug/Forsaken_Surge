            part.CFrame = CFrame.new(position + Vector3.new(0, math.sin(t * 2) * 0.5, 0))
            part.Orientation = Vector3.new(0, t * 90, 0)
            task.wait()
        end
    end)
    return part
end

local function refreshBeacons()
    for _, b in ipairs(waypointBeacons) do pcall(function() b:Destroy() end) end
    waypointBeacons = {}
    for i, wp in ipairs(waypoints) do
        local hue = (i - 1) / math.max(MAX_WAYPOINTS, 1)
        table.insert(waypointBeacons, createBeacon(wp.Position, wp.Name, Color3.fromHSV(hue, 0.8, 1)))
    end
end

local function addWaypoint(name)
    if not hrp then updateCharacterReferences() if not hrp then return end end
    if #waypoints >= MAX_WAYPOINTS then showNotification("📍 Waypoint", "Максимум " .. MAX_WAYPOINTS .. "!") return end
    table.insert(waypoints, { Name = name or ("WP" .. (#waypoints + 1)), Position = hrp.Position })
    saveWaypoints() refreshBeacons()
    showNotification("📍 Waypoint", "Сохранён: " .. (name or ("WP" .. #waypoints)))
end

local function removeWaypoint(index)
    if waypoints[index] then
        table.remove(waypoints, index)
        saveWaypoints() refreshBeacons()
        showNotification("📍 Waypoint", "Удалён #" .. index)
    end
end

local function teleportToWaypoint(index)
    if not waypoints[index] then return end
    if not hrp then updateCharacterReferences() if not hrp then return end end
    local wp = waypoints[index]
    hrp.CFrame = CFrame.new(wp.Position + Vector3.new(0, 3, 0))
    hrp.AssemblyLinearVelocity = Vector3.zero
    showNotification("📍 Waypoint", "ТП → " .. wp.Name)
end

local function swapWithWaypoint(index)
    if not waypoints[index] then showNotification("🔁 Swap", "Точка #" .. index .. " не найдена") return end
    if not hrp then updateCharacterReferences() if not hrp then return end end
    local wp = waypoints[index]
    local myOldPos = hrp.Position
    hrp.CFrame = CFrame.new(wp.Position + Vector3.new(0, 3, 0))
    hrp.AssemblyLinearVelocity = Vector3.zero
    wp.Position = myOldPos
    saveWaypoints() refreshBeacons()
    showNotification("🔁 Swap", string.format("Обмен с %s", wp.Name))
end

local function swapWithPlayer(targetName)
    local target
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Name:lower():find(targetName:lower(), 1, true) then target = plr break end
    end
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        showNotification("🔁 Swap", "Игрок не найден") return
    end
    if not hrp then return end
    local targetRoot = target.Character.HumanoidRootPart
    local myOldPos = hrp.Position
    local theirOldPos = targetRoot.Position
    hrp.CFrame = CFrame.new(theirOldPos + Vector3.new(0, 3, 0))
    hrp.AssemblyLinearVelocity = Vector3.zero
    targetRoot.CFrame = CFrame.new(myOldPos + Vector3.new(0, 3, 0))
    targetRoot.AssemblyLinearVelocity = Vector3.zero
    showNotification("🔁 Swap", "Обмен с " .. target.Name)
end

local function teleportToPlayer(targetName)
    local target
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Name:lower():find(targetName:lower(), 1, true) then target = plr break end
    end
    if not target then showNotification("📍 TP", "Игрок не найден") return end
    if not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        showNotification("📍 TP", "У игрока нет персонажа") return
    end
    if not hrp then return end
    hrp.CFrame = CFrame.new(target.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0))
    hrp.AssemblyLinearVelocity = Vector3.zero
    showNotification("📍 TP", "ТП → " .. target.Name)
end


-- Создание/обновление Highlight
local function UpdateHighlight(ItemInstance, TargetRoot, Settings)
    Settings = type(Settings) == "table" and Settings or {
        MaxDistance = settings.ESP_MAX_DISTANCE,
        MinDistance = settings.ESP_MIN_DISTANCE,
        Color = Color3.new(1,1,1)
    }
    
    local entry = espTracked[ItemInstance]
    local Highlight = entry and entry.highlight
    
    if not Highlight or not Highlight.Parent then
        Highlight = Instance.new("Highlight")
        Highlight.Name = HttpService:GenerateGUID(false):sub(1,7)
        Highlight.Archivable = false
        Highlight:SetAttribute("Dynamic", true)
        Highlight.Parent = ItemInstance
        Highlight.Adornee = ItemInstance
        Highlight.DepthMode = Enum.HighlightDepthMode[settings.ESP_HIGHLIGHT_DEPTH_MODE] or Enum.HighlightDepthMode.AlwaysOnTop
        table.insert(espHighlights, Highlight)
        
        if not espTracked[ItemInstance] then espTracked[ItemInstance] = {} end
        espTracked[ItemInstance].highlight = Highlight
    end
    
    local baseFillTransparency = 1 - settings.ESP_FILL_TRANSPARENCY
    local baseOutlineTransparency = 1 - settings.ESP_OUTLINE_TRANSPARENCY
    
    local H, S, V = Settings.Color:ToHSV()
    Highlight.FillColor = Color3.fromHSV(H, S, V * 0.8)
    Highlight.OutlineColor = Color3.fromHSV(H, S, V * 1.1)
    
    if settings.ESP_RENDER_DISTANCE_FADE and TargetRoot and TargetRoot.Parent then
        local dist = (Camera.CFrame.Position - TargetRoot.Position).Magnitude
        local minD = Settings.MinDistance or settings.ESP_MIN_DISTANCE
        local maxD = Settings.MaxDistance or settings.ESP_MAX_DISTANCE
        local alpha = math.clamp(1 - math.clamp((dist - minD) / math.max(maxD - minD, 0.001), 0, 1), settings.ESP_FADE_MIN_ALPHA, 1)
        Highlight.FillTransparency = math.clamp(alpha + (1 - settings.ESP_FILL_TRANSPARENCY), 0, 1)
        Highlight.OutlineTransparency = math.clamp(alpha + (1 - settings.ESP_OUTLINE_TRANSPARENCY), 0, 1)
    else
        Highlight.FillTransparency = baseFillTransparency
        Highlight.OutlineTransparency = baseOutlineTransparency
    end
end

-- Создание/обновление текста
local function UpdateText(ItemInstance, TargetRoot, Settings)
    Settings = type(Settings) == "table" and Settings or {
        MinDistance = settings.ESP_TEXT_MIN_DISTANCE,
        Color = Color3.new(1,1,1),
        Text = "Unknown"
    }
    
    local entry = espTracked[ItemInstance]
    local BillboardGui = entry and entry.billboard
    
    if not BillboardGui or not BillboardGui.Parent then
        BillboardGui = Instance.new("BillboardGui")
        local TextLabel = Instance.new("TextLabel")
        
        BillboardGui.Name = HttpService:GenerateGUID(false):sub(1,7)
        BillboardGui.Archivable = false
        BillboardGui.Size = ItemInstance:IsA("Tool") and UDim2.new(1.5, 30, 0.75, 30) or UDim2.new(1.5,60,0.75,25)
        BillboardGui.StudsOffset = ItemInstance:IsA("Tool") and Vector3.new(0,3,0) or Vector3.new(0,4,0)
        BillboardGui.AlwaysOnTop = true
        BillboardGui.ResetOnSpawn = false
        BillboardGui.Adornee = TargetRoot
        BillboardGui:SetAttribute("Dynamic", true)
        table.insert(espBillboards, BillboardGui)
        
        TextLabel.AnchorPoint = Vector2.new(0.5, 0.5)
        TextLabel.Position = UDim2.fromScale(0.5, 0.5)
        TextLabel.Size = UDim2.fromScale(1, 1)
        TextLabel.BackgroundTransparency = 1
        TextLabel.TextScaled = true
        TextLabel.Font = Enum.Font.GothamBold
        TextLabel.TextStrokeTransparency = 0
        TextLabel.TextStrokeColor3 = Color3.new(0,0,0)
        TextLabel.Parent = BillboardGui
        
        BillboardGui.Parent = TargetRoot
        
        if not espTracked[ItemInstance] then espTracked[ItemInstance] = {} end
        espTracked[ItemInstance].billboard = BillboardGui
    end
    
    local TextLabel = BillboardGui:FindFirstChildOfClass("TextLabel")
    if TextLabel then
        local displayText = Settings.Text or "Unknown"
        if settings.ESP_SHOW_DISTANCE_TEXT and TargetRoot and TargetRoot.Parent then
            local dist = (Camera.CFrame.Position - TargetRoot.Position).Magnitude
            displayText = displayText .. " [" .. math.floor(dist) .. "m]"
        end
        TextLabel.Text = displayText
        TextLabel.TextSize = settings.ESP_TEXT_SIZE
        local H, S, V = Settings.Color:ToHSV()
        TextLabel.TextColor3 = Color3.fromHSV(H, S, V * 1.1)
        
        if TargetRoot and TargetRoot.Parent then
            local dist = (Camera.CFrame.Position - TargetRoot.Position).Magnitude
            local minD = Settings.MinDistance or settings.ESP_TEXT_MIN_DISTANCE
            local maxD = settings.ESP_TEXT_MAX_DISTANCE
            if dist > minD and dist < maxD then
                TextLabel.TextTransparency = 0
                TextLabel.TextStrokeTransparency = 0
            else
                TextLabel.TextTransparency = 1
                TextLabel.TextStrokeTransparency = 1
            end
        end
    end
end


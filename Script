local function isPlayerKiller(plr, char)
    if settings.KILLER_ALERT_DETECT_BY_TEAM then
        local team = plr.Team
        if team then
            local tn = team.Name:lower()
            if tn:find("killer") or tn:find("monster") or tn:find("enemy") or tn:find("hunter") then
                return true
            end
        end
    end
    if settings.KILLER_ALERT_DETECT_BY_HP and char then
        local hum = char:FindFirstChild("Humanoid")
        if hum and hum.MaxHealth >= settings.KILLER_ALERT_HP_THRESHOLD then
            return true
        end
    end
    return false
end

task.spawn(function()
    while true do
        task.wait(settings.ESP_UPDATE_INTERVAL)
        pcall(function()
            if not settings.ESP_ENABLED then clearAllESP(); return end
            local alive = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr == player then continue end
                local char = plr.Character
                if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                    local TargetRoot = char:FindFirstChild("HumanoidRootPart")
                    if TargetRoot then
                        local isKiller = isPlayerKiller(plr, char)
                        if isKiller and settings.KILLERS_ESP then
                            local color = getColorFromSettings("Killers")
                            UpdateHighlight(char, TargetRoot, {MaxDistance = settings.ESP_MAX_DISTANCE, MinDistance = settings.ESP_MIN_DISTANCE, Color = color})
                            if settings.SHOW_TEXT then UpdateText(char, TargetRoot, {MinDistance = settings.ESP_TEXT_MIN_DISTANCE, Text = plr.Name, Color = color}) end
                            if settings.ESP_BOX_ENABLED then UpdateBox(char, TargetRoot, {Color = getColorFromSettings("Box")}) end
                            if settings.ESP_TRACER_ENABLED then UpdateTracer(char, TargetRoot, {Color = getColorFromSettings("Tracer")}) end
                            alive[char] = true
                        elseif not isKiller and settings.SURVIVORS_ESP then
                            local color = getColorFromSettings("Survivors")
                            UpdateHighlight(char, TargetRoot, {MaxDistance = settings.ESP_MAX_DISTANCE, MinDistance = settings.ESP_MIN_DISTANCE, Color = color})
                            if settings.SHOW_TEXT then UpdateText(char, TargetRoot, {MinDistance = settings.ESP_TEXT_MIN_DISTANCE, Text = plr.Name, Color = color}) end
                            if settings.ESP_BOX_ENABLED then UpdateBox(char, TargetRoot, {Color = getColorFromSettings("Box")}) end
                            if settings.ESP_TRACER_ENABLED then UpdateTracer(char, TargetRoot, {Color = getColorFromSettings("Tracer")}) end
                            alive[char] = true
                        else
                            RemoveESP(char)
                        end
                    end
                end
            end
            if settings.GENERATORS_ESP then
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj.Parent then
                        local name = string.lower(obj.Name)
                        if string.find(name, "generator") or string.find(name, "gen") or obj:GetAttribute("Generator") then
                            local progress = obj:FindFirstChild("Progress")
                            if progress and progress.Value >= 100 then RemoveESP(obj)
                            else
                                local TargetRoot = obj:FindFirstChild("Main") or obj:FindFirstChild("HumanoidRootPart") or obj
                                local color = getColorFromSettings("Generators")
                                UpdateHighlight(obj, TargetRoot, {MaxDistance = settings.ESP_MAX_DISTANCE, MinDistance = settings.ESP_MIN_DISTANCE, Color = color})
                                if settings.SHOW_TEXT then UpdateText(obj, TargetRoot, {MinDistance = settings.ESP_TEXT_MIN_DISTANCE, Text = obj.Name, Color = color}) end
                                if settings.ESP_BOX_ENABLED then UpdateBox(obj, TargetRoot, {Color = getColorFromSettings("Box")}) end
                                alive[obj] = true
                            end
                        end
                    end
                end
            end
            if settings.ITEMS_ESP then
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Tool") and obj.Parent then
                        local TargetRoot = obj:FindFirstChildWhichIsA("BasePart") or obj
                        local color = getColorFromSettings("Items")
                        UpdateHighlight(obj, TargetRoot, {MaxDistance = settings.ESP_MAX_DISTANCE, MinDistance = settings.ESP_MIN_DISTANCE, Color = color})
                        if settings.SHOW_TEXT then UpdateText(obj, TargetRoot, {MinDistance = settings.ESP_TEXT_MIN_DISTANCE, Text = obj.Name, Color = color}) end
                        if settings.ESP_BOX_ENABLED then UpdateBox(obj, TargetRoot, {Color = getColorFromSettings("Box")}) end
                        alive[obj] = true
                    end
                end
            end
            for inst, _ in pairs(espTracked) do
                if not alive[inst] or not inst.Parent then RemoveESP(inst) end
            end
        end)
    end
end)


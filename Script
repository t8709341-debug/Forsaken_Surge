    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    local hit = Workspace:Raycast(ray.Origin, ray.Direction * settings.CLICK_TP_MAX, params)
    if hit then
        hrp.CFrame = CFrame.new(hit.Position + Vector3.new(0, 3, 0))
    else
        hrp.CFrame = CFrame.new(ray.Origin + ray.Direction * settings.CLICK_TP_MAX)
    end
    hrp.AssemblyLinearVelocity = Vector3.zero
end


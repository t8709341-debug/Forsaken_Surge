-- ANTI-KILLER AUTO TP
-- ==========================================
local antiKillerLastTP = 0

local function tryAntiKillerTP()
    if not settings.ANTIKILLER_TP_ENABLED then return false end
    if not hrp or not humanoid then return false end
    if tick() - antiKillerLastTP < settings.ANTIKILLER_TP_COOLDOWN then return false end

    local killers, survivors = collectRoleContainers()
    local closestKiller = nil
    local closestDist = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        local role = getPlayerRole(plr, killers, survivors)
        if role ~= "Killer" then continue end

        local char = plr.Character
        if not char then continue end
        local targetRoot = char:FindFirstChild("HumanoidRootPart")
        if not targetRoot then continue end

        local dist = (hrp.Position - targetRoot.Position).Magnitude
        if dist < closestDist then
            closestDist = dist
            closestKiller = plr
        end
    end

    if closestKiller and closestDist <= settings.ANTIKILLER_TP_DISTANCE then
        local wpIndex = settings.ANTIKILLER_TP_WAYPOINT_INDEX
        if waypoints[wpIndex] then
            antiKillerLastTP = tick()
            teleportToWaypoint(wpIndex)
            if settings.ANTIKILLER_TP_NOTIFY then
                showNotification("🚨 Anti-Killer", string.format("Убийца %s рядом (%.0f studs)! ТП → WP#%d", closestKiller.Name, closestDist, wpIndex))
            end
            return true
        elseif settings.ANTIKILLER_TP_NOTIFY then
            showNotification("🚨 Anti-Killer", "Убийца рядом, но WP#" .. wpIndex .. " не сохранён!")
        end
    end
    return false
end

task.spawn(function()
    while task.wait(0.15) do pcall(tryAntiKillerTP) end
end)


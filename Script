        end
    end)
    return part
end

local function refreshBeacons()
    for _, b in ipairs(waypointBeacons) do pcall(function() b:Destroy() end) end
    waypointBeacons = {}
    for i, wp in ipairs(waypoints) do
        local hue = (i - 1) / math.max(MAX_WAYPOINTS, 1)
        local color = Color3.fromHSV(hue, 0.8, 1)
        table.insert(waypointBeacons, createBeacon(wp.Position, wp.Name, color))
    end
end

local function addWaypoint(name)
    if not hrp then updateCharacterReferences() if not hrp then return end end
    if #waypoints >= MAX_WAYPOINTS then showNotification("📍 Waypoint","Максимум " .. MAX_WAYPOINTS .. " точек!") return end
    table.insert(waypoints, { Name = name or ("WP" .. (#waypoints + 1)), Position = hrp.Position })
    saveWaypoints(); refreshBeacons()
    showNotification("📍 Waypoint","Сохранён: " .. (name or ("WP" .. #waypoints)))
end

local function removeWaypoint(index)
    if waypoints[index] then
        table.remove(waypoints, index); saveWaypoints(); refreshBeacons()
        showNotification("📍 Waypoint","Удалён #" .. index)
    end
end

local function teleportToWaypoint(index)
    if not waypoints[index] then return end
    if not hrp then updateCharacterReferences() if not hrp then return end end
    local wp = waypoints[index]
    if settings.WP_SWAP_ENABLED then
        local oldPos = hrp.Position
        hrp.CFrame = CFrame.new(wp.Position + Vector3.new(0,3,0))
        hrp.AssemblyLinearVelocity = Vector3.zero
        waypoints[index].Position = oldPos
        saveWaypoints(); refreshBeacons()
        showNotification("🔁 Waypoint SWAP","ТП → " .. wp.Name)
        return
    end
    hrp.CFrame = CFrame.new(wp.Position + Vector3.new(0,3,0))
    hrp.AssemblyLinearVelocity = Vector3.zero
    showNotification("📍 Waypoint","ТП → " .. wp.Name)
end

local function teleportToPlayer(targetName)
    local target
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Name:lower():find(targetName:lower(), 1, true) then target = plr break end
    end
    if not target then showNotification("📍 TP","Игрок не найден: " .. targetName) return end
    local model = getWorkspaceModel(target)
    local root = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)
    if not root then showNotification("📍 TP","У игрока нет модели в workspace.Players") return end
    if not hrp then return end
    hrp.CFrame = CFrame.new(root.Position + Vector3.new(0,3,0))
    hrp.AssemblyLinearVelocity = Vector3.zero
    showNotification("📍 TP","ТП → " .. target.Name)
end

refreshBeacons()


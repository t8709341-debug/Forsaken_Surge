    if input.KeyCode == Enum.KeyCode.B then
        toggleNoClip()
    end
    
    if input.KeyCode == Enum.KeyCode.Z then
        toggleTurbo()
    end
    
    if input.KeyCode == Enum.KeyCode.LeftShift then
        isSprinting = true
    end
end)


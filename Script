-- 🏃 SPEED HACK (заменяет Turbo) — Anti-Detect
-- ==========================================
local speedTarget = 0
local speedCurrent = 0
local speedLastJitter = 0
local speedJitterSeed = tick()

local function toggleSpeedHack()
    if climbing or flying or noClipActive then disableAllModes("speed") end
    if not hrp or not humanoid then
        updateCharacterReferences()
        if not hrp or not humanoid then return end
    end
    speedHackActive = not speedHackActive
    if speedHackActive then
        disableAllModes("speed")
        speedJitterSeed = tick()
        speedLastJitter = 0
        speedCurrent = 0
        humanoid.AutoRotate = true
        humanoid.PlatformStand = false
        showNotification("🏃 Speed Hack", "Активирован (Anti-Detect)")
    else
        if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
        if humanoid then humanoid.WalkSpeed = 16 end
        showNotification("🏃 Speed Hack", "Деактивирован")
    end
end

task.spawn(function()
    while true do
        local dt = task.wait()
        if speedHackActive and hrp and humanoid then
            local cam = Camera.CFrame
            local look = Vector3.new(cam.LookVector.X, 0, cam.LookVector.Z)
            local right = Vector3.new(cam.RightVector.X, 0, cam.RightVector.Z)
            if look.Magnitude > 0.001 then look = look.Unit end
            if right.Magnitude > 0.001 then right = right.Unit end
            local move = Vector3.zero
            if pressed[Enum.KeyCode.W] then move = move + look end
            if pressed[Enum.KeyCode.S] then move = move - look end
            if pressed[Enum.KeyCode.A] then move = move - right end
            if pressed[Enum.KeyCode.D] then move = move + right end
            if move.Magnitude > 0 then move = move.Unit end

            local now = tick()
            if now - speedLastJitter > settings.SPEEDHACK_JITTER_INTERVAL then
                speedLastJitter = now
                speedJitterSeed = now
                local base = settings.SPEEDHACK_BASE
                local jit = (math.noise(now * 7.3, speedJitterSeed) or 0) * settings.SPEEDHACK_JITTER_PERCENT
                speedTarget = base * (1 + jit)
            end

            speedCurrent = speedCurrent + (speedTarget - speedCurrent) * math.min(1, dt * settings.SPEEDHACK_ACCEL)

            if move.Magnitude > 0.01 then
                hrp.AssemblyLinearVelocity = move * speedCurrent
                humanoid.WalkSpeed = math.min(settings.SPEEDHACK_HUMANOID_CAP, speedCurrent * 0.35)
            else
                -- Даём WalkSpeed осесть к норме когда стоим
                humanoid.WalkSpeed = humanoid.WalkSpeed + (16 - humanoid.WalkSpeed) * math.min(1, dt * 4)
                -- Гасим velocity когда стоим (чтобы не «улетал»)
                if not climbing and not flying then
                    local v = hrp.AssemblyLinearVelocity
                    hrp.AssemblyLinearVelocity = Vector3.new(v.X * 0.5, v.Y, v.Z * 0.5)
                end
            end
        end
    end
end)


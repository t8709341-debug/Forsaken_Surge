    macroRecording = true
    macroEvents = {}
    macroRecordStart = tick()
    showNotification("🎬 Macro", "Запись начата... нажми " .. settings.MACRO_RECORD_HOTKEY .. " для остановки")
end

local function stopMacroRecord(name)
    if not macroRecording then return end
    macroRecording = false
    local macroName = name or ("Macro_" .. os.date("%H%M%S"))
    if #macroEvents == 0 then
        showNotification("🎬 Macro", "Запись пуста, отменено")
        return
    end
    macros[macroName] = macroEvents
    saveMacros()
    showNotification("🎬 Macro", "Сохранён: " .. macroName .. " (" .. #macroEvents .. " событий)")
end

local function playMacro(name)
    if macroPlaying then return end
    local events = macros[name]
    if not events then
        showNotification("🎬 Macro", "Макрос не найден: " .. tostring(name))
        return
    end
    macroPlaying = true
    task.spawn(function()
        local startTime = tick()
        for _, ev in ipairs(events) do
            local elapsed = tick() - startTime
            local delay = ev.time - elapsed
            if delay > 0 then
                task.wait(delay)
            end
            if ev.type == "KeyDown" then
                pcall(function()
                    local keyCode = Enum.KeyCode[ev.key]
                    if keyCode then
                        UserInputService:SendKeyEvent(keyCode, true, false)
                    end
                end)
            elseif ev.type == "KeyUp" then
                pcall(function()
                    local keyCode = Enum.KeyCode[ev.key]
                    if keyCode then
                        UserInputService:SendKeyEvent(keyCode, false, false)
                    end
                end)
            elseif ev.type == "MouseButtonDown" then
                pcall(function()
                    local btn = Enum.UserInputType[ev.button]
                    if btn then
                        -- can't send mouse button directly via SendMouseEvent in all executors
                    end
                end)
            end
            task.wait()
        end
        macroPlaying = false
        showNotification("🎬 Macro", "Воспроизведение завершено: " .. name)
    end)
end


local function removeNoclipDetector()
    if character then
        local detector = character:FindFirstChild("NoclipDetector")
        if detector then
            detector:Destroy()
            return true
        end
    end
    return false
end

local function removeAllDetectors()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "NoclipDetector" and obj:IsA("BasePart") then
            obj:Destroy()
        end
    end
end

task.spawn(function()

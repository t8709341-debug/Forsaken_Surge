                    c00lguiFailReason = "failed"
                end
            end)
        end
    end
    
    -- Прогресс-бар
    if progressFill then
        TweenService:Create(progressFill, TweenInfo.new(settings.C00LGUI_WINDUP, Enum.EasingStyle.Linear), {Size = UDim2.fromScale(1, 1)}):Play()
    end
    
    -- Смена текста
    task.delay(2.3, function()
        if label and label.Parent and not c00lguiFailReason then
            label.Text = "h4xxing in pr0gr3ss...!!1!"
        end
        if centerText and centerText.Parent and not c00lguiFailReason then
            centerText.Text = "H4XXING IN PROGRESS...!!1!"
            centerText.TextColor3 = Color3.fromRGB(255, 200, 0)
        end
    end)
    
    -- Windup
    task.delay(settings.C00LGUI_WINDUP, function()
        if not c00lguiFailReason then
            c00lguiFailReason = "teleported"
        end
    end)
    
    -- Основной поток
    task.spawn(function()
        repeat
            task.wait()
        until c00lguiFailReason
        
        unblockMovement()
        humanoid.AutoRotate = originalAutoRotate
        
        if c00lguiFailReason == "teleported" then
            -- УСПЕХ
            if label and label.Parent then
                label.Text = "H4XX3D!!1!1"
                label.TextColor3 = Color3.fromRGB(0, 255, 100)
            end
            if centerText and centerText.Parent then
                centerText.Text = "H4XX3D!!1!1"
                centerText.TextColor3 = Color3.fromRGB(0, 255, 100)
            end
            
            playC00lguiSound(settings.C00LGUI_SOUND_SUCCESS, hrp)
            playGlitchEffect()
            
            -- ТЕЛЕПОРТ СКВОЗЬ СТЕНЫ
            if hrp and hrp.Parent then
                local originalCFrame = hrp.CFrame
                local target = findFarthestPointThroughWalls(settings.C00LGUI_RADIUS)
                
                if target then
                    applyTimeSlowdown()
                    applyScreenShake()
                    
                    hrp.CFrame = CFrame.new(target)
                    
                    task.wait(0.1)
                    if hrp and hrp.Parent and isInsideWall(hrp.Position) then
                        hrp.CFrame = originalCFrame
                        if centerText and centerText.Parent then
                            centerText.Text = "STUCK - REVERTING"
                            centerText.TextColor3 = Color3.fromRGB(255, 100, 0)
                        end
                    end
                end
            end
        else
            -- FAIL
            if label and label.Parent then
                label.Text = "o noes D:"
                label.TextColor3 = Color3.fromRGB(255, 50, 50)
            end
            if centerText and centerText.Parent then
                centerText.Text = "o noes D:"
                centerText.TextColor3 = Color3.fromRGB(255, 50, 50)
            end
            playC00lguiSound(settings.C00LGUI_SOUND_FAIL, hrp)
        end
        
        -- Отключение проверок
        if c00lguiHealthConn then c00lguiHealthConn:Disconnect(); c00lguiHealthConn = nil end
        if c00lguiAnchorConn then c00lguiAnchorConn:Disconnect(); c00lguiAnchorConn = nil end
        if c00lguiSlowConn then c00lguiSlowConn:Disconnect(); c00lguiSlowConn = nil end
        
        -- Затухание
        if bg then
            TweenService:Create(bg, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
        end
        if centerText then
            TweenService:Create(centerText, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
        end
        
        removeMotionBlur()
        removeChromaticAberration()
        
        task.wait(2)
        
        if c00lguiScreenGui and c00lguiScreenGui.Parent then
            c00lguiScreenGui:Destroy()
            c00lguiScreenGui = nil
        end
        if c00lguiGui and c00lguiGui.Parent then
            c00lguiGui:Destroy()
            c00lguiGui = nil
        end
        
        c00lguiActive = false
        c00lguiFailReason = nil
    end)
end

-- ==========================================
-- KEYBIND HANDLER
-- ==========================================
local keybindCallbacks = {}

local function registerKeybind(keyName, callback)
    if keyName and keyName ~= "None" then
        local keyCode = Enum.KeyCode[keyName]
        if keyCode then
            keybindCallbacks[keyCode] = callback
        end
    end
end

local function refreshKeybinds()
    keybindCallbacks = {}
    registerKeybind(settings.SPIN_HOTKEY, function()
        spinActive = not spinActive
        showNotification("🌀 Вращение", spinActive and "Включено" or "Выключено")
    end)
    registerKeybind(settings.C00LGUI_HOTKEY, function()
        activateC00lgui()
    end)
end

refreshKeybinds()

-- ==========================================
-- INPUT HANDLING
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = true
    
    if input.KeyCode == Enum.KeyCode.C then toggleClimb() end
    if input.KeyCode == Enum.KeyCode.V then toggleFly() end
    if input.KeyCode == Enum.KeyCode.B then toggleNoClip() end
    if input.KeyCode == Enum.KeyCode.Z then toggleTurbo() end
    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = true end
    
    local cb = keybindCallbacks[input.KeyCode]
    if cb then cb() end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = false
    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = false end
end)


local KILLER_KEYWORDS = {"killer", "monster", "enemy", "hunter", "slasher", "murderer", "kill"}
local SURVIVOR_KEYWORDS = {"survivor", "survivors", "runner", "human", "player", "survive"}

-- Все папки-контейнеры, где могут лежать персонажи по ролям
local ROLE_FOLDER_PATHS = {
    -- Стандартные варианты, где разработчики часто складывают персонажей
    {"Players"},
    {"Map", "Players"},
    {"Map", "Ingame", "Players"},
    {"Map", "Ingame", "Characters"},
    {"Characters"},
    {"Entities"},
    {"Map", "Entities"},
}

-- Найти папку по цепочке имён
local function findFolderByPath(pathParts)
    local current = Workspace
    for _, part in ipairs(pathParts) do
        if not current then return nil end
        current = current:FindFirstChild(part)
    end
    return current
end

-- Собираем все папки, где лежат роли. Делаем это регулярно (в цикле ESP).
local function collectRoleContainers()
    local killers = {}
    local survivors = {}
    local others = {}

    -- 1) Проходим по всем предопределённым путям, ищем папки Killers / Survivors
    for _, basePath in ipairs(ROLE_FOLDER_PATHS) do
        local base = findFolderByPath(basePath)
        if base then
            for _, child in ipairs(base:GetChildren()) do
                local lower = string.lower(child.Name)
                local isKillerFolder = false
                local isSurvivorFolder = false
                for _, kw in ipairs(KILLER_KEYWORDS) do
                    if string.find(lower, kw) then isKillerFolder = true break end
                end
                for _, kw in ipairs(SURVIVOR_KEYWORDS) do
                    if string.find(lower, kw) then isSurvivorFolder = true break end
                end

                if isKillerFolder then
                    for _, model in ipairs(child:GetChildren()) do
                        killers[model] = true
                    end
                elseif isSurvivorFolder then
                    for _, model in ipairs(child:GetChildren()) do
                        survivors[model] = true
                    end
                end
            end
        end
    end

    -- 2) Ищем в корне Workspace папки по ключевым словам
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Model") then
            local lower = string.lower(child.Name)
            local isKillerFolder = false
            local isSurvivorFolder = false
            for _, kw in ipairs(KILLER_KEYWORDS) do
                if string.find(lower, kw) then isKillerFolder = true break end
            end
            for _, kw in ipairs(SURVIVOR_KEYWORDS) do
                if string.find(lower, kw) then isSurvivorFolder = true break end
            end

            if isKillerFolder and not isSurvivorFolder then
                for _, model in ipairs(child:GetChildren()) do
                    killers[model] = true
                end
            elseif isSurvivorFolder and not isKillerFolder then
                for _, model in ipairs(child:GetChildren()) do
                    survivors[model] = true
                end
            end
        end
    end

    return killers, survivors
end

-- Найти игрока-владельца модели (если она является его Character)
local function getOwnerPlayer(model)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == model then
            return plr
        end
    end
    return nil
end

-- Определение роли игрока
-- Возвращает "Killer" | "Survivor" | "Unknown" | nil (если игрок не найден)
local function getPlayerRole(plr, killers, survivors)
    if not plr then return nil end

    -- 1) Через Team
    if plr.Team then
        local tn = string.lower(plr.Team.Name)
        for _, kw in ipairs(KILLER_KEYWORDS) do
            if string.find(tn, kw) then return "Killer" end
        end
        for _, kw in ipairs(SURVIVOR_KEYWORDS) do
            if string.find(tn, kw) then return "Survivor" end
        end
    end

    -- 2) Через атрибуты
    local attrRole = plr:GetAttribute("Role") or plr:GetAttribute("Team") or plr:GetAttribute("IsKiller")
    if attrRole == true then return "Killer" end
    if type(attrRole) == "string" then
        local low = string.lower(attrRole)
        for _, kw in ipairs(KILLER_KEYWORDS) do
            if string.find(low, kw) then return "Killer" end
        end
        for _, kw in ipairs(SURVIVOR_KEYWORDS) do
            if string.find(low, kw) then return "Survivor" end
        end
    end

    -- 3) Через папки Workspace (Killers / Survivors)
    local char = plr.Character
    if char then
        if killers[char] or (char.Parent and killers[char.Parent]) then return "Killer" end
        if survivors[char] or (char.Parent and survivors[char.Parent]) then return "Survivor" end
    end

    return "Unknown"
end


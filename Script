local espTracked = setmetatable({}, {__mode = "k"})

local function RemoveESP(inst)
    local e = espTracked[inst]
    if e then
        if e.highlight then pcall(function() e.highlight:Destroy() end) end
        if e.billboard then pcall(function() e.billboard:Destroy() end) end
        if e.box then pcall(function() e.box:Destroy() end) end
        if e.tracer then pcall(function() e.tracer:Destroy() end) end
        espTracked[inst] = nil
    end
end

local function clearAllESP()
    for inst, _ in pairs(espTracked) do RemoveESP(inst) end
    espTracked = setmetatable({}, {__mode = "k"})
end

local function updateHighlight(inst, root, color)
    local e = espTracked[inst]
    local hl = e and e.highlight
    if not hl or not hl.Parent then
        hl = Instance.new("Highlight")
        hl.Name = "FS_HL"
        hl.Archivable = false
        hl.Parent = inst
        hl.Adornee = inst:IsA("Tool") and (inst:FindFirstChildWhichIsA("BasePart") or inst) or inst
        hl.DepthMode = Enum.HighlightDepthMode[settings.ESP_HIGHLIGHT_DEPTH_MODE] or Enum.HighlightDepthMode.AlwaysOnTop
        if not espTracked[inst] then espTracked[inst] = {} end
        espTracked[inst].highlight = hl
    end
    local H, S, V = color:ToHSV()
    hl.FillColor = Color3.fromHSV(H, S, V * 0.8)
    hl.OutlineColor = Color3.fromHSV(H, S, V * 1.1)
    hl.FillTransparency = 1 - settings.ESP_FILL_TRANSPARENCY
    hl.OutlineTransparency = 1 - settings.ESP_OUTLINE_TRANSPARENCY
end

local function updateText(inst, root, text, color)
    local e = espTracked[inst]
    local bg = e and e.billboard
    if not bg or not bg.Parent then
        bg = Instance.new("BillboardGui")
        bg.Name = "FS_BG"
        bg.Size = UDim2.new(1.5, 60, 0.75, 25)
        bg.StudsOffset = Vector3.new(0, 4, 0)
        bg.AlwaysOnTop = true
        bg.ResetOnSpawn = false
        bg.Adornee = root
        local lbl = Instance.new("TextLabel")
        lbl.AnchorPoint = Vector2.new(0.5, 0.5)
        lbl.Position = UDim2.fromScale(0.5, 0.5)
        lbl.Size = UDim2.fromScale(1, 1)
        lbl.BackgroundTransparency = 1
        lbl.TextScaled = true
        lbl.Font = Enum.Font.GothamBold
        lbl.TextStrokeTransparency = 0
        lbl.TextStrokeColor3 = Color3.new(0,0,0)
        lbl.Parent = bg
        bg.Parent = root
        if not espTracked[inst] then espTracked[inst] = {} end
        espTracked[inst].billboard = bg
    end
    local lbl = bg:FindFirstChildOfClass("TextLabel")
    if lbl then
        lbl.Text = text
        lbl.TextSize = settings.ESP_TEXT_SIZE
        lbl.TextColor3 = color
        lbl.TextTransparency = 0
    end
end

local espCache = {killers = {}, survivors = {}, generators = {}, items = {}}

local function classify(inst)
    if not inst or not inst.Parent then return nil end
    if inst:IsA("Tool") then return "items" end
    if inst:IsA("Model") then
        local n = inst.Name:lower()
        if n:find("generator") or n:find("gen") or inst:GetAttribute("Generator") then return "generators" end
        if inst:FindFirstChildOfClass("Humanoid") then
            local plr = Players:GetPlayerFromCharacter(inst)
            if plr and plr ~= player then
                local team = plr.Team
                if settings.ESP_TEAM_CHECK and team then
                    local tn = team.Name:lower()
                    if tn:find("killer") or tn:find("monster") or tn:find("enemy") then return "killers" end
                end
                return "survivors"
            end
        end
    end
    return nil
end

local function refreshCache(inst)
    local cat = classify(inst)
    if not cat then return end
    local bucket = espCache[cat]
    for i = 1, #bucket do if bucket[i] == inst then return end end
    table.insert(bucket, inst)
end

local function removeCache(inst)
    for _, bucket in pairs(espCache) do
        for i = #bucket, 1, -1 do
            if bucket[i] == inst then table.remove(bucket, i) end
        end
    end
end

for _, inst in ipairs(Workspace:GetDescendants()) do refreshCache(inst) end
Workspace.DescendantAdded:Connect(function(inst) task.defer(refreshCache, inst) end)
Workspace.DescendantRemoving:Connect(function(inst) removeCache(inst) RemoveESP(inst) end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = true

    if input.KeyCode == Enum.KeyCode.C and isHotkeyAllowed("HOTKEY_WALLWALK_ENABLED") then toggleClimb() end
    if input.KeyCode == Enum.KeyCode.V and isHotkeyAllowed("HOTKEY_FLY_ENABLED") then toggleFly() end
    if input.KeyCode == Enum.KeyCode.B and isHotkeyAllowed("HOTKEY_NOCLIP_ENABLED") then toggleNoClip() end
    if input.KeyCode == Enum.KeyCode.Z and isHotkeyAllowed("HOTKEY_TURBO_ENABLED") then toggleTurbo() end
    if input.KeyCode == Enum.KeyCode.F and isHotkeyAllowed("HOTKEY_FULLBRIGHT_ENABLED") then toggleFullbright() end
    if input.KeyCode == Enum.KeyCode.G and isHotkeyAllowed("HOTKEY_FREECAM_ENABLED") then toggleFreecam() end
    if input.KeyCode == Enum.KeyCode.X and isHotkeyAllowed("HOTKEY_ANTIKILLER_ENABLED") then
        settings.ANTIKILLER_TP_ENABLED = not settings.ANTIKILLER_TP_ENABLED
        SaveSettings(settings)
        showNotification("🚨 Anti-Killer", settings.ANTIKILLER_TP_ENABLED and "Включён" or "Выключен")
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if clickTPActive and settings.HOTKEY_CLICKTP_ENABLED and not freecamActive then
            performClickTP()
        end
    end

    if isHotkeyAllowed("HOTKEY_WAYPOINTS_ENABLED") then
        if input.KeyCode == Enum.KeyCode.P then addWaypoint("WP" .. (#waypoints + 1)) end
        if input.KeyCode == Enum.KeyCode.L then removeWaypoint(#waypoints) end
        if input.KeyCode == Enum.KeyCode.T then teleportToWaypoint(1) end
    end

    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = true end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = false
    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = false end
end)


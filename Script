local function UpdateESPCache()
    local now = tick()
    if now - ESP.Cache.LastUpdate < 0.5 then return end
    
    ESP.Cache.Players = {}
    ESP.Cache.Generators = {}
    ESP.Cache.Items = {}
    
    -- Кэшируем игроков (только живых)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    local isKiller = false
                    local team = plr.Team
                    if team then
                        local teamName = team.Name:lower()
                        if teamName:find("killer") or teamName:find("monster") or teamName:find("enemy") then
                            isKiller = true
                        end
                    end
                    table.insert(ESP.Cache.Players, {
                        Player = plr,
                        Character = char,
                        Root = root,
                        IsKiller = isKiller,
                        Name = plr.Name
                    })
                end
            end
        end
    end
    
    -- Кэшируем генераторы
    if settings.GENERATORS_ESP then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj.Parent then
                local name = string.lower(obj.Name)
                if string.find(name, "generator") or string.find(name, "gen") or obj:GetAttribute("Generator") then
                    local progress = obj:FindFirstChild("Progress")
                    if progress and progress.Value < 100 then
                        local main = obj:FindFirstChild("Main") or obj:FindFirstChild("HumanoidRootPart") or obj
                        table.insert(ESP.Cache.Generators, {
                            Object = obj,
                            Main = main,
                            Name = obj.Name
                        })
                    end
                end
            end
        end
    end
    
    -- Кэшируем предметы
    if settings.ITEMS_ESP then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Tool") and obj.Parent then
                local main = obj:FindFirstChildWhichIsA("BasePart") or obj
                table.insert(ESP.Cache.Items, {
                    Object = obj,
                    Main = main,
                    Name = obj.Name
                })
            end
        end
    end
    
    ESP.Cache.LastUpdate = now
end


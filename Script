local chamsEnabled = settings.CHAMS_ENABLED
local chamsThroughWalls = settings.CHAMS_THROUGH_WALLS
local chamsColor = Color3.fromRGB(settings.CHAMS_COLOR_R, settings.CHAMS_COLOR_G, settings.CHAMS_COLOR_B)

local function applyChams(char)
    if not char or not char.Parent then return end
    local hl = chamsTracked[char]
    if hl and hl.Parent then
        hl.FillColor = chamsColor
        hl.OutlineColor = chamsColor
        hl.DepthMode = chamsThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
        return
    end
    hl = Instance.new("Highlight")
    hl.Name = "FS_Chams"
    hl.Adornee = char
    hl.Parent = char
    hl.FillColor = chamsColor
    hl.FillTransparency = 0
    hl.OutlineColor = chamsColor
    hl.OutlineTransparency = 0
    hl.DepthMode = chamsThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
    chamsTracked[char] = hl
end

local function clearChams()
    for char, hl in pairs(chamsTracked) do pcall(function() hl:Destroy() end) end
    chamsTracked = setmetatable({}, {__mode = "k"})
end

task.spawn(function()

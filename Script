local function getWorkspaceModel(plr)
    if not plr then return nil end
    local wsPlayers = getWorkspacePlayersFolder()
    if not wsPlayers then return nil end
    for _, folderName in ipairs({"Killers", "Survivors"}) do
        local folder = wsPlayers:FindFirstChild(folderName)
        if folder then
            local m = folder:FindFirstChild(plr.Name)
            if m and m:IsA("Model") then return m, folderName end
        end
    end
    return nil
end


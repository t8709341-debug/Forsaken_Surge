local MacroFolder = MyDataFolder .. "/Macros"
if not isfolder(MacroFolder) then makefolder(MacroFolder) end

local macros = {} -- {name = {events = {...}}}
local recordingMacro = false
local recordingMacroName = nil
local recordingEvents = {}
local playingMacro = false

local function getMacroPath(name)
    return MacroFolder .. "/" .. name .. ".json"
end

local function saveMacro(name)
    local data = macros[name] or { events = {} }
    pcall(function()
        writefile(getMacroPath(name), HttpService:JSONEncode(data))
    end)
end

local function loadAllMacros()
    pcall(function()
        for _, file in ipairs(listfiles(MacroFolder)) do
            local fname = file:match("([^/\\]+)%.json$")
            if fname then
                local ok, data = pcall(HttpService.JSONDecode, HttpService, readfile(file))
                if ok and type(data) == "table" then
                    macros[fname] = data
                end
            end
        end
    end)
end

loadAllMacros()

local function startRecording(name)
    if recordingMacro then return end
    recordingMacro = true
    recordingMacroName = name or ("Macro" .. os.time())
    recordingEvents = {}
    showNotification("🎬 Macro", "Запись: " .. recordingMacroName)
end

local function stopRecording()
    if not recordingMacro then return end
    recordingMacro = false
    macros[recordingMacroName] = { events = recordingEvents }
    saveMacro(recordingMacroName)
    showNotification("🎬 Macro", "Сохранено: " .. recordingMacroName .. " (" .. #recordingEvents .. " событий)")
    recordingMacroName = nil
    recordingEvents = {}
end

local function playMacro(name)
    if not macros[name] or playingMacro then return end
    playingMacro = true
    showNotification("▶️ Macro", "Воспроизведение: " .. name)
    task.spawn(function()
        for _, ev in ipairs(macros[name].events) do
            task.wait(ev.delay or 0.1)
            if ev.type == "keypress" then
                local kc = Enum.KeyCode[ev.key]
                if kc then
                    pcall(function()
                        local vim = game:GetService("VirtualInputManager")
                        vim:SendKeyEvent(true, kc, false, game)
                        task.wait(0.05)
                        vim:SendKeyEvent(false, kc, false, game)
                    end)
                end
            elseif ev.type == "tp" then
                if hrp then
                    hrp.CFrame = CFrame.new(Vector3.new(ev.pos[1], ev.pos[2], ev.pos[3]))
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end
            elseif ev.type == "wait" then
                task.wait(ev.delay or 0.1)
            elseif ev.type == "notify" then
                showNotification("🎬 Macro", ev.text or "")
            end
        end
        playingMacro = false
        showNotification("▶️ Macro", "Готово: " .. name)
    end)
end

local function deleteMacro(name)
    macros[name] = nil
    pcall(function() delfile(getMacroPath(name)) end)
    showNotification("🎬 Macro", "Удалено: " .. name)
end


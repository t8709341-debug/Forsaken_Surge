local function getAimbotKey()
    local keyMap = {
        E = Enum.KeyCode.E,
        Q = Enum.KeyCode.Q,
        R = Enum.KeyCode.R,
        X = Enum.KeyCode.X,
        MouseButton2 = Enum.UserInputType.MouseButton2,
    }
    return keyMap[settings.AIMBOT_KEY] or Enum.KeyCode.E
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = true

    if input.KeyCode == Enum.KeyCode.C and isHotkeyAllowed("HOTKEY_WALLWALK_ENABLED") then
        toggleClimb()
    end

    if input.KeyCode == Enum.KeyCode.V and isHotkeyAllowed("HOTKEY_FLY_ENABLED") then
        toggleFly()
    end

    if input.KeyCode == Enum.KeyCode.B and isHotkeyAllowed("HOTKEY_NOCLIP_ENABLED") then
        toggleNoClip()
    end

    if input.KeyCode == Enum.KeyCode.Z and isHotkeyAllowed("HOTKEY_TURBO_ENABLED") then
        toggleTurbo()
    end

    if input.KeyCode == Enum.KeyCode.F and isHotkeyAllowed("HOTKEY_FULLBRIGHT_ENABLED") then
        toggleFullbright()
    end

    if input.KeyCode == Enum.KeyCode.G and isHotkeyAllowed("HOTKEY_FREECAM_ENABLED") then
        toggleFreecam()
    end

    -- 🎯 AIMBOT активация
    if settings.HOTKEY_AIMBOT_ENABLED and settings.AIMBOT_ENABLED then
        local targetKey = getAimbotKey()
        if input.KeyCode == targetKey or input.UserInputType == targetKey then
            if settings.AIMBOT_TOGGLE_MODE then
                aimbotActive = not aimbotActive
                showNotification("🎯 Aimbot", aimbotActive and "Активен (toggle)" or "Неактивен")
            else
                aimbotHolding = true
            end
        end
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if clickTPActive and settings.HOTKEY_CLICKTP_ENABLED and not freecamActive then
            performClickTP()
        end
    end

    if isHotkeyAllowed("HOTKEY_WAYPOINTS_ENABLED") then
        if input.KeyCode == Enum.KeyCode.P then addWaypoint("WP" .. (#waypoints + 1)) end
        if input.KeyCode == Enum.KeyCode.L then removeWaypoint(#waypoints) end
        if input.KeyCode == Enum.KeyCode.T then teleportToWaypoint(1) end
    end

    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = true end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = false
    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = false end

    if settings.HOTKEY_AIMBOT_ENABLED and not settings.AIMBOT_TOGGLE_MODE then
        local targetKey = getAimbotKey()
        if input.KeyCode == targetKey or input.UserInputType == targetKey then
            aimbotHolding = false
        end
    end
end)


local function isInsideWall(position)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.RespectCanCollide = true
    
    local checkPoints = {
        Vector3.new(0, 0, 0),
        Vector3.new(1, 0, 0),
        Vector3.new(-1, 0, 0),
        Vector3.new(0, 1, 0),
        Vector3.new(0, -1, 0),
        Vector3.new(0, 0, 1),
        Vector3.new(0, 0, -1),
    }
    
    local hits = 0
    for _, offset in ipairs(checkPoints) do
        local result = Workspace:Raycast(position, offset * 2, params)
        if result then hits = hits + 1 end
    end
    
    return hits >= 3
end

local function findFarthestPointThroughWalls(radius)
    if not hrp then return nil end
    
    local origin = hrp.Position
    local bestPoint = nil
    local bestDist = 0
    
    -- Сканируем 24 направления вокруг игрока (сквозь стены)
    for i = 0, 360, 15 do
        local angle = math.rad(i)
        local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
        
        -- Пробуем разные высоты
        for _, heightOffset in ipairs({0, 5, 10, -3}) do
            local target = origin + dir * radius + Vector3.new(0, heightOffset, 0)
            
            if not isInsideWall(target) then
                local groundCheck = Workspace:Raycast(
                    target + Vector3.new(0, 3, 0),
                    Vector3.new(0, -30, 0),
                    rayParams
                )
                
                if groundCheck then
                    local finalPos = groundCheck.Position + Vector3.new(0, 3.5, 0)
                    local dist = (finalPos - origin).Magnitude
                    
                    if dist > bestDist then
                        bestDist = dist
                        bestPoint = finalPos
                    end
                end
            end
        end
    end
    
    -- Fallback: телепорт вперёд на радиус
    if not bestPoint then
        local lookDir = hrp.CFrame.LookVector
        lookDir = Vector3.new(lookDir.X, 0, lookDir.Z).Unit
        bestPoint = origin + lookDir * radius + Vector3.new(0, 3, 0)
    end
    
    return bestPoint
end


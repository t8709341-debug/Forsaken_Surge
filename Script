            local ok, kc = pcall(function() return Enum.KeyCode[txt:upper()] end)
            if ok and kc then
                setKeybind(id, kc)
            else
                showNotification("⌨️ Keybind", "Неверная клавиша: " .. txt)
            end
        end
    })
    KeybindsTab:CreateButton({
        Name = "🔄 Сбросить " .. data.label .. " → " .. data.default,
        Callback = function()
            local ok, kc = pcall(function() return Enum.KeyCode[data.default] end)
            if ok and kc then setKeybind(id, kc) end
        end
    })
end


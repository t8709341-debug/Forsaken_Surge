-- ==========================================
-- AUTO GENERATOR SYSTEM
-- ==========================================

local IsFixingGenerator = false
local generatorCache = {}
local lastGeneratorScan = 0

local function getGenerators()
    local now = tick()
    if now - lastGeneratorScan < 2 then
        return generatorCache
    end
    lastGeneratorScan = now
    generatorCache = {}
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Parent then
            local name = string.lower(obj.Name)
            if string.find(name, "generator") or string.find(name, "gen") or obj:GetAttribute("Generator") then
                local main = obj:FindFirstChild("Main") or obj:FindFirstChild("HumanoidRootPart")
                if main and main:IsA("BasePart") then
                    local progress = obj:FindFirstChild("Progress")
                    if progress and progress:IsA("NumberValue") and progress.Value < 100 then
                        local remotes = obj:FindFirstChild("Remotes")
                        if remotes then
                            local remoteEvent = remotes:FindFirstChildOfClass("RemoteEvent")
                            if remoteEvent then
                                table.insert(generatorCache, {
                                    Object = obj,
                                    Main = main,
                                    Progress = progress,
                                    RemoteEvent = remoteEvent
                                })
                            end
                        end
                    end
                end
            end
        end
    end
    return generatorCache
end

local function IsPlayersNear(Distance)
    if character and hrp then
        for _, v in ipairs(Players:GetPlayers()) do
            if v ~= player and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                local otherHrp = v.Character.HumanoidRootPart
                if (otherHrp.Position - hrp.Position).Magnitude < Distance then
                    return true
                end
            end
        end
    end
    return false
end

task.spawn(function()
    while true do
        task.wait(0.2)
        
        if not settings.AUTO_GENERATOR then
            IsFixingGenerator = false
            continue
        end
        
        if not character or not hrp or not humanoid then
            updateCharacterReferences()
            if not character or not hrp then
                continue
            end
        end
        
        if IsFixingGenerator then
            continue
        end
        
        local generators = getGenerators()
        
        for _, genInfo in ipairs(generators) do
            local main = genInfo.Main
            if main and main.Parent then
                local distance = (main.Position - hrp.Position).Magnitude
                
                if distance < 6.7 then
                    IsFixingGenerator = true
                    
                    task.spawn(function()
                        local remoteEvent = genInfo.RemoteEvent
                        local progress = genInfo.Progress
                        
                        if not remoteEvent or not progress then
                            IsFixingGenerator = false
                            return
                        end
                        
                        local genCooldown = settings.GENERATOR_COOLDOWN
                        local speedUp = settings.SPEED_UP_COOLDOWN
                        
                        while IsFixingGenerator and settings.AUTO_GENERATOR and progress.Parent and progress.Value < 100 do
                            if not character or not character.Parent then
                                IsFixingGenerator = false
                                break
                            end
                            
                            local currentDistance = (main.Position - hrp.Position).Magnitude
                            if currentDistance > 7 then
                                IsFixingGenerator = false
                                break
                            end
                            
                            local isNear = IsPlayersNear(32)
                            
                            local cooldown = genCooldown
                            if speedUp and not isNear and genCooldown > 2 then
                                cooldown = 1.5
                            end
                            
                            local delay = RNG:NextNumber(cooldown - 0.1 * cooldown, cooldown + 0.1 * cooldown)
                            task.wait(math.max(delay, 0.2))
                            
                            if not IsFixingGenerator or not settings.AUTO_GENERATOR or not progress.Parent then
                                break
                            end
                            
                            pcall(function()
                                remoteEvent:FireServer()
                            end)
                        end
                        
                        IsFixingGenerator = false
                    end)
                    
                    break
                end
            end
        end
    end
end)


local function RemoveESP(ItemInstance)
    local entry = espTracked[ItemInstance]
    if entry then
        if entry.highlight then pcall(function() entry.highlight:Destroy() end) end
        if entry.billboard then pcall(function() entry.billboard:Destroy() end) end
        if entry.box then pcall(function() entry.box:Destroy() end) end
        if entry.tracer then pcall(function() entry.tracer:Destroy() end) end
        espTracked[ItemInstance] = nil
    end
end

task.spawn(function()
    while true do
        task.wait(settings.ESP_UPDATE_INTERVAL)
        pcall(function()
            if not settings.ESP_ENABLED then
                clearAllESP()
                return
            end

            local alive = {}

            -- Player ESP
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr == player then continue end
                local char = plr.Character
                if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                    local TargetRoot = char:FindFirstChild("HumanoidRootPart")
                    if TargetRoot then
                        local isKiller = false
                        local team = plr.Team
                        if settings.ESP_TEAM_CHECK and team then
                            local teamName = team.Name:lower()
                            if teamName:find("killer") or teamName:find("monster") or teamName:find("enemy") then
                                isKiller = true
                            end
                        end

                        if isKiller and settings.KILLERS_ESP then
                            local color = getColorFromSettings("Killers")
                            UpdateHighlight(char, TargetRoot, {MaxDistance = settings.ESP_MAX_DISTANCE, MinDistance = settings.ESP_MIN_DISTANCE, Color = color})
                            if settings.SHOW_TEXT then
                                UpdateText(char, TargetRoot, {MinDistance = settings.ESP_TEXT_MIN_DISTANCE, Text = plr.Name, Color = color})
                            end
                            if settings.ESP_BOX_ENABLED then
                                UpdateBox(char, TargetRoot, {Color = getColorFromSettings("Box")})
                            end
                            if settings.ESP_TRACER_ENABLED then
                                UpdateTracer(char, TargetRoot, {Color = getColorFromSettings("Tracer")})
                            end
                            alive[char] = true
                        elseif not isKiller and settings.SURVIVORS_ESP then
                            local color = getColorFromSettings("Survivors")
                            UpdateHighlight(char, TargetRoot, {MaxDistance = settings.ESP_MAX_DISTANCE, MinDistance = settings.ESP_MIN_DISTANCE, Color = color})
                            if settings.SHOW_TEXT then
                                UpdateText(char, TargetRoot, {MinDistance = settings.ESP_TEXT_MIN_DISTANCE, Text = plr.Name, Color = color})
                            end
                            if settings.ESP_BOX_ENABLED then
                                UpdateBox(char, TargetRoot, {Color = getColorFromSettings("Box")})
                            end
                            if settings.ESP_TRACER_ENABLED then
                                UpdateTracer(char, TargetRoot, {Color = getColorFromSettings("Tracer")})
                            end
                            alive[char] = true
                        else
                            RemoveESP(char)
                        end
                    end
                end
            end

            -- Generators ESP
            if settings.GENERATORS_ESP then
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj.Parent then
                        local name = string.lower(obj.Name)
                        if string.find(name, "generator") or string.find(name, "gen") or obj:GetAttribute("Generator") then
                            local progress = obj:FindFirstChild("Progress")
                            if progress and progress.Value >= 100 then
                                RemoveESP(obj)
                            else
                                local TargetRoot = obj:FindFirstChild("Main") or obj:FindFirstChild("HumanoidRootPart") or obj
                                local color = getColorFromSettings("Generators")
                                UpdateHighlight(obj, TargetRoot, {MaxDistance = settings.ESP_MAX_DISTANCE, MinDistance = settings.ESP_MIN_DISTANCE, Color = color})
                                if settings.SHOW_TEXT then
                                    UpdateText(obj, TargetRoot, {MinDistance = settings.ESP_TEXT_MIN_DISTANCE, Text = obj.Name, Color = color})
                                end
                                if settings.ESP_BOX_ENABLED then
                                    UpdateBox(obj, TargetRoot, {Color = getColorFromSettings("Box")})
                                end
                                alive[obj] = true
                            end
                        end
                    end
                end
            end

            -- Items ESP
            if settings.ITEMS_ESP then
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Tool") and obj.Parent then
                        local TargetRoot = obj:FindFirstChildWhichIsA("BasePart") or obj
                        local color = getColorFromSettings("Items")
                        UpdateHighlight(obj, TargetRoot, {MaxDistance = settings.ESP_MAX_DISTANCE, MinDistance = settings.ESP_MIN_DISTANCE, Color = color})
                        if settings.SHOW_TEXT then
                            UpdateText(obj, TargetRoot, {MinDistance = settings.ESP_TEXT_MIN_DISTANCE, Text = obj.Name, Color = color})
                        end
                        if settings.ESP_BOX_ENABLED then
                            UpdateBox(obj, TargetRoot, {Color = getColorFromSettings("Box")})
                        end
                        alive[obj] = true
                    end
                end
            end

            for inst, _ in pairs(espTracked) do
                if not alive[inst] or not inst.Parent then
                    RemoveESP(inst)
                end
            end
        end)
    end
end)


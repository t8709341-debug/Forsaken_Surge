local function getPlayerRole(plr)
    if not plr or not plr.Team then return "Unknown" end
    local teamName = plr.Team.Name:lower()
    if teamName:find("killer") or teamName:find("monster") or teamName:find("enemy") then
        return "Killer"
    end
    return "Survivor"
end

-- Быстрая проверка hitbox
local function getHitboxFast(target, hitboxName)
    local char = target:IsA("Player") and target.Character or target
    if not char then return nil end
    if hitboxName == "Head" then
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    elseif hitboxName == "Torso" then
        return char:FindFirstChild("Torso")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("LowerTorso")
            or char:FindFirstChild("HumanoidRootPart")
    end
    return char:FindFirstChild("HumanoidRootPart")
end

-- Проверка видимости (только для одной цели, вызывается редко)
local function isVisible(targetPart)
    if not settings.AIMBOT_WALL_CHECK then return true end
    if not targetPart then return false end

    local origin = Camera.CFrame.Position
    local dir = targetPart.Position - origin

    aimbotRayFilter.FilterDescendantsInstances = { character }

    local result = Workspace:Raycast(origin, dir, aimbotRayFilter)
    if result then
        if result.Instance and targetPart.Parent and result.Instance:IsDescendantOf(targetPart.Parent) then
            return true
        end
        return false
    end
    return true
end

-- 🚀 ОПТИМИЗИРОВАННЫЙ поиск кандидатов (вызывается не чаще, чем SCAN_INTERVAL)
local function scanCandidates()
    local candidates = {}
    local mode = settings.AIMBOT_MODE
    local myPos = Camera.CFrame.Position

    -- Игроки (PVP)
    if settings.AIMBOT_TARGET_PLAYERS and (mode == "PVP" or mode == "Both") then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local char = plr.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if hum and root and (not settings.AIMBOT_IGNORE_DEAD or hum.Health > 0) then
                        local dist = (root.Position - myPos).Magnitude
                        if dist <= settings.AIMBOT_MAX_DISTANCE and dist >= settings.AIMBOT_MIN_DISTANCE then
                            -- Team check
                            local skip = false
                            if settings.AIMBOT_TEAM_CHECK and plr.Team and plr.Team == player.Team then
                                skip = true
                            end
                            if not skip then
                                local role = getPlayerRole(plr)
                                if (role == "Killer" and settings.AIMBOT_TARGET_KILLERS)
                                    or (role ~= "Killer" and settings.AIMBOT_TARGET_SURVIVORS)
                                    or role == "Unknown" then
                                    table.insert(candidates, {
                                        target = plr,
                                        root = root,
                                        char = char,
                                        dist = dist,
                                        health = hum.Health,
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- NPC (PVE) — используем GetPartBoundsInRadius для эффективности
    if settings.AIMBOT_TARGET_NPCS and (mode == "PVE" or mode == "Both") then
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { character }
        params.MaxParts = 200

        local parts = Workspace:GetPartBoundsInRadius(myPos, settings.AIMBOT_PVE_RADIUS, params)

        local seenModels = {}
        local npcCount = 0

        for _, part in ipairs(parts) do
            if npcCount >= settings.AIMBOT_MAX_NPC_CANDIDATES then break end

            local model = part:FindFirstAncestorOfClass("Model")
            if model and not seenModels[model] then
                seenModels[model] = true

                -- Пропускаем персонажей игроков
                local isPlayerChar = false
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr.Character == model then
                        isPlayerChar = true
                        break
                    end
                end

                if not isPlayerChar then
                    local hum = model:FindFirstChildOfClass("Humanoid")
                    local root = model:FindFirstChild("HumanoidRootPart")
                    if hum and root and (not settings.AIMBOT_IGNORE_DEAD or hum.Health > 0) then
                        local dist = (root.Position - myPos).Magnitude
                        if dist <= settings.AIMBOT_MAX_DISTANCE and dist >= settings.AIMBOT_MIN_DISTANCE then
                            npcCount = npcCount + 1
                            table.insert(candidates, {
                                target = model,
                                root = root,
                                char = model,
                                dist = dist,
                                health = hum.Health,
                            })
                        end
                    end
                end
            end
        end
    end

    return candidates
end

-- Выбор лучшей цели из кандидатов (без raycast)
local function pickBestTarget(candidates)
    if #candidates == 0 then return nil end

    local mouse = player:GetMouse()
    local mousePos = Vector2.new(mouse.X, mouse.Y)
    local myPos = Camera.CFrame.Position

    local valid = {}
    for _, c in ipairs(candidates) do
        local part = getHitboxFast(c.target, settings.AIMBOT_HITBOX)
        if part then
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local screenVec = Vector2.new(screenPos.X, screenPos.Y)
                local distToMouse = (screenVec - mousePos).Magnitude

                if not settings.AIMBOT_FOV_ENABLED or distToMouse <= settings.AIMBOT_FOV then
                    table.insert(valid, {
                        target = c.target,
                        part = part,
                        dist = c.dist,
                        screenDist = distToMouse,
                        health = c.health,
                    })
                end
            end
        end
    end

    if #valid == 0 then return nil end

    local mode = settings.AIMBOT_LOCK_MODE
    if mode == "Closest" then
        table.sort(valid, function(a, b) return a.dist < b.dist end)
    elseif mode == "NearestCenter" then
        table.sort(valid, function(a, b) return a.screenDist < b.screenDist end)
    elseif mode == "LowestHealth" then
        table.sort(valid, function(a, b) return a.health < b.health end)
    elseif mode == "HighestHealth" then
        table.sort(valid, function(a, b) return a.health > b.health end)
    end

    return valid[1]
end

local function getAimPosition(targetPart)
    if not targetPart then return nil end
    local pos = targetPart.Position + Vector3.new(0, settings.AIMBOT_HITBOX_OFFSET_Y, 0)

    if settings.AIMBOT_PREDICTION then
        local vel = targetPart.AssemblyLinearVelocity
        if vel.Magnitude > 0.1 then
            pos = pos + Vector3.new(
                vel.X * settings.AIMBOT_PREDICTION_X,
                vel.Y * settings.AIMBOT_PREDICTION_Y,
                vel.Z * settings.AIMBOT_PREDICTION_Z
            )
        end
    end
    return pos
end

-- Кэш цвета FOV (обновляем только когда меняется)
local lastFovColor = Color3.new()
local lastFovSize = 0

-- 🚀 ОСНОВНОЙ ЦИКЛ AIMBOT (RenderStepped) — максимально лёгкий
RunService.RenderStepped:Connect(function(dt)
    -- Ранний выход, если аимбот выключен
    if not settings.AIMBOT_ENABLED then
        if fovCircle and fovCircle.circle and fovCircle.circle.Visible then
            fovCircle.circle.Visible = false
        end
        if targetIndicator and targetIndicator.dot and targetIndicator.dot.Visible then
            targetIndicator.dot.Visible = false
        end
        return
    end

    -- Обновляем FOV круг ТОЛЬКО если значения изменились
    if fovCircle and fovCircle.circle then
        if not fovCircle.circle.Visible then
            fovCircle.circle.Visible = settings.AIMBOT_SHOW_FOV
        end
        local newSize = settings.AIMBOT_FOV * 2
        if newSize ~= lastFovSize then
            fovCircle.circle.Size = UDim2.fromOffset(newSize, newSize)
            lastFovSize = newSize
        end
        local newColor = Color3.fromRGB(
            settings.AIMBOT_FOV_COLOR_R,
            settings.AIMBOT_FOV_COLOR_G,
            settings.AIMBOT_FOV_COLOR_B
        )
        if newColor ~= lastFovColor then
            fovCircle.stroke.Color = newColor
            lastFovColor = newColor
        end
    end

    -- Проверка активации
    local shouldAim = settings.AIMBOT_TOGGLE_MODE and aimbotActive or (not settings.AIMBOT_TOGGLE_MODE and aimbotHolding)
    if not shouldAim then
        if targetIndicator and targetIndicator.dot and targetIndicator.dot.Visible then
            targetIndicator.dot.Visible = false
        end
        return
    end

    -- 🚀 Сканирование целей раз в SCAN_INTERVAL (не каждый кадр!)
    local now = tick()
    if now - aimbotLastScan >= settings.AIMBOT_SCAN_INTERVAL then
        aimbotLastScan = now
        aimbotCachedCandidates = scanCandidates()
    end

    -- Выбор цели из кэша
    local best = pickBestTarget(aimbotCachedCandidates)
    if not best then
        aimbotTarget = nil
        aimbotTargetPart = nil
        if targetIndicator and targetIndicator.dot and targetIndicator.dot.Visible then
            targetIndicator.dot.Visible = false
        end
        return
    end

    -- 🚀 Wall-check ТОЛЬКО для выбранной цели (1 raycast на кадр, а не N)
    if settings.AIMBOT_WALL_CHECK and not isVisible(best.part) then
        aimbotTarget = nil
        aimbotTargetPart = nil
        if targetIndicator and targetIndicator.dot and targetIndicator.dot.Visible then
            targetIndicator.dot.Visible = false
        end
        return
    end

    aimbotTarget = best.target
    aimbotTargetPart = best.part

    -- Индикатор цели
    if targetIndicator and targetIndicator.dot then
        local screenPos, onScreen = Camera:WorldToViewportPoint(best.part.Position)
        if onScreen and settings.AIMBOT_SHOW_TARGET then
            targetIndicator.dot.Visible = true
            targetIndicator.dot.Position = UDim2.fromOffset(screenPos.X, screenPos.Y)
            targetIndicator.dot.BackgroundColor3 = Color3.fromRGB(
                settings.AIMBOT_TARGET_COLOR_R,
                settings.AIMBOT_TARGET_COLOR_G,
                settings.AIMBOT_TARGET_COLOR_B
            )
        elseif targetIndicator.dot.Visible then
            targetIndicator.dot.Visible = false
        end
    end

    -- Наведение
    local aimPos = getAimPosition(best.part)
    if aimPos then
        local currentCF = Camera.CFrame
        local targetCF = CFrame.lookAt(currentCF.Position, aimPos)
        local smooth = math.clamp(settings.AIMBOT_SMOOTHNESS, 0, 0.99)
        Camera.CFrame = currentCF:Lerp(targetCF, 1 - smooth)
    end

    -- Auto-shoot throttled
    if settings.AIMBOT_AUTO_SHOOT then
        if now - lastAutoShoot >= settings.AIMBOT_AUTO_SHOOT_DELAY then
            if not settings.AIMBOT_AUTO_SHOOT_ONLY_VISIBLE or isVisible(best.part) then
                lastAutoShoot = now
                pcall(function()
                    local tool = character and character:FindFirstChildOfClass("Tool")
                    if tool then
                        tool:Activate()
                    else
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                        task.wait(0.03)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                    end
                end)
            end
        end
    end
end)


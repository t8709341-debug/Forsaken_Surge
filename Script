local function clearAllESP()
    for _, hl in ipairs(espHighlights) do pcall(function() hl:Destroy() end) end
    espHighlights = {}
    for _, bg in ipairs(espBillboards) do pcall(function() bg:Destroy() end) end
    espBillboards = {}

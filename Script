local espCache = {
    killers = {},
    survivors = {},
    generators = {},
    items = {}
}

local function classifyInstance(inst)
    if not inst or not inst.Parent then return nil end
    if inst:IsA("Tool") then return "items" end
    if inst:IsA("Model") then
        local n = inst.Name:lower()
        if n:find("generator") or n:find("gen") or inst:GetAttribute("Generator") then
            return "generators"
        end
        if inst:FindFirstChildOfClass("Humanoid") then
            local plr = Players:GetPlayerFromCharacter(inst)
            if plr and plr ~= player then
                local team = plr.Team
                if settings.ESP_TEAM_CHECK and team then
                    local tn = team.Name:lower()
                    if tn:find("killer") or tn:find("monster") or tn:find("enemy") then
                        return "killers"
                    end
                end
                return "survivors"
            end
        end
    end
    return nil
end

local function refreshCacheFor(inst)
    local cat = classifyInstance(inst)
    if not cat then return end
    local bucket = espCache[cat]
    for i = 1, #bucket do
        if bucket[i] == inst then return end
    end
    table.insert(bucket, inst)
end

local function removeFromCache(inst)
    for _, bucket in pairs(espCache) do
        for i = #bucket, 1, -1 do
            if bucket[i] == inst then
                table.remove(bucket, i)
            end
        end
    end
end

for _, inst in ipairs(Workspace:GetDescendants()) do
    refreshCacheFor(inst)
end

Workspace.DescendantAdded:Connect(function(inst)
    task.defer(refreshCacheFor, inst)
end)

Workspace.DescendantRemoving:Connect(function(inst)
    removeFromCache(inst)
    RemoveESP(inst)
end)

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function(char)
        task.wait(0.3)
        refreshCacheFor(char)
    end)
end)

Players.PlayerRemoving:Connect(function(plr)
    if plr.Character then
        removeFromCache(plr.Character)
        RemoveESP(plr.Character)
    end
end)

task.spawn(function()
    while true do
        task.wait(settings.ESP_UPDATE_INTERVAL)
        pcall(function()
            if not settings.ESP_ENABLED then
                clearAllESP()
                return
            end
            local alive = {}

            if settings.KILLERS_ESP then
                for i = #espCache.killers, 1, -1 do
                    local char = espCache.killers[i]
                    if not char.Parent or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
                        table.remove(espCache.killers, i)
                        RemoveESP(char)
                    else
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then
                            local plr = Players:GetPlayerFromCharacter(char)
                            local color = getColorFromSettings("Killers")
                            UpdateHighlight(char, root, {MaxDistance = settings.ESP_MAX_DISTANCE, MinDistance = settings.ESP_MIN_DISTANCE, Color = color})
                            if settings.SHOW_TEXT then
                                UpdateText(char, root, {MinDistance = settings.ESP_TEXT_MIN_DISTANCE, Text = plr and plr.Name or char.Name, Color = color})
                            end
                            if settings.ESP_BOX_ENABLED then
                                UpdateBox(char, root, {Color = getColorFromSettings("Box")})
                            end
                            if settings.ESP_TRACER_ENABLED then
                                UpdateTracer(char, root, {Color = getColorFromSettings("Tracer")})
                            end
                            alive[char] = true
                        end
                    end
                end
            end

            if settings.SURVIVORS_ESP then
                for i = #espCache.survivors, 1, -1 do
                    local char = espCache.survivors[i]
                    if not char.Parent or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
                        table.remove(espCache.survivors, i)
                        RemoveESP(char)
                    else
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then
                            local plr = Players:GetPlayerFromCharacter(char)
                            local color = getColorFromSettings("Survivors")
                            UpdateHighlight(char, root, {MaxDistance = settings.ESP_MAX_DISTANCE, MinDistance = settings.ESP_MIN_DISTANCE, Color = color})
                            if settings.SHOW_TEXT then
                                UpdateText(char, root, {MinDistance = settings.ESP_TEXT_MIN_DISTANCE, Text = plr and plr.Name or char.Name, Color = color})
                            end
                            if settings.ESP_BOX_ENABLED then
                                UpdateBox(char, root, {Color = getColorFromSettings("Box")})
                            end
                            if settings.ESP_TRACER_ENABLED then
                                UpdateTracer(char, root, {Color = getColorFromSettings("Tracer")})
                            end
                            alive[char] = true
                        end
                    end
                end
            end

            if settings.GENERATORS_ESP then
                for i = #espCache.generators, 1, -1 do
                    local obj = espCache.generators[i]
                    if not obj.Parent then
                        table.remove(espCache.generators, i)
                        RemoveESP(obj)
                    else
                        local progress = obj:FindFirstChild("Progress")
                        if progress and progress.Value >= 100 then
                            RemoveESP(obj)
                        else

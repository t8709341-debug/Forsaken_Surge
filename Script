-- ==========================================
local function fetchServerList()
    local placeId = game.PlaceId
    local servers = {}
    local cursor = nil
    for _ = 1, 3 do
        local url
        if cursor then
            url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&cursor=%s", placeId, cursor)
        else
            url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", placeId)
        end
        local ok, response = pcall(function() return game:HttpGet(url) end)
        if not ok then break end
        local ok2, data = pcall(function() return HttpService:JSONDecode(response) end)
        if not ok2 or not data or not data.data then break end
        for _, srv in ipairs(data.data) do
            if srv.id and srv.playing and srv.maxPlayers
               and srv.playing < srv.maxPlayers
               and srv.playing >= settings.HOP_MIN_PLAYERS
               and srv.playing <= settings.HOP_MAX_PLAYERS
               and srv.id ~= game.JobId then
                table.insert(servers, {id = srv.id, playing = srv.playing, max = srv.maxPlayers, ping = srv.ping or 0})
            end
        end
        if data.nextPageCursor and data.nextPageCursor ~= "" and data.nextPageCursor ~= "null" then
            cursor = data.nextPageCursor
        else break end
    end
    return servers
end

local function hopToServer()
    showNotification("🔄 Server Hop", "Ищу серверы...")
    local servers = fetchServerList()
    if #servers == 0 then
        showNotification("🔄 Server Hop", "Серверы не найдены")
        return
    end
    if settings.HOP_PREFER_LOW then
        table.sort(servers, function(a, b) return a.playing < b.playing end)
    else
        table.sort(servers, function(a, b) return a.ping < b.ping end)
    end
    local target = servers[1]
    showNotification("🔄 Server Hop", string.format("Переход: %d/%d", target.playing, target.max))
    pcall(function()
        if queue_on_teleport then
            queue_on_teleport([[
                loadstring(game:HttpGet("https://raw.githubusercontent.com/Nebula-Softworks/Luna-Interface-Suite/refs/heads/main/source.lua", true))()
            ]])
        end
    end)
    task.wait(1)
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, target.id, player)
    end)
end

task.spawn(function()
    local hopping = false
    while task.wait(0.5) do
        if not settings.HOP_AUTO_ON_KILLER then continue end
        if hopping then continue end
        if not hrp then continue end
        local killers, survivors = collectRoleContainers()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == player then continue end
            local role = getPlayerRole(plr, killers, survivors)
            if role ~= "Killer" then continue end
            local char = plr.Character
            if not char then continue end
            local targetRoot = char:FindFirstChild("HumanoidRootPart")
            if not targetRoot then continue end
            local dist = (hrp.Position - targetRoot.Position).Magnitude
            if dist <= settings.HOP_AUTO_DISTANCE then
                hopping = true
                showNotification("🚨 Auto-Hop", string.format("Убийца рядом (%.0f)! Хоп...", dist))
                task.wait(settings.HOP_AUTO_DELAY)
                hopToServer()
                break
            end
        end
    end
end)


-- Player List
SettingsTab:CreateLabel({ Text = "👥 PLAYER LIST", Style = 1 })
local playerListLabel = SettingsTab:CreateLabel({ Text = "Загрузка...", Style = 1 })

local function refreshPlayerListText()
    local killers, survivors = collectRoleContainers()
    local lines = {}
    local kCount, sCount, uCount = 0, 0, 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then
            table.insert(lines, "⭐ " .. plr.Name .. " (ТЫ)")
            continue
        end
        local role = getPlayerRole(plr, killers, survivors)
        local icon
        if role == "Killer" then icon = "🔴 Killer" kCount = kCount + 1
        elseif role == "Survivor" then icon = "🟢 Survivor" sCount = sCount + 1
        else icon = "❓ Unknown" uCount = uCount + 1 end
        local status = "dead"
        if plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
            status = "alive"
        end
        table.insert(lines, string.format("%s — %s [%s]", plr.Name, icon, status))
    end
    if #lines == 0 then lines = {"Нет игроков"} end
    local header = string.format("🔴 %d | 🟢 %d | ❓ %d | Всего: %d\n\n", kCount, sCount, uCount, #Players:GetPlayers())
    pcall(function() playerListLabel:Set(header .. table.concat(lines, "\n")) end)
end

SettingsTab:CreateButton({ Name = "🔄 Обновить Player List", Callback = refreshPlayerListText })
SettingsTab:CreateInput({ Name = "Ник для ТП", CurrentValue = "", PlaceholderText = "Player1", RemoveTextAfterFocusLost = false, Callback = function(t) _G.__tpByName = t end })

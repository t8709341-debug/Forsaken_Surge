    end
    pcall(function()
        writefile(WaypointFolder .. "/wp_" .. tostring(game.PlaceId) .. ".json", HttpService:JSONEncode(data))
    end)
end

local function loadWaypoints()
    local path = WaypointFolder .. "/wp_" .. tostring(game.PlaceId) .. ".json"
    if isfile(path) then
        local ok, data = pcall(HttpService.JSONDecode, HttpService, readfile(path))
        if ok and type(data) == "table" then
            waypoints = {}
            for _, wp in ipairs(data) do
                if wp.Position and #wp.Position == 3 then
                    table.insert(waypoints, {
                        Name = wp.Name or "WP",
                        Position = Vector3.new(wp.Position[1], wp.Position[2], wp.Position[3])
                    })
                end
            end
        end
    end
end


local alertLastPlayed = 0

local function getKillers()
    local t = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        local team = plr.Team
        if team then
            local tn = team.Name:lower()
            if tn:find("killer") or tn:find("monster") or tn:find("enemy") then
                if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    table.insert(t, plr.Character)
                end
            end
        end
    end
    return t
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if settings.ALERT_ENABLED and hrp then
            local closest = math.huge
            for _, char in ipairs(getKillers()) do
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    local d = (root.Position - hrp.Position).Magnitude
                    if d < closest then closest = d end
                end
            end
            if closest < settings.ALERT_RADIUS then
                local intensity = 1 - (closest / settings.ALERT_RADIUS)
                vignette.BackgroundTransparency = 1 - intensity * 0.35
                alertLabel.TextTransparency = 1 - intensity
                alertLabel.Text = string.format("⚠️ KILLER %.0fm", closest)
                local now = tick()
                if settings.ALERT_SOUND_ENABLED and closest < settings.ALERT_RADIUS * 0.5 and now - alertLastPlayed > 3 then

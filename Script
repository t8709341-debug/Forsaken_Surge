local function macroRecordPosition()
    if not recordingMacro or not hrp then return end
    local lastTime = recordingEvents[#recordingEvents] and recordingEvents[#recordingEvents].time or 0
    local now = tick()
    table.insert(recordingEvents, {
        type = "tp",
        pos = {hrp.Position.X, hrp.Position.Y, hrp.Position.Z},
        delay = math.min(now - lastTime, 5),
        time = now
    })
    showNotification("🎬 Macro", "Позиция записана")
end


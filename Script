local function applyScreenShake()
    if not settings.C00LGUI_SCREEN_SHAKE then return end
    
    local shakeTime = 0
    local shakeDuration = 0.5
    local intensity = settings.C00LGUI_SHAKE_INTENSITY
    
    c00lguiShakeConnection = RunService.RenderStepped:Connect(function(dt)
        shakeTime = shakeTime + dt
        if shakeTime > shakeDuration then
            if c00lguiShakeConnection then
                c00lguiShakeConnection:Disconnect()
                c00lguiShakeConnection = nil
            end
            return
        end
        
        local progress = 1 - (shakeTime / shakeDuration)
        local strength = intensity * progress
        
        local shakeX = (math.random() - 0.5) * strength * 0.01
        local shakeY = (math.random() - 0.5) * strength * 0.01
        local shakeZ = (math.random() - 0.5) * strength * 0.01
        
        Camera.CFrame = Camera.CFrame * CFrame.new(shakeX, shakeY, shakeZ)
    end)
end

local function applyTimeSlowdown()
    if not settings.C00LGUI_TIME_SLOWDOWN then return end
    
    c00lguiOriginalGravity = Workspace.Gravity
    
    local startTime = tick()
    local duration = settings.C00LGUI_SLOWDOWN_DURATION
    
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        local elapsed = tick() - startTime
        if elapsed > duration then
            Workspace.Gravity = c00lguiOriginalGravity
            conn:Disconnect()
            return
        end
        
        local progress = elapsed / duration
        local slowdownFactor = 1 - (math.sin(progress * math.pi) * 0.7)
        Workspace.Gravity = c00lguiOriginalGravity * slowdownFactor
    end)
end


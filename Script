            isOnCeiling = false
            ceilingTime = 0
            showNotification("🕷️ Ходьба по стенам", "Включена", 1)
        else
            humanoid.AutoRotate = true
            humanoid.PlatformStand = false
            gravityDir = Vector3.new(0, -1, 0)
            upDir = Vector3.new(0, 1, 0)
            fallSpeed = 0
            isGrounded = false
            isOnCeiling = false
            ceilingTime = 0
            if hrp then
                hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + facing)
            end
            showNotification("🕷️ Ходьба по стенам", "Выключена", 1)
        end
    end
    
    -- КЛАВИША V - ПОЛЁТ
    if input.KeyCode == FLY_KEY then
        if not hrp or not humanoid then
            updateCharacterReferences()
            if not hrp or not humanoid then return end
        end
        
        flying = not flying
        
        if flying then
            climbing = false
            noClipActive = false
            turboActive = false
            humanoid.AutoRotate = false
            humanoid.PlatformStand = true
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
            flyVelocity = Vector3.zero
            if settings.FLY_AUTO_UP then
                flyVelocity = Vector3.new(0, settings.FLY_SPEED * 0.5, 0)
            end
            showNotification("✈️ Полёт", "Активирован", 1)
        else
            humanoid.AutoRotate = true
            humanoid.PlatformStand = false
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
            flyVelocity = Vector3.zero
            gravityDir = Vector3.new(0, -1, 0)
            upDir = Vector3.new(0, 1, 0)
            showNotification("✈️ Полёт", "Деактивирован", 1)
        end
    end
    
    -- КЛАВИША B - НОУКЛИП
    if input.KeyCode == NO_CLIP_KEY then
        toggleNoClip()
    end
    
    -- КЛАВИША Z - ТУРБО
    if input.KeyCode == Enum.KeyCode.Z then
        toggleTurbo()
    end
    
    -- КЛАВИША G + B - ФАЗИРОВАНИЕ
    if input.KeyCode == Enum.KeyCode.G and noClipActive then
        phaseThroughWall()
    end
    
    -- КЛАВИША SHIFT - СПРИНТ
    if input.KeyCode == SPRINT_KEY then
        isSprinting = true
    end
    
    -- КЛАВИША W W - РЫВОК
    if input.KeyCode == DASH_KEY then
        if flying or noClipActive or turboActive then return end
        if not hrp then
            updateCharacterReferences()
            if not hrp then return end
        end
        
        local currentTime = tick()
        if currentTime - lastWPressed < 0.3 then
            wPressCount = wPressCount + 1
        else
            wPressCount = 1
        end
        lastWPressed = currentTime
        
        if wPressCount >= 2 and dashCooldown <= 0 and climbing and hrp then
            local forward = hrp.CFrame.LookVector
            dashDir = projectToPlane(forward, gravityDir).Unit
            if dashDir.Magnitude < 0.1 then
                dashDir = projectToPlane(hrp.CFrame.RightVector, gravityDir).Unit
            end
            dashActive = true
            dashTimer = 0.15
            dashCooldown = 0.8
            showNotification("⚡ Рывок!", "Вперёд!", 0.5)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = false
    if input.KeyCode == SPRINT_KEY then
        isSprinting = false
    end
end)


        removeAllDetectors()
        setCollisionGroup()
        
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        showNotification("🌀 Ноуклип", "Активирован + обход античита", 2)
        
    else
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "NoclipDetector" then
                part.CanCollide = true
            end
        end
        
        gravityDir = Vector3.new(0, -1, 0)
        upDir = Vector3.new(0, 1, 0)
        showNotification("🌀 Ноуклип", "Деактивирован", 1)
    end
end

local function phaseThroughWall()
    if not hrp or not humanoid then return end
    
    local camCFrame = Camera.CFrame
    local forward = camCFrame.LookVector
    local targetPos = hrp.Position + forward * 20
    
    local ray = Workspace:Raycast(hrp.Position, forward * 25, rayParams)
    if ray then
        targetPos = ray.Position + ray.Normal * 3
    end
    
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
    
    hrp.CFrame = CFrame.new(targetPos)
    
    task.wait(0.05)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "NoclipDetector" then
            part.CanCollide = true
        end
    end
    showNotification("🌀 Фазирование", "Проход сквозь стену!", 0.5)
end

-- ==========================================
-- KILLER WALLS REMOVER
-- ==========================================
local function removeKillerWalls()
    if not settings.REMOVE_KILLER_WALLS then 
        return 
    end
    
    local paths = {
        "Map.Ingame.Map.MapBoundaries.KillerDoors",
        "Map.Ingame.Map.MapBoundaries.KillerOnly",
    }
    
    for _, path in ipairs(paths) do
        local current = Workspace
        local success = true
        local parts = {}
        
        for part in string.gmatch(path, "[^%.]+") do
            table.insert(parts, part)
        end
        
        for _, partName in ipairs(parts) do
            if current then
                current = current:FindFirstChild(partName)
                if not current then
                    success = false
                    break
                end
            else
                success = false
                break
            end
        end
        
        if success and current then
            for _, child in ipairs(current:GetChildren()) do
                pcall(function()
                    if child:IsA("BasePart") or child:IsA("Model") or child:IsA("Part") or child:IsA("MeshPart") then
                        child:Destroy()
                    end
                end)
            end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(2)
        if settings.REMOVE_KILLER_WALLS then
            pcall(removeKillerWalls)
        end
    end
end)


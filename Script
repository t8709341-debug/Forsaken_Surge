function LoadSettings()
    if isfile(SaveFile) then
        local ok, data = pcall(HttpService.JSONDecode, HttpService, readfile(SaveFile))
        if ok and type(data) == "table" then
            for k, v in pairs(DefaultSettings) do if data[k] == nil then data[k] = v end end
            return data
        end
    end
    SaveSettings(DefaultSettings)
    return DefaultSettings
end

function SaveSettings(t)
    pcall(function() writefile(SaveFile, HttpService:JSONEncode(t)) end)
end


UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = true
    
    -- TURBO (Z)
    if input.KeyCode == TURBO_KEY then
        toggleTurbo()
    end
    
    -- Ноуклип (B)
    if input.KeyCode == NO_CLIP_KEY then
        toggleNoClip()
    end
    
    -- Фазирование (B + G)
    if input.KeyCode == Enum.KeyCode.G and noClipActive then
        phaseThroughWall()
    end
    
    -- Полёт (V)
    if input.KeyCode == FLY_KEY then
        if not hrp or not humanoid then
            updateCharacterReferences()
            if not hrp or not humanoid then return end
        end
        
        flying = not flying
        
        if flying then
            climbing = false
            noClipActive = false
            turboActive = false
            humanoid.AutoRotate = false
            humanoid.PlatformStand = true
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
            flyVelocity = Vector3.zero
            if settings.FLY_AUTO_UP then
                flyVelocity = Vector3.new(0, settings.FLY_SPEED * 0.5, 0)
            end
            print("✈️ Полёт Активирован")
        else
            humanoid.AutoRotate = true
            humanoid.PlatformStand = false
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
            flyVelocity = Vector3.zero
            gravityDir = Vector3.new(0, -1, 0)
            upDir = Vector3.new(0, 1, 0)
            print("✈️ Полёт Деактивирован")
        end
    end
    
    -- Ходьба по стенам (C)
    if input.KeyCode == CLIMB_KEY then
        if flying or noClipActive or turboActive then return end
        
        if not hrp or not humanoid then
            updateCharacterReferences()
            if not hrp or not humanoid then return end
        end
        
        climbing = not climbing
        if climbing then
            humanoid.AutoRotate = false
            humanoid.PlatformStand = true
            facing = hrp.CFrame.LookVector
            upDir = hrp.CFrame.UpVector
            gravityDir = -upDir
            isOnCeiling = false
            ceilingTime = 0
            print("🕷️ Ходьба Включена")
        else
            humanoid.AutoRotate = true
            humanoid.PlatformStand = false
            gravityDir = Vector3.new(0, -1, 0)
            upDir = Vector3.new(0, 1, 0)
            fallSpeed = 0
            isGrounded = false
            isOnCeiling = false
            ceilingTime = 0
            if hrp then
                hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + facing)
            end
            print("🕷️ Ходьба Выключена")
        end
    end
    
    -- Спринт
    if input.KeyCode == SPRINT_KEY then
        isSprinting = true
    end
    
    -- Меню
    if input.KeyCode == MENU_KEY then
        Window:ToggleVisibility()
    end
    
    -- Рывок (двойное W)
    if input.KeyCode == DASH_KEY then
        if flying or noClipActive or turboActive then return end
        if not hrp then
            updateCharacterReferences()
            if not hrp then return end
        end
        
        local currentTime = tick()
        if currentTime - lastWPressed < 0.3 then
            wPressCount = wPressCount + 1
        else
            wPressCount = 1
        end
        lastWPressed = currentTime
        
        if wPressCount >= 2 and dashCooldown <= 0 and climbing and hrp then
            local forward = hrp.CFrame.LookVector
            dashDir = projectToPlane(forward, gravityDir).Unit
            if dashDir.Magnitude < 0.1 then
                dashDir = projectToPlane(hrp.CFrame.RightVector, gravityDir).Unit
            end
            dashActive = true
            dashTimer = settings.DASH_DURATION
            dashCooldown = settings.DASH_COOLDOWN
            print("⚡ Рывок!")
        end
    end
end)


local keyActions = {
    KEY_WALLWALK   = toggleClimb,
    KEY_FLY        = toggleFly,
    KEY_NOCLIP     = toggleNoClip,
    KEY_TURBO      = toggleTurbo,
    KEY_SPEEDHACK  = toggleSpeedHack,
    KEY_FULLBRIGHT = toggleFullbright,
}

local keyData = {
    KEY_WALLWALK   = {label = "Wall Walk",  key = Enum.KeyCode.C},
    KEY_FLY        = {label = "Fly",        key = Enum.KeyCode.V},
    KEY_NOCLIP     = {label = "No Clip",    key = Enum.KeyCode.B},
    KEY_TURBO      = {label = "Turbo",      key = Enum.KeyCode.Z},
    KEY_SPEEDHACK  = {label = "Speed Hack", key = Enum.KeyCode.X},
    KEY_FULLBRIGHT = {label = "Fullbright", key = Enum.KeyCode.F},
}

-- восстановление из settings
for id, data in pairs(keyData) do
    local stored = settings[id]
    if stored then
        pcall(function() data.key = Enum.KeyCode[stored] end)
    end
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = true

    for id, data in pairs(keyData) do
        if input.KeyCode == data.key then
            local action = keyActions[id]
            if action then action() end
            return
        end
    end

    if input.KeyCode == Enum.KeyCode.P then addWaypoint("WP" .. (#waypoints + 1)) end
    if input.KeyCode == Enum.KeyCode.L then removeWaypoint(#waypoints) end
    if input.KeyCode == Enum.KeyCode.T then teleportToWaypoint(1) end
    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = true end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = false
    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = false end
end)


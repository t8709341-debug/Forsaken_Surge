    local paths = {
        "Map.Ingame.Map.MapBoundaries.KillerDoors",
        "Map.Ingame.Map.MapBoundaries.KillerOnly",
    }
    for _, path in ipairs(paths) do
        local current = Workspace
        local parts = {}
        for part in string.gmatch(path, "[^%.]+") do table.insert(parts, part) end
        local success = true
        for _, partName in ipairs(parts) do
            if current then
                current = current:FindFirstChild(partName)
                if not current then success = false break end
            else
                success = false
                break
            end
        end
        if success and current then
            for _, child in ipairs(current:GetChildren()) do
                pcall(function()
                    if child:IsA("BasePart") or child:IsA("Model") then child:Destroy() end
                end)
            end
        end
    end

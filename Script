espFolder.Parent = player:WaitForChild("PlayerGui")

local espHighlights = {}

local function clearAllESP()
    for _, hl in ipairs(espHighlights) do
        pcall(function() hl:Destroy() end)
    end
    espHighlights = {}
end

local function createNewHighlight(adornee, color, transparency, outlineTransparency)
    if not adornee or not adornee.Parent then return nil end
    if not adornee:IsA("BasePart") and not adornee:IsA("Model") then return nil end
    
    local hl = Instance.new("Highlight")
    hl.Adornee = adornee
    hl.FillColor = color
    hl.FillTransparency = transparency or 0.5
    hl.OutlineTransparency = outlineTransparency or 0.5
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = espFolder
    table.insert(espHighlights, hl)
    
    Debris:AddItem(hl, 10)
    
    return hl
end

local function rebuildESP()
    clearAllESP()
    
    if not settings.PLAYER_ESP and not settings.ESP_GEN and not settings.ESP_ITEMS then
        return
    end
    
    if settings.PLAYER_ESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local char = plr.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local color = Color3.fromRGB(unpack(settings.ESP_COLOR_SURVIVOR))
                    
                    local team = plr.Team
                    if team then
                        local teamName = team.Name:lower()
                        if teamName:find("killer") or teamName:find("monster") or teamName:find("враг") then
                            color = Color3.fromRGB(unpack(settings.ESP_COLOR_KILLER))
                        end
                    end
                    
                    createNewHighlight(char, color, 0.5, 0.5)
                end
            end
        end
    end
    
    if settings.ESP_GEN then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj.Parent then
                local name = string.lower(obj.Name)
                if string.find(name, "generator") or string.find(name, "gen") or obj:GetAttribute("Generator") then
                    createNewHighlight(obj, Color3.fromRGB(unpack(settings.ESP_COLOR_GENERATOR)), 0.5, 0.5)
                end
            end
        end
    end
    
    if settings.ESP_ITEMS then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Tool") and obj.Parent and obj:FindFirstChild("ItemRoot") then
                createNewHighlight(obj, Color3.fromRGB(unpack(settings.ESP_COLOR_ITEM)), 0.4, 0.3)
            end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(1.5)
        pcall(function()
            if player and player.Parent then
                rebuildESP()
            end
        end)
    end
end)

player.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    pcall(rebuildESP)
end)


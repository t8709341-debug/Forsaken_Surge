-- ==========================================
-- MAIN WALL WALK LOOP
-- ==========================================
RunService.Heartbeat:Connect(function(dt)
    if not character or not character.Parent then
        updateCharacterReferences()
        if not hrp or not humanoid then return end
    end

    if noClipActive and hrp and humanoid then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end

        local camCFrame = Camera.CFrame
        local fwd = (pressed[Enum.KeyCode.W] and 1 or 0) - (pressed[Enum.KeyCode.S] and 1 or 0)
        local str = (pressed[Enum.KeyCode.D] and 1 or 0) - (pressed[Enum.KeyCode.A] and 1 or 0)
        local up = (pressed[Enum.KeyCode.Space] and 1 or 0) - (pressed[Enum.KeyCode.LeftControl] and 1 or 0)

        local moveDir = camCFrame.LookVector * fwd + camCFrame.RightVector * str + Vector3.new(0, 1, 0) * up
        if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end

        local speed = settings.WALK_SPEED
        if isSprinting then speed = settings.WALK_SPEED * settings.SPRINT_MULTIPLIER * 2 end

        hrp.AssemblyLinearVelocity = moveDir * speed
        hrp.AssemblyAngularVelocity = Vector3.zero
        return
    end

    if settings.AUTO_RESET_ON_FALL and climbing and hrp then
        if hrp.Position.Y < settings.RESET_HEIGHT then
            climbing = false
            if humanoid then
                humanoid.AutoRotate = true
                humanoid.PlatformStand = false
            end
            gravityDir = Vector3.new(0, -1, 0)
            upDir = Vector3.new(0, 1, 0)
            fallSpeed = 0
            isGrounded = false
            isOnCeiling = false
            ceilingTime = 0
            return
        end
    end

    if flying and hrp and humanoid then
        local camCFrame = Camera.CFrame
        local camForward = camCFrame.LookVector
        local camRight = camCFrame.RightVector
        local camUp = camCFrame.UpVector

        local fwd = (pressed[Enum.KeyCode.W] and 1 or 0) - (pressed[Enum.KeyCode.S] and 1 or 0)
        local str = (pressed[Enum.KeyCode.D] and 1 or 0) - (pressed[Enum.KeyCode.A] and 1 or 0)
        local up = (pressed[Enum.KeyCode.Space] and 1 or 0) - (pressed[Enum.KeyCode.LeftControl] and 1 or 0)

        local moveDir = camForward * fwd + camRight * str + camUp * up
        if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end

        local targetVel = moveDir * settings.FLY_SPEED
        if settings.FLY_HOVER and moveDir.Magnitude < 0.1 then targetVel = Vector3.zero end

        flyVelocity = flyVelocity:Lerp(targetVel, math.min(1, dt * settings.FLY_ACCELERATION))
        if flyVelocity.Magnitude > settings.FLY_MAX_SPEED then
            flyVelocity = flyVelocity.Unit * settings.FLY_MAX_SPEED
        end

        hrp.AssemblyLinearVelocity = flyVelocity

        if moveDir.Magnitude > 0.1 then
            local targetCF = CFrame.lookAt(hrp.Position, hrp.Position + moveDir, camUp)
            hrp.CFrame = hrp.CFrame:Lerp(targetCF, math.min(1, dt * settings.FLY_SMOOTHNESS))
        end
        return
    end

    if not climbing or not hrp or not humanoid then return end

    if isOnCeiling and settings.CEILING_GRIP then
        ceilingTime = ceilingTime + dt
        if ceilingTime > settings.CEILING_MAX_TIME then
            climbing = false
            humanoid.AutoRotate = true
            humanoid.PlatformStand = false
            gravityDir = Vector3.new(0, -1, 0)
            upDir = Vector3.new(0, 1, 0)
            fallSpeed = 0
            isGrounded = false
            isOnCeiling = false
            ceilingTime = 0
            return
        end
    else
        ceilingTime = 0
    end

    local pos = hrp.Position
    local camCFrame = Camera.CFrame

    local camForward = projectToPlane(camCFrame.LookVector, upDir)
    if camForward.Magnitude > 0.001 then
        camForward = camForward.Unit
    else
        camForward = projectToPlane(-camCFrame.UpVector, upDir).Unit
    end
    local camRight = upDir:Cross(camForward).Unit

    local fwd = (pressed[Enum.KeyCode.W] and 1 or 0) - (pressed[Enum.KeyCode.S] and 1 or 0)
    local str = (pressed[Enum.KeyCode.D] and 1 or 0) - (pressed[Enum.KeyCode.A] and 1 or 0)

    local move = camForward * fwd + camRight * str
    if move.Magnitude > 0 then move = move.Unit end

    local wallHit = move.Magnitude > 0 and Workspace:Raycast(pos, move * settings.WALL_RANGE, rayParams) or nil
    local supportNear = Workspace:Raycast(pos, gravityDir * 2, rayParams) ~= nil
    local supportFar = Workspace:Raycast(pos, gravityDir * 3.5, rayParams) ~= nil

    if isGrounded then
        if not supportFar then isGrounded = false end
    else
        if supportNear then isGrounded = true end
    end

    local targetGravity = gravityDir
    if isGrounded and wallHit and wallHit.Normal then
        targetGravity = -wallHit.Normal
    elseif not isGrounded then
        if wallHit and wallHit.Normal then
            targetGravity = -wallHit.Normal
        else
            targetGravity = Vector3.new(0, -1, 0)
        end
    end

    gravityDir = slerp(gravityDir, targetGravity, math.min(1, dt * settings.GRAVITY_LERP_SPEED))
    upDir = -gravityDir

    isOnCeiling = false
    if isGrounded and wallHit and wallHit.Normal then
        if wallHit.Normal.Y < -0.5 then isOnCeiling = true end
    end

    local currentGravity = settings.GRAVITY
    local useGripForce = settings.FALL_OFFSET
    local currentSpeed = settings.WALK_SPEED

    if isSprinting then
        currentSpeed = settings.WALK_SPEED * settings.SPRINT_MULTIPLIER
    end

    if isOnCeiling and settings.CEILING_GRIP then
        currentGravity = 0
        useGripForce = settings.CEILING_GRIP_FORCE
        fallSpeed = 0
    end

    local vel = projectToPlane(move * currentSpeed, gravityDir)

    if isGrounded then
        fallSpeed = 0
        if settings.STICK_TO_SURFACE then
            vel = vel + gravityDir * useGripForce
        else
            vel = vel + gravityDir * 0.1
        end
    else
        fallSpeed = fallSpeed + currentGravity * dt
        if fallSpeed > settings.FALL_LIMIT then fallSpeed = settings.FALL_LIMIT end
        vel = vel + gravityDir * fallSpeed
    end

    if not (isOnCeiling and settings.CEILING_GRIP) then
        vel = vel + Vector3.new(0, Workspace.Gravity, 0) * dt
    end

    local currentVel = hrp.AssemblyLinearVelocity
    local newVel = currentVel:Lerp(vel, math.min(1, dt * settings.SMOOTHNESS))
    hrp.AssemblyLinearVelocity = newVel
    hrp.AssemblyAngularVelocity = Vector3.zero

    local desiredFacing = move.Magnitude > 0 and projectToPlane(move, gravityDir).Unit or facing
    facing = facing:Lerp(desiredFacing, math.min(1, dt * settings.ALIGN_SPEED))

    hrp.CFrame = hrp.CFrame:Lerp(makeCFrame(pos, facing, upDir), math.min(1, dt * settings.ALIGN_SPEED))
end)


UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = true
    
    -- C - Ходьба по стенам
    if input.KeyCode == Enum.KeyCode.C then
        if flying or noClipActive or turboActive then return end
        if not hrp or not humanoid then
            updateCharacterReferences()
            if not hrp or not humanoid then return end
        end
        
        climbing = not climbing
        if climbing then
            humanoid.AutoRotate = false
            humanoid.PlatformStand = true
            facing = hrp.CFrame.LookVector
            upDir = hrp.CFrame.UpVector
            gravityDir = -upDir
            isOnCeiling = false
            ceilingTime = 0
            showNotification("🕷️ Ходьба", "Включена", 1)
        else
            humanoid.AutoRotate = true
            humanoid.PlatformStand = false
            gravityDir = Vector3.new(0, -1, 0)
            upDir = Vector3.new(0, 1, 0)
            fallSpeed = 0
            isGrounded = false
            isOnCeiling = false
            ceilingTime = 0
            if hrp then
                hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + facing)
            end
            showNotification("🕷️ Ходьба", "Выключена", 1)
        end
    end
    
    -- V - Полёт
    if input.KeyCode == Enum.KeyCode.V then
        if not hrp or not humanoid then
            updateCharacterReferences()
            if not hrp or not humanoid then return end
        end
        flying = not flying
        if flying then
            climbing = false
            noClipActive = false
            turboActive = false
            humanoid.AutoRotate = false
            humanoid.PlatformStand = true
            if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
            flyVelocity = Vector3.zero
            if settings.FLY_AUTO_UP then
                flyVelocity = Vector3.new(0, settings.FLY_SPEED * 0.5, 0)
            end
            showNotification("✈️ Полёт", "Активирован", 1)
        else
            humanoid.AutoRotate = true
            humanoid.PlatformStand = false
            if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
            flyVelocity = Vector3.zero
            gravityDir = Vector3.new(0, -1, 0)
            upDir = Vector3.new(0, 1, 0)
            showNotification("✈️ Полёт", "Деактивирован", 1)
        end
    end
    
    -- B - Ноуклип
    if input.KeyCode == Enum.KeyCode.B then
        toggleNoClip()
    end
    
    -- Z - Турбо
    if input.KeyCode == Enum.KeyCode.Z then
        toggleTurbo()
    end
    
    -- B + G - Фазирование
    if input.KeyCode == Enum.KeyCode.G and noClipActive then
        phaseThroughWall()
    end
    
    -- Shift - Спринт
    if input.KeyCode == Enum.KeyCode.LeftShift then
        isSprinting = true
    end
end)

UserInputService.InputEnded:Connect(function(input, gp)

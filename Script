local skeletonEnabled = settings.SKELETON_ENABLED
local skeletonColor = Color3.fromRGB(settings.SKELETON_COLOR_R, settings.SKELETON_COLOR_G, settings.SKELETON_COLOR_B)
local skeletonThickness = settings.SKELETON_THICKNESS
local skeletonFadeDistance = settings.SKELETON_FADE_DISTANCE
local skeletonData = setmetatable({}, {__mode = "k"})

local MOTOR_BLACKLIST = { ["Root"] = true, ["RootJoint"] = true }

local function createSkeletonFor(char)
    if not char or not char.Parent then return end
    if skeletonData[char] then return end
    local data = { lines = {}, char = char }
    skeletonData[char] = data
    local function buildLines()
        if not char.Parent then return end
        for _, motor in ipairs(char:GetDescendants()) do
            if motor:IsA("Motor6D") and motor.Part0 and motor.Part1 then
                if not MOTOR_BLACKLIST[motor.Name] then
                    if not data.lines[motor] then
                        local line = Instance.new("LineHandleAdornment")
                        line.Name = "FS_Bone_" .. motor.Name
                        line.Archivable = false
                        line.Adornee = motor.Part0
                        line.AlwaysOnTop = true
                        line.ZIndex = 5
                        line.Thickness = skeletonThickness
                        line.Color3 = skeletonColor
                        line.Length = 0
                        line.Transparency = 0
                        line.Parent = motor.Part0
                        data.lines[motor] = line
                    end
                end
            end
        end
    end
    buildLines()
    task.delay(0.5, buildLines)
    task.delay(1.5, buildLines)
end

local function destroySkeleton(char)
    local data = skeletonData[char]
    if not data then return end
    for motor, line in pairs(data.lines) do pcall(function() line:Destroy() end) end
    skeletonData[char] = nil
end

local function clearAllSkeletons()
    for char, _ in pairs(skeletonData) do destroySkeleton(char) end
    skeletonData = setmetatable({}, {__mode = "k"})
end

task.spawn(function()
    while true do
        RunService.RenderStepped:Wait()
        if not skeletonEnabled then continue end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == player then continue end
            local char = plr.Character
            if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                if not skeletonData[char] then createSkeletonFor(char) end
                local data = skeletonData[char]
                if data then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    local dist = root and (Camera.CFrame.Position - root.Position).Magnitude or 0
                    local fade = 1
                    if dist > skeletonFadeDistance then fade = 0
                    elseif dist > skeletonFadeDistance * 0.8 then
                        fade = 1 - (dist - skeletonFadeDistance * 0.8) / (skeletonFadeDistance * 0.2)
                    end
                    for motor, line in pairs(data.lines) do
                        local p0 = motor.Part0
                        local p1 = motor.Part1
                        if p0 and p1 and p0.Parent and p1.Parent then
                            line.Adornee = p0
                            local delta = p1.Position - p0.Position
                            local len = delta.Magnitude
                            line.Length = len
                            if len > 0.001 then
                                line.CFrame = CFrame.new(p0.Position + delta * 0.5, p0.Position + delta)
                            end
                            line.Transparency = 1 - fade
                            line.Thickness = skeletonThickness
                            line.Color3 = skeletonColor
                        else
                            line.Transparency = 1
                        end
                    end
                end
            else
                if char then destroySkeleton(char) end
            end
        end
    end
end)


UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if recordingMacro and input.UserInputType == Enum.UserInputType.Keyboard then
        local lastTime = recordingEvents[#recordingEvents] and recordingEvents[#recordingEvents].time or 0
        local now = tick()
        table.insert(recordingEvents, {
            type = "keypress",
            key = input.KeyCode.Name,
            delay = math.min(now - lastTime, 5),
            time = now
        })
    end
end)


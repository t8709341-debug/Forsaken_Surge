local function CreateHighlight(adornee, color, alpha)
    if not adornee or not adornee.Parent then return nil end
    
    local hl = Instance.new("Highlight")
    hl.Adornee = adornee
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = alpha or 0.5
    hl.OutlineTransparency = alpha or 0.5
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = espFolder
    return hl
end

local function CreateNameTag(adornee, text, color)
    if not adornee or not adornee.Parent then return nil end
    
    local bill = Instance.new("BillboardGui")
    bill.Adornee = adornee
    bill.Size = UDim2.new(2, 0, 0.8, 0)
    bill.StudsOffset = Vector3.new(0, 3.5, 0)
    bill.AlwaysOnTop = true
    bill.ResetOnSpawn = false
    bill.Parent = adornee
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0.3
    label.Parent = bill
    
    return bill
end


SettingsTab:CreateButton({ Name = "🎯 ТП к ближайшему убийце", Callback = function()
    if not hrp then return end
    local killers, survivors = collectRoleContainers()
    local closest, cd = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        if getPlayerRole(plr, killers, survivors) ~= "Killer" then continue end
        local char = plr.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end
        local d = (hrp.Position - root.Position).Magnitude
        if d < cd then cd = d closest = plr end
    end
    if closest then teleportToPlayer(closest.Name) else showNotification("👥 TP", "Убийца не найден") end
end })
SettingsTab:CreateButton({ Name = "🏃 ТП к ближайшему выжившему", Callback = function()

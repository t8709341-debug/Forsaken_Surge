local function toggleNoClip()
    if not hrp or not humanoid then
        updateCharacterReferences()
        if not hrp or not humanoid then return end
    end
    
    noClipActive = not noClipActive
    
    if noClipActive then
        climbing = false
        flying = false
        turboActive = false
        humanoid.AutoRotate = true
        humanoid.PlatformStand = false
        removeNoclipDetector()
        removeAllDetectors()
        setCollisionGroup()
        
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        showNotification("🌀 Ноуклип", "Активирован", 1)
    else
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "NoclipDetector" then
                part.CanCollide = true
            end
        end
        gravityDir = Vector3.new(0, -1, 0)
        upDir = Vector3.new(0, 1, 0)
        showNotification("🌀 Ноуклип", "Деактивирован", 1)
    end
end

local function phaseThroughWall()
    if not hrp or not humanoid then return end
    local camCFrame = Camera.CFrame
    local targetPos = hrp.Position + camCFrame.LookVector * 20
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
    hrp.CFrame = CFrame.new(targetPos)
    task.wait(0.05)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "NoclipDetector" then
            part.CanCollide = true
        end
    end
end

-- ==========================================
-- KILLER WALLS REMOVER
-- ==========================================
local function removeKillerWalls()
    if not settings.REMOVE_KILLER_WALLS then return end
    local paths = {
        "Map.Ingame.Map.MapBoundaries.KillerDoors",
        "Map.Ingame.Map.MapBoundaries.KillerOnly",
    }
    for _, path in ipairs(paths) do
        local current = Workspace
        local success = true
        local parts = {}
        for part in string.gmatch(path, "[^%.]+") do
            table.insert(parts, part)
        end
        for _, partName in ipairs(parts) do
            if current then
                current = current:FindFirstChild(partName)
                if not current then success = false break end
            else
                success = false break
            end
        end
        if success and current then
            for _, child in ipairs(current:GetChildren()) do
                pcall(function()
                    if child:IsA("BasePart") or child:IsA("Model") then
                        child:Destroy()
                    end
                end)
            end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(2)
        if settings.REMOVE_KILLER_WALLS then pcall(removeKillerWalls) end
    end
end)


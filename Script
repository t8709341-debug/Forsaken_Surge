local function UpdateHighlight(ItemInstance, TargetRoot, Settings)
    Settings = type(Settings) == "table" and Settings or {
        MaxDistance = settings.ESP_MAX_DISTANCE,
        MinDistance = settings.ESP_MIN_DISTANCE,
        Color = Color3.new(1,1,1)
    }
    local entry = espTracked[ItemInstance]
    local Highlight = entry and entry.highlight
    if not Highlight or not Highlight.Parent then
        Highlight = Instance.new("Highlight")
        Highlight.Name = HttpService:GenerateGUID(false):sub(1,7)
        Highlight.Archivable = false
        Highlight:SetAttribute("Dynamic", true)
        Highlight.Parent = ItemInstance
        Highlight.Adornee = ItemInstance
        Highlight.DepthMode = Enum.HighlightDepthMode[settings.ESP_HIGHLIGHT_DEPTH_MODE] or Enum.HighlightDepthMode.AlwaysOnTop
        table.insert(espHighlights, Highlight)
        if not espTracked[ItemInstance] then espTracked[ItemInstance] = {} end
        espTracked[ItemInstance].highlight = Highlight
    end
    local baseFillTransparency = 1 - settings.ESP_FILL_TRANSPARENCY
    local baseOutlineTransparency = 1 - settings.ESP_OUTLINE_TRANSPARENCY
    local H, S, V = Settings.Color:ToHSV()
    Highlight.FillColor = Color3.fromHSV(H, S, V * 0.8)
    Highlight.OutlineColor = Color3.fromHSV(H, S, V * 1.1)
    if settings.ESP_RENDER_DISTANCE_FADE and TargetRoot and TargetRoot.Parent then
        local dist = (Camera.CFrame.Position - TargetRoot.Position).Magnitude
        local minD = Settings.MinDistance or settings.ESP_MIN_DISTANCE
        local maxD = Settings.MaxDistance or settings.ESP_MAX_DISTANCE
        local alpha = math.clamp(1 - math.clamp((dist - minD) / math.max(maxD - minD, 0.001), 0, 1), settings.ESP_FADE_MIN_ALPHA, 1)
        Highlight.FillTransparency = math.clamp(alpha + (1 - settings.ESP_FILL_TRANSPARENCY), 0, 1)
        Highlight.OutlineTransparency = math.clamp(alpha + (1 - settings.ESP_OUTLINE_TRANSPARENCY), 0, 1)
    else
        Highlight.FillTransparency = baseFillTransparency
        Highlight.OutlineTransparency = baseOutlineTransparency
    end
end

local function UpdateText(ItemInstance, TargetRoot, Settings)

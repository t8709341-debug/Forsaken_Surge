local function projectToPlane(v, n) return v - n * v:Dot(n) end

local function makeCFrame(pos, forward, up)
    local f = forward.Unit
    local r = f:Cross(up); if r.Magnitude < 1e-5 then r = Vector3.new(1,0,0) end
    r = r.Unit
    local u = r:Cross(f).Unit
    return CFrame.new(pos.X,pos.Y,pos.Z, r.X,r.Y,r.Z, u.X,u.Y,u.Z, -f.X,-f.Y,-f.Z)
end

local function slerp(a, b, t)
    local au, bu = a.Unit, b.Unit
    local dot = math.clamp(au:Dot(bu), -1, 1)
    if dot > 0.9999 then return bu end
    local ang = math.acos(dot); local s = math.sin(ang)
    return (au * math.sin((1-t)*ang) + bu * math.sin(t*ang)) / s
end


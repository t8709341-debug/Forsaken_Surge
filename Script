local function getAimbotKey()
    local m = { E=Enum.KeyCode.E, Q=Enum.KeyCode.Q, R=Enum.KeyCode.R, X=Enum.KeyCode.X,
                MouseButton2=Enum.UserInputType.MouseButton2 }
    return m[settings.AIMBOT_KEY] or Enum.KeyCode.E
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = true
    if input.KeyCode == Enum.KeyCode.C and settings.HOTKEY_WALLWALK_ENABLED   then toggleClimb() end
    if input.KeyCode == Enum.KeyCode.V and settings.HOTKEY_FLY_ENABLED        then toggleFly() end
    if input.KeyCode == Enum.KeyCode.B and settings.HOTKEY_NOCLIP_ENABLED     then toggleNoClip() end
    if input.KeyCode == Enum.KeyCode.Z and settings.HOTKEY_TURBO_ENABLED      then toggleTurbo() end
    if input.KeyCode == Enum.KeyCode.F and settings.HOTKEY_FULLBRIGHT_ENABLED then toggleFullbright() end
    if input.KeyCode == Enum.KeyCode.G and settings.HOTKEY_FREECAM_ENABLED    then toggleFreecam() end

    if settings.HOTKEY_AIMBOT_ENABLED and settings.AIMBOT_ENABLED then
        local k = getAimbotKey()
        if input.KeyCode == k or input.UserInputType == k then
            if settings.AIMBOT_TOGGLE_MODE then
                aimbotActive = not aimbotActive
                showNotification("🎯 Aimbot", aimbotActive and "Активен" or "Неактивен")
            else
                aimbotHolding = true
            end
        end
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1 and clickTPActive and settings.HOTKEY_CLICKTP_ENABLED and not freecamActive then
        performClickTP()
    end

    if settings.HOTKEY_WAYPOINTS_ENABLED then
        if input.KeyCode == Enum.KeyCode.P then addWaypoint("WP"..(#waypoints+1)) end
        if input.KeyCode == Enum.KeyCode.L then removeWaypoint(#waypoints) end
        if input.KeyCode == Enum.KeyCode.T then teleportToWaypoint(1) end
    end
    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = true end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = false
    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = false end
    if settings.HOTKEY_AIMBOT_ENABLED and not settings.AIMBOT_TOGGLE_MODE then
        local k = getAimbotKey()
        if input.KeyCode == k or input.UserInputType == k then aimbotHolding = false end
    end
end)


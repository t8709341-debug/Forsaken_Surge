local skeletonThickness = settings.SKELETON_THICKNESS
local skeletonData = setmetatable({}, {__mode = "k"})

local function attachSkeleton(char)
    if not char or not char.Parent then return end
    if skeletonData[char] and next(skeletonData[char]) then
        for _, line in pairs(skeletonData[char]) do
            line.Color3 = skeletonColor
            line.Thickness = skeletonThickness
        end
        return
    end
    skeletonData[char] = {}
    local function scan()
        if not char.Parent then return end
        for _, motor in ipairs(char:GetDescendants()) do
            if motor:IsA("Motor6D") and motor.Part0 and motor.Part1 then
                if skeletonData[char] and not skeletonData[char][motor] then
                    local line = Instance.new("LineHandleAdornment")
                    line.Name = "FS_Bone"
                    line.Adornee = motor.Part0
                    line.AlwaysOnTop = true
                    line.ZIndex = 5
                    line.Thickness = skeletonThickness
                    line.Color3 = skeletonColor
                    line.Length = 0
                    line.Parent = motor.Part0
                    skeletonData[char][motor] = line
                end
            end
        end
    end
    scan()
    task.delay(1, scan)
end

local function clearSkeleton(char)
    if not skeletonData[char] then return end
    for motor, line in pairs(skeletonData[char]) do
        pcall(function() line:Destroy() end)
    end
    skeletonData[char] = nil
end


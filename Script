-- ==========================================

local function removeNoclipDetector()
    if character then
        local detector = character:FindFirstChild("NoclipDetector")
        if detector then
            detector:Destroy()
            return true
        end
    end
    return false
end

local function blockNoclipDetector()
    if character then
        local detector = character:FindFirstChild("NoclipDetector")
        if detector and detector:IsA("BasePart") then
            detector.CanCollide = false
            detector.Transparency = 1
            detector.Size = Vector3.new(0.1, 0.1, 0.1)
            return true
        end
    end
    return false
end

local function hookAntiCheat()
    local acModule = nil
    local modules = {
        ReplicatedStorage:FindFirstChild("Modules"),
        ReplicatedStorage:FindFirstChild("AntiCheat"),
        game:GetService("ServerScriptService"):FindFirstChild("Server"),
        game:GetService("ServerScriptService"):FindFirstChild("Modules"),
    }
    
    for _, container in ipairs(modules) do
        if container then
            for _, child in ipairs(container:GetDescendants()) do
                if child.Name:lower():find("noclip") or child.Name:lower():find("anticheat") or child.Name:lower():find("antinoclip") then
                    acModule = child
                    break
                end
            end
        end
    end
    
    if acModule then
        pcall(function()
            if acModule:FindFirstChild("Check") then
                acModule.Check = function(...)
                    return
                end
            end
            
            if acModule:FindFirstChild("Init") then
                acModule.Init = function(...)
                    return {Cancelled = true}
                end
            end
        end)
    end
end

local function removeAllDetectors()
    for _, char in ipairs(Workspace:GetDescendants()) do
        if char.Name == "NoclipDetector" and char:IsA("BasePart") then
            char:Destroy()
        end
    end
end

task.spawn(function()

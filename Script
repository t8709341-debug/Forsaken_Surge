    local entry = espTracked[ItemInstance]
    local Box = entry and entry.box

    if not Box or not Box.Parent then
        Box = Instance.new("BoxHandleAdornment")
        Box.Name = HttpService:GenerateGUID(false):sub(1,7)
        Box.Archivable = false
        Box.Adornee = TargetRoot
        Box.AlwaysOnTop = true
        Box.ZIndex = 5
        Box.Size = TargetRoot:IsA("BasePart") and TargetRoot.Size or Vector3.new(2,2,2)
        Box.Transparency = settings.ESP_BOX_TRANSPARENCY

    recordingMacro = false
    macros[recordingName] = { events = recordingEvents }
    saveMacro(recordingName)
    showNotification("🎬 Macro", "Сохранено: " .. recordingName .. " (" .. #recordingEvents .. ")")
    recordingName = nil
    recordingEvents = {}

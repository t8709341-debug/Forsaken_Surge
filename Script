local function setCollisionGroup()
    if hrp then
        pcall(function()
            local groups = {
                "Survivors",
                "Killers",
                "Default",
                "Players"
            }
            for _, group in ipairs(groups) do
                pcall(function()
                    hrp.CollisionGroup = group
                end)
            end
        end)
    end
end

local function teleportBypass(targetPos)
    if not hrp then return end
    
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
    
    hrp.CFrame = CFrame.new(targetPos)
    
    task.wait(0.05)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "NoclipDetector" then
            part.CanCollide = true
        end
    end
end


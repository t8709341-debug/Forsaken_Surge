-- ==========================================
-- TURBO LOOP
-- ==========================================
task.spawn(function()
    while true do
        task.wait()
        if turboActive and hrp and humanoid then
            local camLook = Camera.CFrame.LookVector
            local camRight = Camera.CFrame.RightVector
            
            camLook = Vector3.new(camLook.X, 0, camLook.Z).Unit
            camRight = Vector3.new(camRight.X, 0, camRight.Z).Unit
            
            local moveDir = Vector3.zero
            
            if pressed[Enum.KeyCode.W] then moveDir = moveDir + camLook end
            if pressed[Enum.KeyCode.S] then moveDir = moveDir - camLook end
            if pressed[Enum.KeyCode.A] then moveDir = moveDir - camRight end
            if pressed[Enum.KeyCode.D] then moveDir = moveDir + camRight end
            
            if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end
            
            local speed = settings.TURBO_SPEED
            local mode = settings.TURBO_MODE            
            if mode == "Velocity" then
                hrp.AssemblyLinearVelocity = moveDir * speed
                hrp.AssemblyAngularVelocity = Vector3.zero
            elseif mode == "Teleport" then
                local step = speed * 0.016
                hrp.CFrame = hrp.CFrame + moveDir * step
                hrp.AssemblyLinearVelocity = Vector3.zero
            elseif mode == "Combo" then
                hrp.AssemblyLinearVelocity = moveDir * speed * 0.5
                local step = speed * 0.008
                hrp.CFrame = hrp.CFrame + moveDir * step
            end
        end
    end
end)

-- ==========================================
-- KILLER WALLS REMOVER
-- ==========================================
local function removeKillerWalls()
    if not settings.REMOVE_KILLER_WALLS then return end
    
    local paths = {
        "Map.Ingame.Map.MapBoundaries.KillerDoors",
        "Map.Ingame.Map.MapBoundaries.KillerOnly",
    }
    
    for _, path in ipairs(paths) do
        local current = Workspace
        local success = true
        local parts = {}
        
        for part in string.gmatch(path, "[^%.]+") do
            table.insert(parts, part)
        end
        
        for _, partName in ipairs(parts) do
            if current then
                current = current:FindFirstChild(partName)
                if not current then
                    success = false
                    break
                end
            else
                success = false
                break
            end
        end
        
        if success and current then
            for _, child in ipairs(current:GetChildren()) do
                pcall(function()
                    if child:IsA("BasePart") or child:IsA("Model") then
                        child:Destroy()
                    end
                end)
            end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(2)
        if settings.REMOVE_KILLER_WALLS then
            pcall(removeKillerWalls)
        end
    end
end)

-- ==========================================
-- INPUT HANDLING
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = true
    
    if input.KeyCode == Enum.KeyCode.C then toggleClimb() end
    if input.KeyCode == Enum.KeyCode.V then toggleFly() end
    if input.KeyCode == Enum.KeyCode.B then toggleNoClip() end
    if input.KeyCode == Enum.KeyCode.Z then toggleTurbo() end
    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = true end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = false
    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = false end
end)


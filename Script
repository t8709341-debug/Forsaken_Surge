    local cam = freecamCFrame
    local mv = Vector3.zero
    if pressed[Enum.KeyCode.W] then mv = mv + cam.LookVector end
    if pressed[Enum.KeyCode.S] then mv = mv - cam.LookVector end
    if pressed[Enum.KeyCode.A] then mv = mv - cam.RightVector end

    KEY_WALLWALK   = {label = "Wall Walk",       key = Enum.KeyCode.C, default = "C"},
    KEY_FLY        = {label = "Fly",             key = Enum.KeyCode.V, default = "V"},
    KEY_NOCLIP     = {label = "No Clip",         key = Enum.KeyCode.B, default = "B"},
    KEY_SPEEDHACK  = {label = "Speed Hack",      key = Enum.KeyCode.Z, default = "Z"},
    KEY_FULLBRIGHT = {label = "Fullbright",      key = Enum.KeyCode.F, default = "F"},
    KEY_WP_SAVE    = {label = "Waypoint Save",   key = Enum.KeyCode.P, default = "P"},
    KEY_WP_DEL     = {label = "Waypoint Delete", key = Enum.KeyCode.L, default = "L"},
    KEY_WP_SWAP    = {label = "Waypoint Swap",   key = Enum.KeyCode.T, default = "T"},
}

-- Загрузка сохранённых хоткеев
for id, data in pairs(keyData) do
    local stored = settings[id]
    if stored then pcall(function() data.key = Enum.KeyCode[stored] end) end
end

-- UI для смены клавиш (используется в SettingsTab)
local function setKeybind(id, keyCode)
    if not keyData[id] then return end
    keyData[id].key = keyCode
    settings[id] = keyCode.Name
    SaveSettings(settings)
    showNotification("⌨️ Keybind", keyData[id].label .. " → " .. keyCode.Name)
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = true
    for id, data in pairs(keyData) do
        if input.KeyCode == data.key then
            local action = keyActions[id]
            if action then action() end
            return
        end
    end
    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = true end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = false
    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = false end
end)


local function disableAllModes(except)
    if except ~= "climb" and climbing then
        climbing = false
        if humanoid then humanoid.AutoRotate = true humanoid.PlatformStand = false end
        gravityDir = Vector3.new(0,-1,0); upDir = Vector3.new(0,1,0)
        fallSpeed = 0; isGrounded = false; isOnCeiling = false; ceilingTime = 0
    end
    if except ~= "fly" and flying then
        flying = false
        if humanoid then humanoid.AutoRotate = true humanoid.PlatformStand = false end
        flyVelocity = Vector3.zero
        if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
    end
    if except ~= "noclip" and noClipActive then
        noClipActive = false
        for _, p in ipairs(character and character:GetDescendants() or {}) do
            if p:IsA("BasePart") then p.CanCollide = true end
        end
    end
    if except ~= "turbo" and turboActive then
        turboActive = false
        if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
    end
end

local function toggleClimb()
    if flying or noClipActive or turboActive then disableAllModes("climb") end
    if not hrp or not humanoid then updateCharacterReferences() if not hrp then return end end
    climbing = not climbing

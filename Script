-- ==========================================
local function startFreecam()
    if freecamActive then return end
    if not Camera then return end
    freecamActive = true
    settings.FREECAM_ENABLED = true; SaveSettings(settings)
    freecamSavedCamType = Camera.CameraType
    freecamSavedCamSubject = Camera.CameraSubject
    Camera.CameraType = Enum.CameraType.Scriptable
    freecamPos = Camera.CFrame.Position
    freecamRot = Camera.CFrame
    if settings.FREECAM_HIDE_CHAR and character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.LocalTransparencyModifier = 1; part.Transparency = 1
            elseif part:IsA("Decal") or part:IsA("Texture") then
                part.Transparency = 1
            end
        end
    end
    showNotification("🎥 Freecam","Включён")
    freecamConnection = RunService.RenderStepped:Connect(function(dt)
        if not freecamActive then return end
        local camForward = freecamRot.LookVector
        local camRight = freecamRot.RightVector
        local camUp = Vector3.new(0,1,0)
        local fwd = (pressed[Enum.KeyCode.W] and 1 or 0) - (pressed[Enum.KeyCode.S] and 1 or 0)
        local str = (pressed[Enum.KeyCode.D] and 1 or 0) - (pressed[Enum.KeyCode.A] and 1 or 0)
        local up  = (pressed[Enum.KeyCode.Space] and 1 or 0) - (pressed[Enum.KeyCode.LeftControl] and 1 or 0)
        local move = camForward * fwd + camRight * str + camUp * up
        if move.Magnitude > 0 then move = move.Unit end
        local speed = settings.FREECAM_SPEED
        if pressed[Enum.KeyCode.LeftShift] then speed = speed * settings.FREECAM_SPRINT_MULT end
        freecamPos = freecamPos + move * speed * dt
        freecamRot = CFrame.new(freecamPos) * (freecamRot - freecamRot.Position)
        Camera.CFrame = freecamRot
    end)
end

local function stopFreecam()
    if not freecamActive then return end
    freecamActive = false
    settings.FREECAM_ENABLED = false; SaveSettings(settings)
    if freecamConnection then freecamConnection:Disconnect(); freecamConnection = nil end
    if settings.FREECAM_HIDE_CHAR and character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.LocalTransparencyModifier = 0; part.Transparency = 0
            elseif part:IsA("Decal") or part:IsA("Texture") then
                part.Transparency = 0
            end
        end
    end
    if freecamSavedCamType then Camera.CameraType = freecamSavedCamType else Camera.CameraType = Enum.CameraType.Custom end
    if freecamSavedCamSubject then Camera.CameraSubject = freecamSavedCamSubject end
    showNotification("🎥 Freecam","Выключен")
end

local function toggleFreecam()
    if freecamActive then stopFreecam() else startFreecam() end
end


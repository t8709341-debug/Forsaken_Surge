local waypoints = {}
local MAX_WAYPOINTS = 8
local WaypointFolder = MyDataFolder .. "/Waypoints"
if not isfolder(WaypointFolder) then makefolder(WaypointFolder) end

local function saveWaypoints()
    local data = {}
    for i, wp in ipairs(waypoints) do
        data[i] = { Name = wp.Name, Position = {wp.Position.X, wp.Position.Y, wp.Position.Z} }
    end
    pcall(function()
        writefile(WaypointFolder .. "/wp_" .. tostring(game.PlaceId) .. ".json", HttpService:JSONEncode(data))
    end)
end

local function loadWaypoints()
    local path = WaypointFolder .. "/wp_" .. tostring(game.PlaceId) .. ".json"
    if isfile(path) then
        local ok, data = pcall(HttpService.JSONDecode, HttpService, readfile(path))
        if ok and type(data) == "table" then
            waypoints = {}
            for _, wp in ipairs(data) do
                if wp.Position and #wp.Position == 3 then
                    table.insert(waypoints, {
                        Name = wp.Name or "WP",
                        Position = Vector3.new(wp.Position[1], wp.Position[2], wp.Position[3])
                    })
                end
            end
        end
    end
end

loadWaypoints()

local waypointBeacons = {}

local function createBeacon(position, name, color)
    local part = Instance.new("Part")
    part.Name = "ForsakenSurge_WP"
    part.Shape = Enum.PartType.Ball
    part.Size = Vector3.new(2, 2, 2)
    part.Position = position
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.Material = Enum.Material.Neon
    part.Color = color
    part.Transparency = 0.3
    part.Parent = Workspace

    local bg = Instance.new("BillboardGui")
    bg.Size = UDim2.new(0, 150, 0, 40)
    bg.StudsOffset = Vector3.new(0, 2.5, 0)
    bg.AlwaysOnTop = true
    bg.Parent = part

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.fromScale(1, 1)
    lbl.BackgroundTransparency = 1
    lbl.Text = "📍 " .. name
    lbl.TextColor3 = color
    lbl.TextStrokeTransparency = 0
    lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamBold
    lbl.Parent = bg

    task.spawn(function()
        local t0 = tick()
        while part.Parent do
            local t = tick() - t0
            part.CFrame = CFrame.new(position + Vector3.new(0, math.sin(t * 2) * 0.5, 0))
            part.Orientation = Vector3.new(0, t * 90, 0)
            task.wait()
        end
    end)

    return part
end

local function refreshBeacons()
    for _, b in ipairs(waypointBeacons) do pcall(function() b:Destroy() end) end
    waypointBeacons = {}
    for i, wp in ipairs(waypoints) do
        local hue = (i - 1) / math.max(MAX_WAYPOINTS, 1)
        table.insert(waypointBeacons, createBeacon(wp.Position, wp.Name, Color3.fromHSV(hue, 0.8, 1)))
    end
end

local function addWaypoint(name)
    if not hrp then updateCharacterReferences() if not hrp then return end end
    if #waypoints >= MAX_WAYPOINTS then
        showNotification("📍 Waypoint", "Максимум " .. MAX_WAYPOINTS .. " точек!")
        return
    end
    table.insert(waypoints, {
        Name = name or ("WP" .. (#waypoints + 1)),
        Position = hrp.Position
    })
    saveWaypoints()
    refreshBeacons()
    showNotification("📍 Waypoint", "Сохранён: " .. (name or ("WP" .. #waypoints)))
end

local function removeWaypoint(index)
    if waypoints[index] then
        table.remove(waypoints, index)
        saveWaypoints()
        refreshBeacons()
        showNotification("📍 Waypoint", "Удалён #" .. index)
    end
end

-- Обычный ТП
local function teleportToWaypoint(index)
    if not waypoints[index] then return end
    if not hrp then updateCharacterReferences() if not hrp then return end end
    local wp = waypoints[index]
    hrp.CFrame = CFrame.new(wp.Position + Vector3.new(0, 3, 0))
    hrp.AssemblyLinearVelocity = Vector3.zero
    showNotification("📍 Waypoint", "ТП → " .. wp.Name)
end

-- 🔁 SWAP: меняемся местами с точкой
local function swapWithWaypoint(index)
    if not waypoints[index] then
        showNotification("🔁 Swap", "Точка #" .. index .. " не найдена")
        return
    end
    if not hrp then updateCharacterReferences() if not hrp then return end end

    local wp = waypoints[index]
    local myOldPos = hrp.Position

    -- Меняем местами
    hrp.CFrame = CFrame.new(wp.Position + Vector3.new(0, 3, 0))
    hrp.AssemblyLinearVelocity = Vector3.zero

    -- Точка перемещается туда где я был
    wp.Position = myOldPos
    saveWaypoints()
    refreshBeacons()

    showNotification("🔁 Swap", string.format("Обмен с %s выполнен", wp.Name))
end

-- 🔁 SWAP к игроку (тоже обмен)
local function swapWithPlayer(targetName)
    local target
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Name:lower():find(targetName:lower(), 1, true) then
            target = plr
            break
        end
    end
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        showNotification("🔁 Swap", "Игрок не найден")
        return
    end
    if not hrp then return end

    local targetRoot = target.Character.HumanoidRootPart
    local myOldPos = hrp.Position
    local theirOldPos = targetRoot.Position

    hrp.CFrame = CFrame.new(theirOldPos + Vector3.new(0, 3, 0))
    hrp.AssemblyLinearVelocity = Vector3.zero
    targetRoot.CFrame = CFrame.new(myOldPos + Vector3.new(0, 3, 0))
    targetRoot.AssemblyLinearVelocity = Vector3.zero

    showNotification("🔁 Swap", "Обмен с " .. target.Name)
end

local function teleportToPlayer(targetName)
    local target
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Name:lower():find(targetName:lower(), 1, true) then
            target = plr
            break
        end
    end
    if not target then showNotification("📍 TP", "Игрок не найден") return end
    if not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        showNotification("📍 TP", "У игрока нет персонажа") return
    end
    if not hrp then return end
    hrp.CFrame = CFrame.new(target.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0))
    hrp.AssemblyLinearVelocity = Vector3.zero
    showNotification("📍 TP", "ТП → " .. target.Name)
end


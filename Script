-- ==========================================
local killerAlertLastTrigger = 0

local function getKillersInRange()
    local killers = {}
    if not hrp then return killers end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        local char = plr.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
        if not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then continue end
        if not isPlayerKiller(plr, char) then continue end
        local dist = (hrp.Position - char.HumanoidRootPart.Position).Magnitude
        if dist <= settings.KILLER_ALERT_RANGE then
            table.insert(killers, {player = plr, char = char, dist = dist})
        end
    end
    table.sort(killers, function(a, b) return a.dist < b.dist end)
    return killers
end

local function triggerKillerAlert(killers)
    if settings.KILLER_ALERT_SOUND then
        pcall(function()
            local s = Instance.new("Sound")
            s.SoundId = "rbxassetid://9125402735"
            s.Volume = 3
            s.Parent = player:WaitForChild("PlayerGui")
            s:Play()
            Debris:AddItem(s, 2)
        end)
    end
    if settings.KILLER_ALERT_FLASH then
        pcall(function()
            local flash = Instance.new("Frame")
            flash.Size = UDim2.fromScale(1,1)
            flash.BackgroundColor3 = Color3.fromRGB(255,0,0)
            flash.BackgroundTransparency = 0.6
            flash.BorderSizePixel = 0
            flash.ZIndex = 999
            flash.Parent = player:WaitForChild("PlayerGui")
            TweenService:Create(flash, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
            Debris:AddItem(flash, 0.6)
        end)
    end
    if settings.KILLER_ALERT_AUTOTP then
        local wpIdx = settings.KILLER_ALERT_WP_INDEX
        if waypoints[wpIdx] and hrp then
            hrp.CFrame = CFrame.new(waypoints[wpIdx].Position + Vector3.new(0, 3, 0))
            hrp.AssemblyLinearVelocity = Vector3.zero
            showNotification("🚨 Killer Alert", "AUTO-TP → WP#" .. wpIdx)
        else
            showNotification("🚨 Killer Alert", "WP#" .. wpIdx .. " не найден!")
        end
    else
        showNotification("🚨 Killer Alert", killers[1].player.Name .. " в " .. math.floor(killers[1].dist) .. "m")
    end
end

task.spawn(function()
    while true do
        task.wait(0.15)
        if not settings.KILLER_ALERT_ENABLED then continue end
        if not hrp then continue end
        local now = tick()
        if now - killerAlertLastTrigger < settings.KILLER_ALERT_COOLDOWN then continue end
        local killers = getKillersInRange()
        if #killers == 0 then continue end
        killerAlertLastTrigger = now
        triggerKillerAlert(killers)
    end
end)


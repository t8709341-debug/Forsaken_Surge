local espHighlights = {}
local espBillboards = {}
local espBoxes = {}
local espTracers = {}
local espTracked = setmetatable({}, {__mode = "k"})

local function clearAllESP()
    for _, hl in ipairs(espHighlights) do pcall(function() hl:Destroy() end) end
    espHighlights = {}
    for _, bg in ipairs(espBillboards) do pcall(function() bg:Destroy() end) end
    espBillboards = {}
    for _, box in ipairs(espBoxes) do pcall(function() box:Destroy() end) end
    espBoxes = {}
    for _, tr in ipairs(espTracers) do pcall(function() tr:Destroy() end) end
    espTracers = {}
    espTracked = setmetatable({}, {__mode = "k"})
end

local function UpdateHighlight(inst, root, cfg)
    cfg = type(cfg) == "table" and cfg or {MaxDistance = settings.ESP_MAX_DISTANCE, MinDistance = settings.ESP_MIN_DISTANCE, Color = Color3.new(1,1,1)}
    local entry = espTracked[inst]
    local hl = entry and entry.highlight
    if not hl or not hl.Parent then
        hl = Instance.new("Highlight")
        hl.Name = HttpService:GenerateGUID(false):sub(1,7)
        hl.Archivable = false
        hl.Parent = inst
        if inst:IsA("Tool") then
            hl.Adornee = inst:FindFirstChildWhichIsA("BasePart") or inst
        else
            hl.Adornee = inst
        end
        hl.DepthMode = Enum.HighlightDepthMode[settings.ESP_HIGHLIGHT_DEPTH_MODE] or Enum.HighlightDepthMode.AlwaysOnTop
        table.insert(espHighlights, hl)
        if not espTracked[inst] then espTracked[inst] = {} end
        espTracked[inst].highlight = hl
    end
    local H, S, V = cfg.Color:ToHSV()
    hl.FillColor = Color3.fromHSV(H, S, V * 0.8)
    hl.OutlineColor = Color3.fromHSV(H, S, V * 1.1)
    if settings.ESP_RENDER_DISTANCE_FADE and root and root.Parent then
        local dist = (Camera.CFrame.Position - root.Position).Magnitude
        local alpha = math.clamp(1 - math.clamp((dist - cfg.MinDistance) / math.max(cfg.MaxDistance - cfg.MinDistance, 0.001), 0, 1), settings.ESP_FADE_MIN_ALPHA, 1)
        hl.FillTransparency = math.clamp(alpha + (1 - settings.ESP_FILL_TRANSPARENCY), 0, 1)
        hl.OutlineTransparency = math.clamp(alpha + (1 - settings.ESP_OUTLINE_TRANSPARENCY), 0, 1)
    else
        hl.FillTransparency = 1 - settings.ESP_FILL_TRANSPARENCY
        hl.OutlineTransparency = 1 - settings.ESP_OUTLINE_TRANSPARENCY
    end
end

local function UpdateText(inst, root, cfg)
    cfg = type(cfg) == "table" and cfg or {MinDistance = settings.ESP_TEXT_MIN_DISTANCE, Color = Color3.new(1,1,1), Text = "Unknown"}
    local entry = espTracked[inst]
    local bg = entry and entry.billboard
    if not bg or not bg.Parent then
        bg = Instance.new("BillboardGui")
        bg.Name = HttpService:GenerateGUID(false):sub(1,7)
        bg.Archivable = false
        bg.Size = UDim2.new(1.5, 60, 0.75, 25)
        bg.StudsOffset = Vector3.new(0, 4, 0)
        bg.AlwaysOnTop = true
        bg.ResetOnSpawn = false
        bg.Adornee = root
        local lbl = Instance.new("TextLabel")
        lbl.AnchorPoint = Vector2.new(0.5, 0.5)
        lbl.Position = UDim2.fromScale(0.5, 0.5)
        lbl.Size = UDim2.fromScale(1, 1)
        lbl.BackgroundTransparency = 1
        lbl.TextScaled = true
        lbl.Font = Enum.Font.GothamBold
        lbl.TextStrokeTransparency = 0
        lbl.TextStrokeColor3 = Color3.new(0,0,0)
        lbl.Parent = bg
        bg.Parent = root
        table.insert(espBillboards, bg)
        if not espTracked[inst] then espTracked[inst] = {} end
        espTracked[inst].billboard = bg
    end
    local lbl = bg:FindFirstChildOfClass("TextLabel")
    if lbl then
        local txt = cfg.Text or "Unknown"
        if settings.ESP_SHOW_DISTANCE_TEXT and root and root.Parent then
            local dist = (Camera.CFrame.Position - root.Position).Magnitude
            txt = txt .. " [" .. math.floor(dist) .. "m]"
        end
        lbl.Text = txt
        lbl.TextSize = settings.ESP_TEXT_SIZE
        local H, S, V = cfg.Color:ToHSV()
        lbl.TextColor3 = Color3.fromHSV(H, S, V * 1.1)
        local dist = root and root.Parent and (Camera.CFrame.Position - root.Position).Magnitude or 0
        if dist > cfg.MinDistance and dist < settings.ESP_TEXT_MAX_DISTANCE then
            lbl.TextTransparency = 0
            lbl.TextStrokeTransparency = 0
        else
            lbl.TextTransparency = 1
            lbl.TextStrokeTransparency = 1
        end
    end
end

local function UpdateBox(inst, root, cfg)
    cfg = type(cfg) == "table" and cfg or { Color = Color3.new(1,1,1) }
    local entry = espTracked[inst]
    local box = entry and entry.box
    if not box or not box.Parent then
        box = Instance.new("BoxHandleAdornment")
        box.Name = HttpService:GenerateGUID(false):sub(1,7)
        box.Archivable = false
        box.Adornee = root
        box.AlwaysOnTop = true
        box.ZIndex = 5
        box.Size = root:IsA("BasePart") and root.Size or Vector3.new(2,2,2)
        box.Transparency = settings.ESP_BOX_TRANSPARENCY
        box.Color3 = cfg.Color
        box.Parent = root
        table.insert(espBoxes, box)
        if not espTracked[inst] then espTracked[inst] = {} end
        espTracked[inst].box = box
    end
    if box and root then
        box.Size = root:IsA("BasePart") and root.Size or Vector3.new(2,2,2)
        box.Color3 = cfg.Color
        box.Transparency = settings.ESP_BOX_TRANSPARENCY
    end
end

local function UpdateTracer(inst, root, cfg)
    cfg = type(cfg) == "table" and cfg or { Color = Color3.new(1,1,1) }
    local entry = espTracked[inst]
    local tr = entry and entry.tracer
    if not tr or not tr.Parent then
        tr = Instance.new("LineHandleAdornment")
        tr.Name = HttpService:GenerateGUID(false):sub(1,7)
        tr.Archivable = false
        tr.Adornee = root
        tr.AlwaysOnTop = true
        tr.ZIndex = 5
        tr.Thickness = 2
        tr.Transparency = settings.ESP_TRACER_TRANSPARENCY
        tr.Color3 = cfg.Color
        tr.Length = 0
        tr.Parent = root
        table.insert(espTracers, tr)
        if not espTracked[inst] then espTracked[inst] = {} end
        espTracked[inst].tracer = tr
    end
    if tr and root then
        tr.Color3 = cfg.Color
        tr.Transparency = settings.ESP_TRACER_TRANSPARENCY
    end
end

local function RemoveESP(inst)
    local entry = espTracked[inst]
    if entry then
        if entry.highlight then pcall(function() entry.highlight:Destroy() end) end
        if entry.billboard then pcall(function() entry.billboard:Destroy() end) end
        if entry.box then pcall(function() entry.box:Destroy() end) end
        if entry.tracer then pcall(function() entry.tracer:Destroy() end) end
        espTracked[inst] = nil
    end
end

-- ESP CACHE
local espCache = {killers = {}, survivors = {}, generators = {}, items = {}}

local function classifyInstance(inst)
    if not inst or not inst.Parent then return nil end
    if inst:IsA("Tool") then return "items" end
    if inst:IsA("Model") then
        local n = inst.Name:lower()
        if n:find("generator") or n:find("gen") or inst:GetAttribute("Generator") then return "generators" end
        if inst:FindFirstChildOfClass("Humanoid") then
            local plr = Players:GetPlayerFromCharacter(inst)
            if plr and plr ~= player then
                local team = plr.Team
                if settings.ESP_TEAM_CHECK and team then
                    local tn = team.Name:lower()
                    if tn:find("killer") or tn:find("monster") or tn:find("enemy") then return "killers" end
                end
                return "survivors"
            end
        end
    end
    return nil
end

local function refreshCacheFor(inst)
    local cat = classifyInstance(inst)
    if not cat then return end
    local bucket = espCache[cat]
    for i = 1, #bucket do if bucket[i] == inst then return end end
    table.insert(bucket, inst)
end

local function removeFromCache(inst)
    for _, bucket in pairs(espCache) do
        for i = #bucket, 1, -1 do
            if bucket[i] == inst then table.remove(bucket, i) end
        end
    end
end

for _, inst in ipairs(Workspace:GetDescendants()) do refreshCacheFor(inst) end
Workspace.DescendantAdded:Connect(function(inst) task.defer(refreshCacheFor, inst) end)
Workspace.DescendantRemoving:Connect(function(inst) removeFromCache(inst) RemoveESP(inst) end)
Players.PlayerAdded:Connect(function(plr) plr.CharacterAdded:Connect(function(char) task.wait(0.3) refreshCacheFor(char) end) end)
Players.PlayerRemoving:Connect(function(plr) if plr.Character then removeFromCache(plr.Character) RemoveESP(plr.Character) end end)

task.spawn(function()
    while true do
        task.wait(settings.ESP_UPDATE_INTERVAL)
        pcall(function()
            if not settings.ESP_ENABLED then clearAllESP() return end
            local alive = {}

            if settings.KILLERS_ESP then
                for i = #espCache.killers, 1, -1 do
                    local char = espCache.killers[i]
                    if not char.Parent or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
                        table.remove(espCache.killers, i) RemoveESP(char)
                    else
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then
                            local plr = Players:GetPlayerFromCharacter(char)
                            local c = getColorFromSettings("Killers")
                            UpdateHighlight(char, root, {MaxDistance = settings.ESP_MAX_DISTANCE, MinDistance = settings.ESP_MIN_DISTANCE, Color = c})
                            if settings.SHOW_TEXT then UpdateText(char, root, {MinDistance = settings.ESP_TEXT_MIN_DISTANCE, Text = plr and plr.Name or char.Name, Color = c}) end
                            if settings.ESP_BOX_ENABLED then UpdateBox(char, root, {Color = getColorFromSettings("Box")}) end
                            if settings.ESP_TRACER_ENABLED then UpdateTracer(char, root, {Color = getColorFromSettings("Tracer")}) end
                            alive[char] = true
                        end
                    end
                end
            end

            if settings.SURVIVORS_ESP then
                for i = #espCache.survivors, 1, -1 do
                    local char = espCache.survivors[i]
                    if not char.Parent or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
                        table.remove(espCache.survivors, i) RemoveESP(char)
                    else
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then
                            local plr = Players:GetPlayerFromCharacter(char)
                            local c = getColorFromSettings("Survivors")
                            UpdateHighlight(char, root, {MaxDistance = settings.ESP_MAX_DISTANCE, MinDistance = settings.ESP_MIN_DISTANCE, Color = c})
                            if settings.SHOW_TEXT then UpdateText(char, root, {MinDistance = settings.ESP_TEXT_MIN_DISTANCE, Text = plr and plr.Name or char.Name, Color = c}) end
                            if settings.ESP_BOX_ENABLED then UpdateBox(char, root, {Color = getColorFromSettings("Box")}) end
                            if settings.ESP_TRACER_ENABLED then UpdateTracer(char, root, {Color = getColorFromSettings("Tracer")}) end
                            alive[char] = true
                        end
                    end
                end
            end

            if settings.GENERATORS_ESP then
                for i = #espCache.generators, 1, -1 do
                    local obj = espCache.generators[i]
                    if not obj.Parent then
                        table.remove(espCache.generators, i) RemoveESP(obj)
                    else
                        local prog = obj:FindFirstChild("Progress")
                        if prog and prog.Value >= 100 then RemoveESP(obj)
                        else
                            local root = obj:FindFirstChild("Main") or obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj
                            local c = getColorFromSettings("Generators")
                            UpdateHighlight(obj, root, {MaxDistance = settings.ESP_MAX_DISTANCE, MinDistance = settings.ESP_MIN_DISTANCE, Color = c})
                            if settings.SHOW_TEXT then UpdateText(obj, root, {MinDistance = settings.ESP_TEXT_MIN_DISTANCE, Text = obj.Name, Color = c}) end
                            if settings.ESP_BOX_ENABLED then UpdateBox(obj, root, {Color = getColorFromSettings("Box")}) end
                            alive[obj] = true
                        end
                    end
                end
            end

            if settings.ITEMS_ESP then
                for i = #espCache.items, 1, -1 do
                    local obj = espCache.items[i]
                    if not obj.Parent then
                        table.remove(espCache.items, i) RemoveESP(obj)
                    else
                        local root = obj:FindFirstChildWhichIsA("BasePart") or obj
                        local c = getColorFromSettings("Items")
                        UpdateHighlight(obj, root, {MaxDistance = settings.ESP_MAX_DISTANCE, MinDistance = settings.ESP_MIN_DISTANCE, Color = c})
                        if settings.SHOW_TEXT then UpdateText(obj, root, {MinDistance = settings.ESP_TEXT_MIN_DISTANCE, Text = obj.Name, Color = c}) end
                        if settings.ESP_BOX_ENABLED then UpdateBox(obj, root, {Color = getColorFromSettings("Box")}) end
                        alive[obj] = true
                    end
                end
            end

            for inst, _ in pairs(espTracked) do
                if not alive[inst] or not inst.Parent then RemoveESP(inst) end
            end
        end)
    end
end)


    if not freecamActive then return end
    local speed = settings.FREECAM_SPEED * dt
    local cam = freecamCFrame
    local moveVec = Vector3.zero
    if pressed[Enum.KeyCode.W] then moveVec = moveVec + cam.LookVector end
    if pressed[Enum.KeyCode.S] then moveVec = moveVec - cam.LookVector end
    if pressed[Enum.KeyCode.A] then moveVec = moveVec - cam.RightVector end
    if pressed[Enum.KeyCode.D] then moveVec = moveVec + cam.RightVector end
    if pressed[Enum.KeyCode.Space] then moveVec = moveVec + Vector3.new(0, 1, 0) end
    if pressed[Enum.KeyCode.LeftControl] then moveVec = moveVec - Vector3.new(0, 1, 0) end
    if moveVec.Magnitude > 0 then
        cam = cam + moveVec.Unit * speed
    end
    -- Мышь вращает камеру
    local mouseDelta = UserInputService:GetMouseDelta()
    local rotY = CFrame.Angles(0, -math.rad(mouseDelta.X * 0.3), 0)

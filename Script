local function UpdateHighlight(inst, root, S)
    S = type(S) == "table" and S or { MaxDistance=settings.ESP_MAX_DISTANCE, MinDistance=settings.ESP_MIN_DISTANCE, Color=Color3.new(1,1,1) }
    local e = espTracked[inst]; local h = e and e.highlight
    if not h or not h.Parent then
        h = Instance.new("Highlight")
        h.Name = HttpService:GenerateGUID(false):sub(1,7)
        h.Archivable = false
        h:SetAttribute("Dynamic", true)
        h.Parent = inst; h.Adornee = inst
        h.DepthMode = Enum.HighlightDepthMode[settings.ESP_HIGHLIGHT_DEPTH_MODE] or Enum.HighlightDepthMode.AlwaysOnTop
        table.insert(espHighlights, h)
        if not espTracked[inst] then espTracked[inst] = {} end
        espTracked[inst].highlight = h
    end
    local H,S_,V = S.Color:ToHSV()
    h.FillColor    = Color3.fromHSV(H,S_,V*0.8)
    h.OutlineColor = Color3.fromHSV(H,S_,V*1.1)
    if settings.ESP_RENDER_DISTANCE_FADE and root and root.Parent then
        local dist = (Camera.CFrame.Position - root.Position).Magnitude
        local minD, maxD = S.MinDistance or settings.ESP_MIN_DISTANCE, S.MaxDistance or settings.ESP_MAX_DISTANCE
        local a = math.clamp(1 - math.clamp((dist-minD)/math.max(maxD-minD,0.001),0,1), settings.ESP_FADE_MIN_ALPHA, 1)
        h.FillTransparency    = math.clamp(a + (1 - settings.ESP_FILL_TRANSPARENCY), 0, 1)
        h.OutlineTransparency = math.clamp(a + (1 - settings.ESP_OUTLINE_TRANSPARENCY), 0, 1)
    else
        h.FillTransparency    = 1 - settings.ESP_FILL_TRANSPARENCY
        h.OutlineTransparency = 1 - settings.ESP_OUTLINE_TRANSPARENCY
    end
end


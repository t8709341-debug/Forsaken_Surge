    if input.KeyCode == Enum.KeyCode.L then removeWaypoint(#waypoints) end
    if input.KeyCode == Enum.KeyCode.T then teleportToWaypoint(1) end
    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = true end
    if input.KeyCode == Enum.KeyCode.O then toggleFreecam() end

    -- Click TP hotkey
    if input.KeyCode == Enum.KeyCode.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton1 then
        if clickTPActive and not freecamActive then
            performClickTP()
        end
    end

    -- Macro hotkeys
    if settings.MACRO_ENABLED then
        if isHotkeyMatch(input, settings.MACRO_RECORD_HOTKEY) then
            if macroRecording then
                stopMacroRecord()
            else
                startMacroRecord()
            end
        end
        if isHotkeyMatch(input, settings.MACRO_PLAY_HOTKEY) then
            local firstMacroName = nil
            for name, _ in pairs(macros) do
                firstMacroName = name
                break
            end
            if firstMacroName then
                playMacro(firstMacroName)
            else
                showNotification("🎬 Macro", "Нет сохранённых макросов")
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    pressed[input.KeyCode] = false
    if input.KeyCode == Enum.KeyCode.LeftShift then isSprinting = false end
end)


    playingMacro = true
    showNotification("▶️ Macro", "Воспроизведение: " .. name)
    task.spawn(function()
        for _, ev in ipairs(macros[name].events) do
            task.wait(ev.delay or 0.1)
            if ev.type == "tp" and hrp then
                hrp.CFrame = CFrame.new(Vector3.new(ev.pos[1], ev.pos[2], ev.pos[3]))
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
        end
        playingMacro = false
        showNotification("▶️ Macro", "Готово: " .. name)
    end)
end


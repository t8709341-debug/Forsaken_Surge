local function getColorFromSettings(colorType)
    if colorType == "Killers" then
        if settings.KILLERS_COLOR_CUSTOM then
            return Color3.fromRGB(settings.KILLERS_COLOR_R, settings.KILLERS_COLOR_G, settings.KILLERS_COLOR_B)
        end
        return ColorPresets[settings.KILLERS_COLOR] or ColorPresets.Red
    elseif colorType == "Survivors" then
        if settings.SURVIVORS_COLOR_CUSTOM then
            return Color3.fromRGB(settings.SURVIVORS_COLOR_R, settings.SURVIVORS_COLOR_G, settings.SURVIVORS_COLOR_B)
        end
        return ColorPresets[settings.SURVIVORS_COLOR] or ColorPresets.Green
    elseif colorType == "Generators" then
        if settings.GENERATORS_COLOR_CUSTOM then
            return Color3.fromRGB(settings.GENERATORS_COLOR_R, settings.GENERATORS_COLOR_G, settings.GENERATORS_COLOR_B)
        end
        return ColorPresets[settings.GENERATORS_COLOR] or ColorPresets.Cyan
    elseif colorType == "Items" then
        if settings.ITEMS_COLOR_CUSTOM then
            return Color3.fromRGB(settings.ITEMS_COLOR_R, settings.ITEMS_COLOR_G, settings.ITEMS_COLOR_B)
        end
        return ColorPresets[settings.ITEMS_COLOR] or ColorPresets.Gold
    elseif colorType == "Box" then
        return ColorPresets[settings.ESP_BOX_COLOR] or ColorPresets.White
    elseif colorType == "Tracer" then
        return ColorPresets[settings.ESP_TRACER_COLOR] or ColorPresets.White
    end
    return Color3.new(1,1,1)
end

